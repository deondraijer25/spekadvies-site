---
const features = [
  {
    id: 1,
    title: "Eerste huis<br />kopen",
    badge: "Starters",
    description: "Direct zekerheid over je maximale hypotheek, starterslening en de laagste maandlasten.",
    linkText: "Bekijk startershypotheek",
    link: "/diensten/startershypotheek",
    icon: "fa-solid fa-house-chimney",
    isGradient: false
  },
  {
    id: 2,
    title: "Doorstromen &<br />oversluiten",
    badge: "Bestaande woning",
    description: "Verhuis soepel naar je volgende woning, benut je overwaarde of verlaag je maandlasten.",
    linkText: "Bekijk mogelijkheden",
    link: "/diensten/doorstromers-overbrugging",
    icon: "fa-solid fa-arrow-trend-up",
    isGradient: true
  },
  {
    id: 3,
    title: "Hypotheek voor<br />ondernemers",
    badge: "ZZP & Ondernemers",
    description: "Snel duidelijkheid over je zakelijke leencapaciteit, al mogelijk vanaf 1 jaar cijfers.",
    linkText: "Bekijk zakelijke opties",
    link: "/diensten/zzp-ondernemers-hypotheek",
    icon: "fa-solid fa-briefcase",
    isGradient: false
  }
];
import SectionDivider from './SectionDivider.astro';
---

<section id="features-section" class="w-full bg-white relative z-30 pb-20 sm:pb-24 lg:pb-28 overflow-hidden">
  
  <!-- Subtle baseline faint dot grid continuing seamlessly from Hero -->
  <div 
    id="features-dot-grid"
    class="pointer-events-none absolute inset-0 z-0 opacity-25" 
    aria-hidden="true"
    style="background-image: radial-gradient(circle, rgba(148, 163, 184, 0.45) 1px, transparent 1px); background-size: 24px 24px; background-position: 0 var(--dot-offset-y, 0px);"
  ></div>

  <!-- Interactive Mouse-Following Subtle Orange Glow Gradient & Glowing Stippels -->
  <div 
    id="features-mouse-glow" 
    class="pointer-events-none absolute inset-0 z-0 transition-opacity duration-500 opacity-0 overflow-hidden"
    aria-hidden="true"
  >
    <!-- Soft warm ambient radial gradient following mouse -->
    <div 
      class="absolute inset-0"
      style="background: radial-gradient(550px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(251, 146, 60, 0.14), rgba(255, 206, 118, 0.07) 38%, transparent 75%);"
    ></div>

    <!-- Very light stippels (dot matrix) illuminated by the mouse with warm gradient -->
    <div 
      class="absolute inset-0"
      style="
        background-image: radial-gradient(circle, rgba(234, 88, 12, 0.65) 1.25px, transparent 1.25px);
        background-size: 24px 24px;
        background-position: 0 var(--dot-offset-y, 0px);
        -webkit-mask-image: radial-gradient(420px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), black 10%, rgba(0,0,0,0.5) 45%, transparent 75%);
        mask-image: radial-gradient(420px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), black 10%, rgba(0,0,0,0.5) 45%, transparent 75%);
      "
    ></div>
  </div>

  <!-- Centered Content Container -->
  <div class="max-w-7xl mx-auto px-4 sm:px-8 lg:px-12 pt-10 sm:pt-14 lg:pt-16 relative z-10">
    
    <!-- Clear Section Header -->
    <div class="mb-10 sm:mb-12">
      <div class="space-y-2 max-w-2xl">
        <h2 class="ty-h2 text-brand-dark">
          Welke situatie past bij jou?
        </h2>
        <p class="ty-lead text-slate-600">
          Kies jouw situatie en bekijk direct hoe wij je helpen aan de scherpste rente en voorwaarden.
        </p>
      </div>
    </div>

    <!-- 3 Stepped Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      {features.map((feat) => (
        <div class="feature-card relative w-full transition-all duration-300 hover:-translate-y-2 group filter drop-shadow-[0_2px_6px_rgba(21,59,104,0.04)] drop-shadow-[0_14px_34px_rgba(21,59,104,0.09)]">
          
          <!-- Outer Card Container -->
          <div class="relative w-full h-[350px]">
            
            <!-- Masked Card Background & Content -->
            <div class={`feature-card__content absolute inset-0 w-full h-full ${feat.isGradient ? 'gradient-card' : ''}`}>
              
              <!-- Expanding Circle Hover Background -->
              <div class="feature-card__hover-bg"></div>

              <!-- Content wrapper with strict equal-height alignment -->
              <div class="relative z-10 flex flex-col h-full p-8 sm:p-9 pt-10 pb-8">
                
                <!-- Top Block: Badge + 2-Line Title -->
                <div class="pr-16">
                  <span class="feature-card__badge ty-eyebrow mb-2">
                    {feat.badge}
                  </span>

                  <h3 class="feature-card__title ty-h3" set:html={feat.title}></h3>
                </div>
                
                <!-- Upper Thin Divider Line -->
                <div class="feature-card__divider"></div>

                <!-- Middle Block: Description (flex-1 keeps lower divider on exact same baseline) -->
                <div class="flex-1 flex items-center">
                  <p class="feature-card__desc ty-body">
                    {feat.description}
                  </p>
                </div>
                
                <!-- Lower Thin Divider Line -->
                <div class="feature-card__divider"></div>

                <!-- Bottom Block: CTA Link -->
                <a 
                  href={feat.link}
                  class="feature-card__link link-action cursor-pointer w-full text-left bg-transparent border-none focus:outline-none flex items-center justify-between p-0 transition-colors"
                >
                  <span>{feat.linkText}</span>
                  <span class="inline-block ml-2 group-hover:translate-x-1.5 transition-transform duration-200">→</span>
                </a>

              </div>
            </div>

            <!-- Floating Logo Shape Badge -->
            <div class="feature-card__icon-badge">
              <!-- Backing circle to fill the circular card mask cutout -->
              <div class="badge-cutout-fill absolute inset-0 rounded-full"></div>
              
              <!-- Outer border logo shape (Matches white section background) -->
              <svg class="absolute w-[72px] h-[74.7px] text-white" viewBox="0 0 80.08 83.08" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                <path d="M40.04,83.08c-10.9,0-19.76-8.87-19.76-19.76,0-.17,0-.35.01-.53-.18,0-.36.01-.53.01C8.86,62.8,0,53.93,0,43.04s8.86-19.76,19.76-19.76c.17,0,.35,0,.53.01,0-.18-.01-.36-.01-.53,0-8.08,10.41-17.07,16.61-21.7,1.88-1.41,4.42-1.41,6.3,0,6.2,4.64,16.61,13.62,16.61,21.7,0,.17,0,.35-.01.53.18,0,.36-.01.53-.01,10.9,0,19.76,8.86,19.76,19.76s-8.86,19.76-19.76,19.76c-.17,0-.35,0-.53-.01,0,.18.01.36.01.53,0,10.9-8.86,19.76-19.76,19.76ZM21.62,61.45l-.07.74c-.04.38-.06.76-.06,1.13,0,10.23,8.32,18.55,18.55,18.55s18.55-8.32,18.55-18.55c0-.36-.02-.74-.06-1.13l-.07-.73.73.07c.38.04.76.06,1.13.06,10.23,0,18.55-8.32,18.55-18.55s-8.32-18.55-18.55-18.55c-.36,0-.74.02-1.13.06l-.73.07.07-.73c.04-.39.06-.77.06-1.13,0-7.84-11.28-17.11-16.12-20.73-1.45-1.08-3.4-1.08-4.84,0-4.85,3.62-16.12,12.89-16.12,20.73,0,.36.02.74.06,1.12l.07.73-.73-.07c-.39-.04-.77-.06-1.13-.06-10.23,0-18.55,8.32-18.55,18.55s8.32,18.55,18.55,18.55c.36,0,.74-.02,1.13-.06l.74-.07Z"/>
              </svg>
 
              <!-- Inner solid logo shape -->
              <svg class="badge-bg absolute w-[72px] h-[74.7px]" viewBox="0 0 80.08 83.08" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                <path d="M80.08,43.04c0,10.89-8.87,19.76-19.76,19.76-.18,0-.35-.01-.53-.02,0,.18.01.36.01.53,0,10.9-8.87,19.77-19.76,19.77s-19.76-8.87-19.76-19.77c0-.17,0-.35.01-.53-.18,0-.36.02-.53.02C8.86,62.8,0,53.93,0,43.04s8.86-19.76,19.76-19.76c.17,0,.35,0,.53,0-.01-.18-.01-.36-.01-.53,0-8.09,10.4-17.07,16.61-21.71,1.88-1.4,4.41-1.4,6.3,0,6.2,4.64,16.61,13.62,16.61,21.71,0,.17-.01.35-.01.53.18,0,.35,0,.53,0,10.89,0,19.76,8.86,19.76,19.76Z"/>
              </svg>
              
              <!-- Centered Icon (FontAwesome) -->
              <div class="badge-icon relative z-10 flex items-center justify-center w-7 h-7">
                <i class={`${feat.icon} text-lg`}></i>
              </div>
            </div>

          </div>

        </div>
      ))}
    </div>

    <!-- Full-Width Horizontal Stepped Card: Verzekeringen & Schade melden (Spekadvies Blue) -->
    <div class="feature-card feature-card--wide feature-card--blue relative w-full mt-6 lg:mt-8 transition-all duration-300 hover:-translate-y-1 group filter drop-shadow-[0_14px_32px_rgba(21,59,104,0.16)]">
      <div class="relative w-full">
        
        <!-- Masked Wide Card Background & Content -->
        <div class="feature-card__content feature-card__content--wide blue-card w-full">

          <!-- Wide Card Inner Layout (Same vertical rhythm as the 3 cards above) -->
          <div class="relative z-10 flex flex-col p-8 sm:p-9 pt-9 pb-8">
            
            <!-- Top Block: Badge + Title (Left-aligned at the top, pr-24 clears the top-right clover notch) -->
            <div class="pr-20 sm:pr-28">
              <span class="feature-card__badge ty-eyebrow mb-2">
                Verzekeringen &amp; Schadeservice
              </span>
              <h3 class="feature-card__title feature-card__title--wide ty-h3">
                Ook voor al je verzekeringen &amp; directe hulp bij schade
              </h3>
            </div>

            <!-- Upper Thin Divider Line -->
            <div class="feature-card__divider"></div>

            <!-- Middle Block: 2 Calm, Spacious Columns (Verzekeringen & Schade melden) -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-12">
              
              <!-- Column 1: Particuliere Verzekeringen -->
              <div class="space-y-1.5 pr-4">
                <h4 class="ty-h4 flex items-center gap-2 text-white">
                  <i class="fa-solid fa-house-lock text-[#ffce76] text-xs"></i>
                  <span>Wonen, Gezin &amp; Auto</span>
                </h4>
                <p class="feature-card__desc ty-body">
                  Van woonhuis-, inboedel- en aansprakelijkheidsverzekering tot je autoverzekering: één overzichtelijk pakket tegen de scherpste premie.
                </p>
              </div>

              <!-- Column 2: Direct Schade Melden -->
              <div class="space-y-1.5 md:border-l md:border-white/10 md:pl-8 lg:pl-12 pr-4">
                <h4 class="ty-h4 flex items-center gap-2 text-white">
                  <i class="fa-solid fa-triangle-exclamation text-[#ffce76] text-xs"></i>
                  <span>Direct persoonlijk bij schade</span>
                </h4>
                <p class="feature-card__desc ty-body">
                  Onverhoopt schade aan je woning, inboedel of auto? Meld het direct — wij nemen de volledige afhandeling persoonlijk uit handen.
                </p>
              </div>

            </div>

            <!-- Lower Thin Divider Line -->
            <div class="feature-card__divider"></div>

            <!-- Bottom Block: 2 Aligned Action Links -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 lg:gap-12">
              
              <a 
                href="/verzekeringen"
                class="feature-card__link link-action cursor-pointer w-full text-left bg-transparent border-none focus:outline-none flex items-center justify-between p-0 pr-4 transition-colors group/link1"
              >
                <span>Bekijk alle verzekeringen</span>
                <span class="inline-block ml-2 text-[#ffce76] group-hover/link1:translate-x-1.5 transition-transform duration-200">→</span>
              </a>

              <button 
                type="button"
                data-modal-trigger="schade"
                class="feature-card__link link-action cursor-pointer w-full text-left bg-transparent border-none focus:outline-none flex items-center justify-between p-0 md:pl-8 lg:pl-12 pr-4 transition-colors group/link3"
              >
                <span>Direct online schade melden</span>
                <span class="inline-block ml-2 text-[#ffce76] group-hover/link3:translate-x-1.5 transition-transform duration-200">→</span>
              </button>

            </div>

          </div>
        </div>

        <!-- Floating Logo Shape Badge (Exact same top-right notch badge as the 3 cards above) -->
        <div class="feature-card__icon-badge">
          <div class="badge-cutout-fill absolute inset-0 rounded-full"></div>
          
          <svg class="absolute w-[72px] h-[74.7px] text-white" viewBox="0 0 80.08 83.08" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <path d="M40.04,83.08c-10.9,0-19.76-8.87-19.76-19.76,0-.17,0-.35.01-.53-.18,0-.36.01-.53.01C8.86,62.8,0,53.93,0,43.04s8.86-19.76,19.76-19.76c.17,0,.35,0,.53.01,0-.18-.01-.36-.01-.53,0-8.08,10.41-17.07,16.61-21.7,1.88-1.41,4.42-1.41,6.3,0,6.2,4.64,16.61,13.62,16.61,21.7,0,.17,0,.35-.01.53.18,0,.36-.01.53-.01,10.9,0,19.76,8.86,19.76,19.76s-8.86,19.76-19.76,19.76c-.17,0-.35,0-.53-.01,0,.18.01.36.01.53,0,10.9-8.86,19.76-19.76,19.76ZM21.62,61.45l-.07.74c-.04.38-.06.76-.06,1.13,0,10.23,8.32,18.55,18.55,18.55s18.55-8.32,18.55-18.55c0-.36-.02-.74-.06-1.13l-.07-.73.73.07c.38.04.76.06,1.13.06,10.23,0,18.55-8.32,18.55-18.55s-8.32-18.55-18.55-18.55c-.36,0-.74.02-1.13.06l-.73.07.07-.73c.04-.39.06-.77.06-1.13,0-7.84-11.28-17.11-16.12-20.73-1.45-1.08-3.4-1.08-4.84,0-4.85,3.62-16.12,12.89-16.12,20.73,0,.36.02.74.06,1.12l.07.73-.73-.07c-.39-.04-.77-.06-1.13-.06-10.23,0-18.55,8.32-18.55,18.55s8.32,18.55,18.55,18.55c.36,0,.74-.02,1.13-.06l.74-.07Z"/>
          </svg>

          <svg class="badge-bg absolute w-[72px] h-[74.7px]" viewBox="0 0 80.08 83.08" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <path d="M80.08,43.04c0,10.89-8.87,19.76-19.76,19.76-.18,0-.35-.01-.53-.02,0,.18.01.36.01.53,0,10.9-8.87,19.77-19.76,19.77s-19.76-8.87-19.76-19.77c0-.17,0-.35.01-.53-.18,0-.36.02-.53.02C8.86,62.8,0,53.93,0,43.04s8.86-19.76,19.76-19.76c.17,0,.35,0,.53,0-.01-.18-.01-.36-.01-.53,0-8.09,10.4-17.07,16.61-21.71,1.88-1.4,4.41-1.4,6.3,0,6.2,4.64,16.61,13.62,16.61,21.71,0,.17-.01.35-.01.53.18,0,.35,0,.53,0,10.89,0,19.76,8.86,19.76,19.76Z"/>
          </svg>
          
          <div class="badge-icon relative z-10 flex items-center justify-center w-7 h-7">
            <i class="fa-solid fa-shield-halved text-lg"></i>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>

<!-- ========================================== -->
<!-- MODAL POPUPS (Zwolle & Willemse Inspired)  -->
<!-- ========================================== -->

<!-- Modal 1: Schade Melden -->
<div id="modal-schade" class="modal-overlay fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[100] flex items-center justify-center p-3 sm:p-4 opacity-0 pointer-events-none transition-all duration-300">
  <div class="bg-white rounded-[28px] sm:rounded-[32px] p-5 sm:p-8 md:p-10 shadow-2xl relative w-full max-w-lg max-h-[88dvh] overflow-y-auto transform scale-95 opacity-0 transition-all duration-300 modal-card">
    
    <!-- Close Button -->
    <button class="modal-close absolute top-4 right-4 sm:top-5 sm:right-5 w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 hover:text-slate-800 flex items-center justify-center transition-all cursor-pointer border-none outline-none z-10">
      <i class="fa-solid fa-xmark text-sm"></i>
    </button>

    <!-- Modal Header -->
    <div class="flex items-center space-x-3 mb-6 text-left pr-8">
      <div class="w-10 h-10 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-600 text-lg flex-shrink-0">
        <i class="fa-solid fa-triangle-exclamation"></i>
      </div>
      <h3 class="text-base sm:text-xl font-semibold text-brand-dark font-display leading-snug">Hoe wilt u schade melden?</h3>
    </div>

    <!-- Modal Options Grid -->
    <div class="space-y-4">
      
      <!-- Option 1: Online Schadetool (Recommended) -->
      <a href="#contact" class="modal-item block bg-emerald-50/40 border-2 border-emerald-600 hover:bg-emerald-50/80 rounded-2xl p-4 transition-all relative text-left">
        <span class="absolute top-2.5 right-4 bg-emerald-600 text-white text-[8px] font-semibold tracking-widest uppercase px-2 py-0.5 rounded">
          Aanbevolen
        </span>
        <div class="flex items-start space-x-4 pt-1">
          <div class="w-10 h-10 rounded-xl bg-emerald-100 flex items-center justify-center text-emerald-700 flex-shrink-0 text-base">
            <i class="fa-solid fa-bolt"></i>
          </div>
          <div class="pr-6">
            <h4 class="text-xs sm:text-sm font-semibold text-brand-dark font-display">Online schadetool</h4>
            <p   class="text-slate-600 text-[10px] sm:text-xs leading-relaxed font-sans font-normal mt-0.5">
              Snel, digitaal en gestructureerd melden — voor alle soorten schade. Wij ontvangen uw melding direct.
            </p>
          </div>
        </div>
      </a>

      <div class="relative py-2 flex items-center justify-center">
        <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-slate-100"></div></div>
        <span class="relative px-3 bg-white text-[9px] font-semibold text-slate-400 uppercase tracking-widest">of download PDF formulier</span>
      </div>

      <!-- Option 2: Schadeformulier Algemeen -->
      <a href="#" class="modal-item block bg-slate-50 border border-slate-200/80 hover:border-brand-accent/30 rounded-2xl p-4 transition-all text-left">
        <div class="flex items-start space-x-4">
          <div class="w-10 h-10 rounded-xl bg-amber-50 flex items-center justify-center text-amber-700 flex-shrink-0 text-base">
            <i class="fa-solid fa-file-pdf"></i>
          </div>
          <div>
            <h4 class="text-xs sm:text-sm font-semibold text-brand-dark font-display">Schadeformulier Algemeen</h4>
            <p   class="text-slate-600 text-[10px] sm:text-xs leading-relaxed font-sans font-normal mt-0.5">
              Digitaal invulbaar. Voor de meeste soorten schade (inboedel, aansprakelijkheid, etc.).
            </p>
          </div>
        </div>
      </a>

      <!-- Option 3: Europees Schadeformulier -->
      <a href="#" class="modal-item block bg-slate-50 border border-slate-200/80 hover:border-brand-accent/30 rounded-2xl p-4 transition-all text-left">
        <div class="flex items-start space-x-4">
          <div class="w-10 h-10 rounded-xl bg-amber-50 flex items-center justify-center text-amber-700 flex-shrink-0 text-base">
            <i class="fa-solid fa-car"></i>
          </div>
          <div>
            <h4 class="text-xs sm:text-sm font-semibold text-brand-dark font-display">Europees Schadeformulier Motorrijtuigen</h4>
            <p   class="text-slate-600 text-[10px] sm:text-xs leading-relaxed font-sans font-normal mt-0.5">
              Digitaal invulbaar. Vereist bij aanrijdingen met auto, motor of scooter.
            </p>
          </div>
        </div>
      </a>

    </div>
  </div>
</div>

<!-- Modal 2: Inloggen -->
<div id="modal-inloggen" class="modal-overlay fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[100] flex items-center justify-center p-3 sm:p-4 opacity-0 pointer-events-none transition-all duration-300">
  <div class="bg-white rounded-[28px] sm:rounded-[32px] p-5 sm:p-8 md:p-10 shadow-2xl relative w-full max-w-lg max-h-[88dvh] overflow-y-auto transform scale-95 opacity-0 transition-all duration-300 modal-card">
    
    <!-- Close Button -->
    <button class="modal-close absolute top-4 right-4 sm:top-5 sm:right-5 w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 hover:text-slate-800 flex items-center justify-center transition-all cursor-pointer border-none outline-none z-10">
      <i class="fa-solid fa-xmark text-sm"></i>
    </button>

    <!-- Modal Header -->
    <div class="flex items-center space-x-3 mb-6 text-left pr-8">
      <div class="w-10 h-10 rounded-xl bg-[#ab7a22]/10 flex items-center justify-center text-[#ab7a22] text-lg flex-shrink-0">
        <i class="fa-solid fa-user-lock"></i>
      </div>
      <h3 class="text-base sm:text-xl font-semibold text-brand-dark font-display leading-snug">Kies uw digitale portaal</h3>
    </div>

    <!-- Options -->
    <div class="space-y-4">

      <!-- FinSave Hypotheek -->
      <a href="https://spekadvies.finsave.nl" target="_blank" rel="noopener noreferrer" class="modal-item block bg-brand-accent/5 border-2 border-brand-accent hover:bg-brand-accent/10 rounded-2xl p-4 transition-all relative text-left">
        <span class="absolute top-2.5 right-4 bg-[#ab7a22] text-white text-[8px] font-semibold tracking-widest uppercase px-2 py-0.5 rounded">
          Hypotheken
        </span>
        <div class="flex items-start space-x-4 pt-1">
          <div class="w-10 h-10 rounded-xl bg-[#ab7a22]/10 flex items-center justify-center text-[#ab7a22] flex-shrink-0 text-base">
            <i class="fa-solid fa-piggy-bank"></i>
          </div>
          <div class="pr-12">
            <h4 class="text-xs sm:text-sm font-semibold text-brand-dark font-display">FinSave Dossier</h4>
            <p   class="text-slate-600 text-[10px] sm:text-xs leading-relaxed font-sans font-normal mt-0.5">
              Volg uw lopende hypotheekaanvraag, rentevoorstellen en upload veilig uw documenten.
            </p>
          </div>
        </div>
