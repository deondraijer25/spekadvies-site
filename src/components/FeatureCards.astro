<!-- JAVASCRIPT FOR TOGGLING POPUP MODALS      -->
<!-- ========================================== -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const triggers = document.querySelectorAll('[data-modal-trigger]');
    
    triggers.forEach(trigger => {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        const modalId = 'modal-' + trigger.getAttribute('data-modal-trigger');
        const modal = document.getElementById(modalId);
        
        if (modal) {
          openModal(modal);
        }
      });
    });

    function openModal(modal) {
      document.body.classList.add('overflow-hidden');
      modal.classList.remove('pointer-events-none', 'opacity-0');
      modal.classList.add('opacity-100');
      
      const card = modal.querySelector('.modal-card');
      if (card) {
        card.classList.remove('scale-95', 'opacity-0');
        card.classList.add('scale-100', 'opacity-100');
      }
    }

    function closeModal(modal) {
      document.body.classList.remove('overflow-hidden');
      modal.classList.remove('opacity-100');
      modal.classList.add('opacity-0', 'pointer-events-none');
      
      const card = modal.querySelector('.modal-card');
      if (card) {
        card.classList.remove('scale-100', 'opacity-100');
        card.classList.add('scale-95', 'opacity-0');
      }
    }

    // Attach closing handlers to all modals
    const modals = document.querySelectorAll('.modal-overlay');
    modals.forEach(modal => {
      // Close on close button click
      const closeBtn = modal.querySelector('.modal-close');
      if (closeBtn) {
        closeBtn.addEventListener('click', () => closeModal(modal));
      }

      // Close on backdrop overlay click
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          closeModal(modal);
        }
      });

      // Close on link inside modal click (like #contact anchor links)
      const links = modal.querySelectorAll('.modal-item');
      links.forEach(link => {
        link.addEventListener('click', () => closeModal(modal));
      });
    });

    // Close on ESC keypress
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        const activeModal = document.querySelector('.modal-overlay.opacity-100');
        if (activeModal) {
          closeModal(activeModal);
        }
      }
    });

    // Smooth Mouse-Following Glow & Stippels for FeatureCards (seamless with Hero)
    const featuresSection = document.getElementById('features-section');
    const featuresGlow = document.getElementById('features-mouse-glow');
    const heroSection = document.getElementById('hero-section');
    if (featuresSection && featuresGlow) {
      const syncDotOffset = () => {
        if (heroSection) {
          const offset = -(heroSection.offsetHeight % 24);
          featuresSection.style.setProperty('--dot-offset-y', `${offset}px`);
        }
      };
      syncDotOffset();
      window.addEventListener('resize', syncDotOffset, { passive: true });

      let rafId = null;
      let targetX = 0;
      let targetY = 0;
      let currentX = 0;
      let currentY = 0;
      let isActive = false;

      const updateFeaturesGlow = () => {
        const dx = targetX - currentX;
        const dy = targetY - currentY;

        if (Math.abs(dx) > 0.25 || Math.abs(dy) > 0.25) {
          currentX += dx * 0.16;
          currentY += dy * 0.16;
          featuresGlow.style.setProperty('--mouse-x', `${currentX.toFixed(1)}px`);
          featuresGlow.style.setProperty('--mouse-y', `${currentY.toFixed(1)}px`);
          rafId = requestAnimationFrame(updateFeaturesGlow);
        } else {
          rafId = null;
        }
      };

      window.addEventListener('mousemove', (e) => {
        const rect = featuresSection.getBoundingClientRect();
        // Keep glow active when mouse is within 450px of the section (so it crosses seamlessly from Hero)
        const inRange = e.clientY >= rect.top - 450 && e.clientY <= rect.bottom + 450;
        if (inRange) {
          targetX = e.clientX - rect.left;
          targetY = e.clientY - rect.top;
          if (!isActive) {
            isActive = true;
            currentX = targetX;
            currentY = targetY;
            featuresGlow.style.setProperty('--mouse-x', `${currentX.toFixed(1)}px`);
            featuresGlow.style.setProperty('--mouse-y', `${currentY.toFixed(1)}px`);
            featuresGlow.classList.remove('opacity-0');
            featuresGlow.classList.add('opacity-100');
          }
          if (!rafId) {
            rafId = requestAnimationFrame(updateFeaturesGlow);
          }
        } else if (isActive) {
          isActive = false;
          featuresGlow.classList.remove('opacity-100');
          featuresGlow.classList.add('opacity-0');
          if (rafId) {
            cancelAnimationFrame(rafId);
            rafId = null;
          }
        }
      }, { passive: true });
    }
  });
</script>

