---
const posts = [
  {
    title: "De invloed van energielabels op je maximale hypotheek",
    category: "Hypotheken",
    date: "Actueel",
    desc: "Een beter energielabel betekent extra leencapaciteit. Lees hoe je extra ruimte kunt benutten voor een energiezuinig huis.",
    link: "/kennisbank/energiebespaarbudget-hypotheek"
  },
  {
    title: "AOV voor ZZP'ers: hoe kies je de juiste wachttijd en dekking?",
    category: "Verzekeringen",
    date: "Gids",
    desc: "Een slim ingerichte arbeidsongeschiktheidsverzekering voor zelfstandigen houdt de premie betaalbaar. Wat betekent dit voor jouw dekking?",
    link: "/kennisbank/aov-zzp-wachttijd-en-premie"
  },
  {
    title: "Boeterente bij oversluiten: hoe wordt dit berekend?",
    category: "Financieel",
    date: "Verdieping",
    desc: "De hypotheekrente schommelt. We leggen uit hoe banken het renteverlies berekenen en wanneer oversluiten direct loont.",
    link: "/kennisbank/boeterente-oversluiten-berekenen"
  }
];
---

<section id="nieuws" class="py-20 lg:py-28 relative scroll-mt-20">
  <div class="absolute left-1/2 bottom-0 -translate-x-1/2 w-[350px] h-[350px] rounded-full bg-brand-primary/5 blur-[120px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col sm:flex-row items-end justify-between gap-6 mb-16">
      <div class="max-w-xl">
        <h2 class="text-3xl sm:text-5xl font-semibold text-brand-dark tracking-tight font-display">
          Laatste Updates & Blog
        </h2>
      </div>
      <div>
        <a 
          href="#nieuws" 
          class="inline-block bg-brand-basetint hover:bg-slate-200 text-brand-dark border border-slate-200 font-semibold px-8 py-3.5 rounded-xl text-xs tracking-wider uppercase transition-all font-sans"
        >
          Bekijk Alle Artikelen
        </a>
      </div>
    </div>

    <!-- Blog Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {posts.map((post) => (
        <div class="bg-white border border-slate-200/80 rounded-3xl p-8 flex flex-col justify-between hover:border-brand-primary/30 transition-all duration-300 shadow-xl group">
          <div>
            <!-- Meta info -->
            <div class="flex items-center justify-between text-[10px] font-semibold text-slate-500 uppercase tracking-widest mb-6">
              <span>{post.date}</span>
              <span class="text-brand-primary">•</span>
              <span>{post.category}</span>
            </div>

            <h3 class="text-lg sm:text-xl font-semibold text-brand-dark mb-3 font-display group-hover:text-brand-primary transition-colors leading-snug">
              {post.title}
            </h3>
            
            <p   class="text-slate-600 text-xs sm:text-sm leading-relaxed font-sans font-normal mb-6">
              {post.desc}
            </p>
          </div>

          <a 
            href={post.link} 
            class="text-brand-primary font-semibold text-xs uppercase tracking-widest flex items-center hover:text-brand-dark transition-colors pt-4 border-t border-slate-100"
          >
            Lees Artikel <span class="ml-2 group-hover:translate-x-1 transition-transform">→</span>
          </a>
        </div>
      ))}
    </div>

  </div>
</section>
