---
---
<section class="py-16 relative overflow-hidden bg-brand-lighttint">
  <!-- Glowing circle overlays -->
  <div class="absolute -left-32 -bottom-32 w-80 h-80 rounded-full bg-brand-primary/10 blur-3xl pointer-events-none"></div>
  <div class="absolute -right-32 -top-32 w-80 h-80 rounded-full bg-white/5 blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="flex flex-col lg:flex-row items-center justify-between gap-8">
      
      <!-- Text (Left) -->
      <div class="space-y-3 text-center lg:text-left">
        <span class="text-brand-primary text-xs font-bold tracking-widest uppercase block font-display">Altijd een scherp aanbod</span>
        <h2 class="text-2xl sm:text-4xl font-bold text-white tracking-tight leading-tight max-w-2xl font-display">
          Ontdek direct de scherpste rente voor jouw hypotheek.
        </h2>
      </div>

      <!-- Action (Right) -->
      <div class="flex-shrink-0 w-full lg:w-auto text-center">
        <a 
          href="#contact" 
          class="inline-block bg-brand-primary hover:bg-brand-primary-hover text-brand-dark font-semibold px-8 py-4 rounded-full shadow-xl transition-all transform hover:-translate-y-0.5 text-sm tracking-wider uppercase font-sans"
        >
          Gratis Renteberekening
        </a>
      </div>

    </div>
  </div>
</section>
