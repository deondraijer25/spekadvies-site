                viewBox="0 0 16 16" 
                fill="none" 
                xmlns="http://www.w3.org/2000/svg"
                aria-hidden="true"
              >
                <path d="M3 8H13M13 8L8.5 3.5M13 8L8.5 12.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>

          <!-- Secondary Light Outline Pill Button with Animated Rolling Text -->
          <a 
            href="tel:+31795931241" 
            class="btn-secondary group inline-flex items-center justify-center gap-3 px-6 py-3.5 rounded-full bg-slate-100 hover:bg-white text-brand-dark border border-slate-200/80 hover:border-[#ffce76] shadow-xs hover:shadow-md hover:-translate-y-0.5 transition-all duration-300"
