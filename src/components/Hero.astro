---
---
<section class="relative pt-16 pb-20 sm:pt-24 sm:pb-32 lg:pt-32 lg:pb-36 overflow-hidden bg-[#0b1a2f] flex items-center justify-center min-h-[580px] sm:min-h-[640px] lg:min-h-[680px]">
  <!-- Luminous background blur glows -->
  <div class="absolute left-1/4 top-1/4 w-[450px] h-[450px] rounded-full bg-brand-primary/10 blur-[130px] pointer-events-none"></div>
  <div class="absolute right-1/4 bottom-1/4 w-[350px] h-[350px] rounded-full bg-brand-dark/30 blur-[100px] pointer-events-none"></div>

  <!-- Full-screen Desktop/Mobile Background Hero Video -->
  <div class="absolute inset-0 w-full h-full z-0 select-none overflow-hidden">
    <!-- Balanced dark navy gradient overlay ensuring high legibility and calm atmosphere -->
    <div class="absolute inset-0 bg-gradient-to-b from-[#0b1a2f]/90 via-[#0b1a2f]/75 to-[#0b1a2f] z-10"></div>
    <video 
      autoplay 
      loop 
      muted 
      playsinline 
      class="w-full h-full object-cover object-center scale-105 opacity-40"
      poster="/assets/spekadvies-hero.png"
    >
      <source src="/videos/hero-video.mp4" type="video/mp4" />
    </video>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-8 lg:px-12 relative z-10 flex flex-col items-center justify-center text-center">
    <div class="max-w-3xl flex flex-col items-center space-y-6 sm:space-y-7 animate-fade-in-up relative">
      
      <!-- Eyebrow Pill Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-brand-primary/15 border border-brand-primary/30 text-brand-primary text-xs sm:text-sm font-sans font-semibold tracking-wide backdrop-blur-md">
        <i class="fa-solid fa-star text-[11px] text-brand-primary"></i>
        <span>Onafhankelijk Hypotheekadvies • Moerkapelle & Regio</span>
      </div>

      <!-- Main Headline (Max Semi-Bold 600) -->
      <h1 class="text-3xl sm:text-5xl lg:text-[52px] font-semibold text-white tracking-tight leading-[1.2] font-display max-w-3xl">
        Jouw droomhuis & toekomst perfect geregeld.
      </h1>
      
      <!-- Subheading (Clear Value Proposition) -->
      <p class="text-slate-200 text-sm sm:text-lg leading-relaxed max-w-2xl font-sans font-normal px-2">
        Eerlijk, deskundig en 100% onafhankelijk advies met échte persoonlijke aandacht. Wij vergelijken meer dan 40 aanbieders voor de laagste rente en beste voorwaarden.
      </p>

      <!-- Conversion CTA Buttons (Primary & Secondary) -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 sm:gap-4 w-full pt-2">
        <!-- Primary Gold CTA -->
        <button 
          class="open-contact-drawer group w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-full bg-brand-primary hover:bg-brand-primary-hover text-brand-dark font-bold font-sans text-sm sm:text-base shadow-[0_10px_25px_rgba(255,206,118,0.35)] hover:shadow-[0_15px_30px_rgba(255,206,118,0.45)] hover:-translate-y-0.5 transition-all duration-300 cursor-pointer"
        >
          <span>Plan gratis kennismaking</span>
          <i class="fa-solid fa-arrow-right text-xs group-hover:translate-x-1 transition-transform"></i>
        </button>

        <!-- Secondary Phone CTA -->
        <a 
          href="tel:+31795931241" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-7 py-4 rounded-full bg-white/10 hover:bg-white/15 text-white font-semibold font-sans text-sm sm:text-base border border-white/20 hover:border-white/35 backdrop-blur-md transition-all duration-300 shadow-sm"
        >
          <i class="fa-solid fa-phone text-brand-primary text-xs"></i>
          <span>079 593 1241</span>
        </a>
      </div>

      <!-- Trust stats / Social Proof Row -->
      <div class="pt-4 flex flex-wrap items-center justify-center gap-x-5 gap-y-2.5 text-xs sm:text-sm text-slate-300 font-sans">
        <div class="flex items-center space-x-1.5">
          <span class="text-amber-400 font-bold text-xs tracking-wider">★★★★★</span>
          <span class="font-bold text-white">9.4</span>
          <span class="text-slate-300">Klantbeoordeling</span>
        </div>
        <div class="w-1.5 h-1.5 rounded-full bg-white/25 hidden sm:block"></div>
        <div class="flex items-center space-x-1.5">
          <i class="fa-solid fa-check text-brand-primary text-xs"></i>
          <span>100% Onafhankelijk (40+ banken)</span>
        </div>
        <div class="w-1.5 h-1.5 rounded-full bg-white/25 hidden sm:block"></div>
        <div class="flex items-center space-x-1.5">
          <i class="fa-solid fa-check text-brand-primary text-xs"></i>
          <span>Eerste gesprek altijd gratis</span>
        </div>
      </div>

    </div>
  </div>
</section>
