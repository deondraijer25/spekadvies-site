---
---
<section id="hero-section" class="relative pt-12 pb-20 sm:pt-14 sm:pb-24 lg:pt-16 lg:pb-44 xl:pb-48 min-h-[660px] lg:min-h-[860px] xl:min-h-[920px] flex items-center overflow-x-clip bg-white">
  <!-- Subtle soft ambient background accents -->
  <div class="absolute top-0 right-1/4 w-[500px] h-[500px] rounded-full bg-sky-50/80 blur-[120px] pointer-events-none -z-10"></div>
  <div class="absolute bottom-0 left-10 w-[400px] h-[400px] rounded-full bg-amber-50/60 blur-[100px] pointer-events-none -z-10"></div>

  <!-- Subtle baseline faint dot grid across hero background -->
  <div 
    class="pointer-events-none absolute inset-0 z-0 opacity-25" 
    aria-hidden="true"
    style="background-image: radial-gradient(circle, rgba(148, 163, 184, 0.45) 1px, transparent 1px); background-size: 24px 24px;"
  ></div>

  <!-- Interactive Mouse-Following Subtle Orange Glow Gradient & Glowing Stippels -->
  <div 
    id="hero-mouse-glow" 
    class="pointer-events-none absolute inset-0 z-0 transition-opacity duration-500 opacity-0 overflow-hidden"
    aria-hidden="true"
  >
    <!-- Soft warm ambient radial gradient following mouse -->
    <div 
      class="absolute inset-0"
      style="background: radial-gradient(550px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(251, 146, 60, 0.14), rgba(255, 206, 118, 0.07) 38%, transparent 75%);"
    ></div>

    <!-- Very light stippels (dot matrix) illuminated by the mouse with warm gradient -->
    <div 
      class="absolute inset-0"
      style="
        background-image: radial-gradient(circle, rgba(234, 88, 12, 0.65) 1.25px, transparent 1.25px);
        background-size: 24px 24px;
        -webkit-mask-image: radial-gradient(420px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), black 10%, rgba(0,0,0,0.5) 45%, transparent 75%);
        mask-image: radial-gradient(420px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), black 10%, rgba(0,0,0,0.5) 45%, transparent 75%);
      "
    ></div>
  </div>

  <!-- Exact 0..1 Normalized SVG ClipPath for the Spekadvies Clover (80.08 x 83.08) -->
  <svg class="sr-only absolute w-0 h-0" width="0" height="0" aria-hidden="true">
    <defs>
      <clipPath id="spekadvies-clover-exact" clipPathUnits="objectBoundingBox">
        <path d="M1,0.51805c0,0.13108 -0.11076,0.23784 -0.24675,0.23784 -0.00225,0 -0.00437,-0.00012 -0.00662,-0.00024 0,0.00217 0.00012,0.00433 0.00012,0.00638 0,0.1312 -0.11076,0.23796 -0.24675,0.23796s-0.24675,-0.10676 -0.24675,-0.23796c0,-0.00205 0,-0.00421 0.00012,-0.00638 -0.00225,0 -0.0045,0.00024 -0.00662,0.00024C0.11064,0.75589 0,0.64913 0,0.51805s0.11064,-0.23784 0.24675,-0.23784c0.00212,0 0.00437,0 0.00662,0 -0.00012,-0.00217 -0.00012,-0.00433 -0.00012,-0.00638 0,-0.09738 0.12987,-0.20546 0.20742,-0.26131 0.02348,-0.01685 0.05507,-0.01685 0.07867,0 0.07742,0.05585 0.20742,0.16394 0.20742,0.26131 0,0.00205 -0.00012,0.00421 -0.00012,0.00638 0.00225,0 0.00437,0 0.00662,0 0.13599,0 0.24675,0.10664 0.24675,0.23784Z" />
      </clipPath>
    </defs>
  </svg>

  <!-- Right-Side 3-Clover Composition (Expanded towards bottom-left, 100% unclipped at bottom) -->
  <div 
    class="hidden lg:block absolute top-0 bottom-0 right-0 h-full aspect-[1/1] pointer-events-none select-none z-10"
  >
    
    <!-- 1. Medium Spekadvies Orange/Gold Clover (#ffce76, Behind Top-Left, Upright 0deg) -->
    <svg 
      class="absolute z-10 text-[#ffce76]" 
      style="height: 43%; left: 6%; top: 2%; aspect-ratio: 80.08 / 83.08;"
      viewBox="0 0 80.08 83.08" 
      fill="currentColor" 
      xmlns="http://www.w3.org/2000/svg"
    >
      <path d="M80.08,43.04c0,10.89-8.87,19.76-19.76,19.76-.18,0-.35-.01-.53-.02,0,.18.01.36.01.53,0,10.9-8.87,19.77-19.76,19.77s-19.76-8.87-19.76-19.77c0-.17,0-.35.01-.53-.18,0-.36.02-.53.02C8.86,62.8,0,53.93,0,43.04s8.86-19.76,19.76-19.76c.17,0,.35,0,.53,0-.01-.18-.01-.36-.01-.53,0-8.09,10.4-17.07,16.61-21.71,1.88-1.4,4.41-1.4,6.3,0,6.2,4.64,16.61,13.62,16.61,21.71,0,.17-.01.35-.01.53.18,0,.35,0,.53,0,10.89,0,19.76,8.86,19.76,19.76Z"/>
    </svg>

    <!-- 2. Large Spekadvies Dark-Blue Clover (#153b68) with Waterpas Video Inside (Tilted 19deg Clockwise) -->
    <div 
      class="absolute z-20"
      style="height: 89%; right: -3%; top: 3.5%; aspect-ratio: 80.08 / 83.08; transform: rotate(19deg); transform-origin: center center;"
    >
      <div 
        class="w-full h-full overflow-hidden bg-[#153b68]"
        style="clip-path: url(#spekadvies-clover-exact); -webkit-clip-path: url(#spekadvies-clover-exact);"
      >
        <!-- Counter-rotated video (-19deg) at scale(1.20) to cover all clover tips with exact same framing -->
        <video 
          id="hero-video-desktop"
          autoplay 
          loop 
          muted 
          playsinline 
          preload="metadata"
          data-src="/videos/hero-video.mp4"
          class="w-full h-full object-cover pointer-events-none"
          style="transform: rotate(-19deg) scale(1.20); transform-origin: center center; object-position: center 38%;"
        ></video>
        <!-- Subtle brand navy tint so the video sits naturally inside the Spekadvies blue clover -->
        <div class="absolute inset-0 bg-[#153b68]/12 pointer-events-none"></div>
      </div>
    </div>

    <!-- 3. Small Spekadvies Orange/Gold Accent Clover (#ffce76, In Front on Right, Tilted -25deg) -->
    <svg 
      class="absolute z-30 text-[#ffce76] drop-shadow-[0_6px_16px_rgba(21,59,104,0.22)]" 
      style="height: 13.5%; right: 5%; top: 44%; aspect-ratio: 80.08 / 83.08; transform: rotate(-25deg); transform-origin: center center;"
      viewBox="0 0 80.08 83.08" 
      fill="currentColor" 
      xmlns="http://www.w3.org/2000/svg"
    >
      <path d="M80.08,43.04c0,10.89-8.87,19.76-19.76,19.76-.18,0-.35-.01-.53-.02,0,.18.01.36.01.53,0,10.9-8.87,19.77-19.76,19.77s-19.76-8.87-19.76-19.77c0-.17,0-.35.01-.53-.18,0-.36.02-.53.02C8.86,62.8,0,53.93,0,43.04s8.86-19.76,19.76-19.76c.17,0,.35,0,.53,0-.01-.18-.01-.36-.01-.53,0-8.09,10.4-17.07,16.61-21.71,1.88-1.4,4.41-1.4,6.3,0,6.2,4.64,16.61,13.62,16.61,21.71,0,.17-.01.35-.01.53.18,0,.35,0,.53,0,10.89,0,19.76,8.86,19.76,19.76Z"/>
    </svg>

  </div>

  <div class="w-full max-w-7xl mx-auto px-4 sm:px-8 lg:px-12 relative z-20">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Left Column: Typography, Value Proposition, Actions, Stats & Moving Partner Bar -->
      <div class="lg:col-span-6 xl:col-span-6 flex flex-col justify-center space-y-6 sm:space-y-7 text-left relative z-20">

        <!-- Main Headline (H1 = 24px -> 32px, Unbounded SemiBold 600, Spekadvies blue) -->
        <h1 class="ty-h1 text-brand-dark">
          Persoonlijk hypotheekadvies <br class="hidden sm:inline" />in <span class="text-brand-dark underline decoration-brand-accent decoration-4 underline-offset-8">Moerkapelle</span> en omstreken
        </h1>

        <!-- Subheading Paragraph (Lead = 15px -> 16px, Poppins Regular 400) -->
        <p class="ty-lead text-slate-600 max-w-lg">
          Zorgeloos je eerste woning kopen, soepel doorstromen of direct besparen op je vaste lasten. Wij begeleiden je van de eerste berekening tot aan de sleuteloverdracht bij de notaris.
        </p>

        <!-- CTA Pill Buttons (15px, Poppins SemiBold 600) -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-1">
          <!-- Primary Spekadvies Dark-Blue (#153b68) Pill Button -->
          <a 
            href="/adviesgesprek"
            class="open-contact-drawer btn-primary group relative inline-flex items-center justify-center gap-3.5 px-7 py-3.5 rounded-full bg-brand-dark hover:bg-slate-900 text-white shadow-lg shadow-brand-dark/15 hover:shadow-xl hover:shadow-amber-500/15 hover:-translate-y-0.5 transition-all duration-300 cursor-pointer overflow-hidden"
          >
            <!-- Animated Rolling Text -->
            <span class="relative inline-flex flex-col h-[1.35em] overflow-hidden leading-tight font-semibold">
              <span class="inline-block transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:-translate-y-full">
                Plan een afspraak
              </span>
              <span class="inline-block absolute top-0 left-0 transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] translate-y-full group-hover:translate-y-0 text-[#ffce76]" aria-hidden="true">
                Plan een afspraak
              </span>
            </span>

            <!-- Animated Pill Arrow Circle with Dual Sliding SVG Arrow -->
            <span class="relative w-7 h-7 rounded-full bg-white/15 group-hover:bg-[#ffce76] group-hover:text-brand-dark flex items-center justify-center overflow-hidden transition-all duration-300 shrink-0">
              <!-- Primary Arrow (slides right on hover) -->
              <svg 
                class="w-3.5 h-3.5 transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-x-6" 
                viewBox="0 0 16 16" 
                fill="none" 
                xmlns="http://www.w3.org/2000/svg"
              >
                <path d="M3 8H13M13 8L8.5 3.5M13 8L8.5 12.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
