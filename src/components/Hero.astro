                    <svg class="w-4 h-4 fill-current text-amber-500 shrink-0" viewBox="0 0 24 24">
                      <circle cx="8" cy="8" r="4"/>
                      <circle cx="16" cy="8" r="4"/>
                      <circle cx="8" cy="16" r="4"/>
                      <circle cx="16" cy="16" r="4"/>
                    </svg>
                    <span class="font-sans font-semibold text-sm tracking-tight">Florius</span>
                  </div>

                  <!-- Obvion -->
                  <div class="flex items-center gap-1.5 text-brand-dark">
                    <span class="w-2 h-2 rounded-full bg-[#ffce76] shrink-0"></span>
                    <span class="font-sans font-semibold text-sm tracking-tight">Obvion</span>
                  </div>

                  <!-- Nationale-Nederlanden -->
                  <div class="flex items-center gap-1.5 text-brand-dark">
                    <span class="w-2 h-2 rounded-full bg-amber-500 shrink-0"></span>
                    <span class="font-sans font-semibold text-sm tracking-tight">Nationale-Nederlanden</span>
                  </div>

                  <!-- a.s.r. -->
                  <div class="flex items-center gap-1.5 text-brand-dark">
                    <span class="w-2 h-2 rounded-full bg-[#ffce76] shrink-0"></span>
                    <span class="font-sans font-semibold text-sm tracking-normal">a.s.r.</span>
                  </div>

                  <!-- Munt Hypotheken -->
                  <div class="flex items-center gap-1.5 text-brand-dark">
                    <span class="w-2 h-2 rounded-full bg-amber-500 shrink-0"></span>
                    <span class="font-sans font-semibold text-sm tracking-tight">Munt Hypotheken</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

      </div>

      <!-- Mobile & Tablet (< lg) Clover Composition -->
      <div class="lg:hidden relative w-full max-w-[460px] mx-auto aspect-[80.08/83.08] mt-4">
        <svg 
          class="absolute z-10 text-[#ffce76]" 
          style="width: 44%; left: 8%; top: -4%; aspect-ratio: 80.08 / 83.08;"
          viewBox="0 0 80.08 83.08" 
          fill="currentColor"
        >
          <path d="M80.08,43.04c0,10.89-8.87,19.76-19.76,19.76-.18,0-.35-.01-.53-.02,0,.18.01.36.01.53,0,10.9-8.87,19.77-19.76,19.77s-19.76-8.87-19.76-19.77c0-.17,0-.35.01-.53-.18,0-.36.02-.53.02C8.86,62.8,0,53.93,0,43.04s8.86-19.76,19.76-19.76c.17,0,.35,0,.53,0-.01-.18-.01-.36-.01-.53,0-8.09,10.4-17.07,16.61-21.71,1.88-1.4,4.41-1.4,6.3,0,6.2,4.64,16.61,13.62,16.61,21.71,0,.17-.01.35-.01.53.18,0,.35,0,.53,0,10.89,0,19.76,8.86,19.76,19.76Z"/>
