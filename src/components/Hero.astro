            </span>
            <span class="relative inline-flex flex-col h-[1.35em] overflow-hidden leading-tight font-semibold">
              <span class="inline-block transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:-translate-y-full">
                079 593 1241
              </span>
              <span class="inline-block absolute top-0 left-0 transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] translate-y-full group-hover:translate-y-0 text-amber-700" aria-hidden="true">
                079 593 1241
              </span>
            </span>
          </a>
        </div>

        <!-- Metric Stats Row -->
        <div class="pt-3 sm:pt-4 grid grid-cols-3 gap-4 max-w-lg">
          <div>
            <div class="ty-stat text-brand-dark">150+</div>
            <div class="ty-small text-slate-500 mt-1">Tevreden kopers</div>
          </div>
          <div>
            <div class="ty-stat text-brand-dark">40+</div>
            <div class="ty-small text-slate-500 mt-1">Banken vergeleken</div>
          </div>
          <div>
            <div class="ty-stat text-brand-dark flex items-baseline gap-1">
