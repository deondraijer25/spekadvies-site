                  <!-- Rabobank -->
                  <div class="flex items-center gap-2 text-brand-dark">
                    <svg class="w-4 h-4 fill-current text-amber-500 shrink-0" viewBox="0 0 24 24">
                      <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2.2"/>
                      <circle cx="12" cy="12" r="4" fill="currentColor"/>
                    </svg>
                    <span class="font-sans font-semibold text-sm tracking-tight">Rabobank</span>
                  </div>

                  <!-- ING -->
