                    </svg>
                    <span class="font-sans font-semibold text-sm tracking-tight">ING</span>
                  </div>

                  <!-- ABN AMRO -->
                  <div class="flex items-center gap-1.5 text-brand-dark">
                    <svg class="w-3.5 h-4 fill-current text-amber-500 shrink-0" viewBox="0 0 20 24">
                      <polygon points="10,0 20,8 16,24 4,24 0,8"/>
                    </svg>
                    <span class="font-sans font-semibold text-xs tracking-wider">ABN AMRO</span>
                  </div>

                  <!-- Florius -->
