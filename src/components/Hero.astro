---
---
<section class="relative pt-4 pb-16 sm:pt-6 sm:pb-20 lg:pt-8 lg:pb-24 overflow-x-clip bg-white">
  <!-- Subtle soft ambient background accents -->
  <div class="absolute top-0 right-1/4 w-[500px] h-[500px] rounded-full bg-sky-50/80 blur-[120px] pointer-events-none -z-10"></div>
  <div class="absolute bottom-0 left-10 w-[400px] h-[400px] rounded-full bg-amber-50/60 blur-[100px] pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-8 lg:px-12 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 xl:gap-16 items-center">
      
      <!-- Left Column: Typography, Value Proposition & Actions -->
      <div class="lg:col-span-6 xl:col-span-6 flex flex-col justify-center space-y-6 sm:space-y-7 text-left">
        
        <!-- Eyebrow Sub-tag -->
        <div class="inline-flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-amber-500"></span>
          <span class="text-xs sm:text-[13px] font-semibold uppercase tracking-widest text-slate-500 font-sans">
            Onafhankelijk Hypotheekadvies in jouw regio
          </span>
        </div>

        <!-- Main Headline (Crisp, semi-bold, AdeptMort style) -->
        <h1 class="text-3xl sm:text-5xl lg:text-[54px] font-semibold text-slate-900 tracking-tight leading-[1.15] font-display" style="font-weight: 600 !important;">
          BETROUWBAAR, ONAFHANKELIJK <span class="text-brand-dark underline decoration-brand-accent decoration-4 underline-offset-8">HYPOTHEEK</span> ADVIES.
        </h1>

        <!-- Subheading Paragraph -->
        <p class="text-slate-600 text-base sm:text-lg leading-relaxed max-w-xl font-sans font-normal">
          Deskundig en persoonlijk advies voor jouw eerste koopwoning, doorstroming of oversluiting. Wij vergelijken meer dan 40 aanbieders voor de beste voorwaarden en laagste maandlasten.
        </p>

        <!-- CTA Pill Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-2">
          <!-- Primary Dark Navy Pill Button -->
          <button 
            class="open-contact-drawer group inline-flex items-center justify-center gap-3 px-8 py-4 rounded-full bg-slate-900 hover:bg-brand-dark text-white font-semibold font-sans text-sm sm:text-base shadow-lg shadow-slate-900/10 hover:shadow-xl hover:-translate-y-0.5 transition-all duration-300 cursor-pointer"
          >
            <span>Plan gratis kennismaking</span>
            <span class="w-6 h-6 rounded-full bg-white/20 flex items-center justify-center text-xs group-hover:translate-x-1 transition-transform">
              →
            </span>
          </button>

          <!-- Secondary Light Outline Pill Button -->
          <a 
            href="tel:+31795931241" 
            class="inline-flex items-center justify-center gap-2.5 px-6 py-4 rounded-full bg-slate-100 hover:bg-slate-200/80 text-slate-800 font-semibold font-sans text-sm sm:text-base border border-slate-200/80 transition-all duration-300"
          >
            <i class="fa-solid fa-phone text-slate-500 text-xs"></i>
            <span>079 593 1241</span>
          </a>
        </div>

        <!-- Metric Stats Row (Matching AdeptMort 3-stat format) -->
        <div class="pt-8 sm:pt-10 border-t border-slate-200/80 grid grid-cols-3 gap-4 max-w-lg">
          <div>
            <div class="text-2xl sm:text-3xl font-semibold text-slate-900 font-display">150+</div>
            <div class="text-[11px] sm:text-xs text-slate-500 font-sans mt-0.5 leading-snug">Tevreden kopers</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-semibold text-slate-900 font-display">40+</div>
            <div class="text-[11px] sm:text-xs text-slate-500 font-sans mt-0.5 leading-snug">Banken vergeleken</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-semibold text-slate-900 font-display flex items-baseline gap-1">
              <span>9.4</span>
              <span class="text-amber-500 text-sm font-normal">★★★★★</span>
            </div>
            <div class="text-[11px] sm:text-xs text-slate-500 font-sans mt-0.5 leading-snug">Klantbeoordeling</div>
          </div>
        </div>

      </div>

      <!-- Right Column: Massive Spekadvies Brand Crest Icon with Natural Video Inside -->
      <div class="lg:col-span-6 xl:col-span-6 relative flex items-center justify-center py-2 sm:py-4 -mt-10 sm:-mt-16 lg:-mt-24 xl:-mt-28">
        
        <!-- Ambient Brand Glow & Atmosphere Behind Shape -->
        <div class="absolute -inset-10 sm:-inset-20 bg-gradient-to-tr from-amber-200/50 via-sky-100/60 to-amber-100/40 rounded-full blur-3xl pointer-events-none -z-10"></div>
        <div class="absolute -inset-6 sm:-inset-10 bg-sky-100/50 rounded-full blur-2xl pointer-events-none -z-10"></div>

        <!-- SVG ClipPath Definition (Normalized 0..1 coordinates for objectBoundingBox) -->
        <svg class="sr-only absolute w-0 h-0" width="0" height="0" aria-hidden="true">
          <defs>
            <clipPath id="spekadvies-crest-mask" clipPathUnits="objectBoundingBox">
              <path d="M1,0.51805c0,0.13108 -0.11076,0.23784 -0.24675,0.23784 -0.00225,0 -0.00437,-0.00012 -0.00662,-0.00024 0,0.00217 0.00012,0.00433 0.00012,0.00638 0,0.1312 -0.11076,0.23796 -0.24675,0.23796s-0.24675,-0.10676 -0.24675,-0.23796c0,-0.00205 0,-0.00421 0.00012,-0.00638 -0.00225,0 -0.0045,0.00024 -0.00662,0.00024C0.11064,0.7559 0,0.64913 0,0.51805s0.11064,-0.23784 0.24675,-0.23784c0.00212,0 0.00437,0 0.00662,0 -0.00012,-0.00217 -0.00012,-0.00433 -0.00012,-0.00638 0,-0.09738 0.12987,-0.20546 0.20742,-0.26131 0.02348,-0.01685 0.05507,-0.01685 0.07867,0 0.07742,0.05585 0.20742,0.16394 0.20742,0.26131 0,0.00205 -0.00012,0.00421 -0.00012,0.00638 0.00225,0 0.00437,0 0.00662,0 0.13599,0 0.24675,0.10664 0.24675,0.23784Z" />
            </clipPath>
          </defs>
        </svg>

        <!-- Unrotated Outer Anchor for Floating Badges & Alignment -->
        <div class="relative w-full max-w-[580px] sm:max-w-[680px] lg:max-w-[780px] xl:max-w-[860px] aspect-[80.08/83.08] flex items-center justify-center group">
          
          <!-- Tilted Crest Shape Container (Rotated 15 degrees) -->
          <div 
            class="relative w-full h-full filter drop-shadow-[0_24px_50px_rgba(21,59,104,0.18)] transition-transform duration-700 group-hover:scale-[1.02]"
            style="transform: rotate(15deg); transform-origin: center center;"
          >
            <!-- Outer Decorative Subtle Brand Border Ring (Rotated with the shape) -->
            <svg class="absolute inset-0 w-full h-full pointer-events-none z-20" viewBox="0 0 80.08 83.08">
              <path 
                d="M80.08,43.04c0,10.89-8.87,19.76-19.76,19.76-.18,0-.35-.01-.53-.02,0,.18.01.36.01.53,0,10.9-8.87,19.77-19.76,19.77s-19.76-8.87-19.76-19.77c0-.17,0-.35.01-.53-.18,0-.36.02-.53.02C8.86,62.8,0,53.93,0,43.04s8.86-19.76,19.76-19.76c.17,0,.35,0,.53,0-.01-.18-.01-.36-.01-.53,0-8.09,10.4-17.07,16.61-21.71,1.88-1.4,4.41-1.4,6.3,0,6.2,4.64,16.61,13.62,16.61,21.71,0,.17-.01.35-.01.53.18,0,.35,0,.53,0,10.89,0,19.76,8.86,19.76,19.76Z" 
                fill="none" 
                stroke="#ffce76" 
                stroke-width="1.2"
                class="opacity-90"
              />
            </svg>

            <!-- Clipped Video Container (Masked by SVG Shape, Rotated 15 degrees) -->
            <div 
              class="w-full h-full overflow-hidden bg-slate-900"
              style="clip-path: url(#spekadvies-crest-mask); -webkit-clip-path: url(#spekadvies-crest-mask);"
            >
              <!-- Video Counter-Rotated by -15 degrees so the video stays 100% upright/horizontal! -->
              <video 
                autoplay 
                loop 
                muted 
                playsinline 
                class="w-full h-full object-cover object-center pointer-events-none"
                style="transform: rotate(-15deg) scale(1.4); transform-origin: center center;"
                poster="/assets/spekadvies-hero.png"
              >
                <source src="/videos/hero-video.mp4" type="video/mp4" />
              </video>
            </div>
          </div>

          <!-- Floating Glass Badge: Erkend Financieel Adviseur (Remains level/horizontal) -->
          <div class="absolute top-10 sm:top-14 left-0 sm:left-4 px-3 sm:px-4 py-1.5 sm:py-2 rounded-full bg-white/95 backdrop-blur-md shadow-lg border border-slate-100 text-[11px] sm:text-xs font-semibold text-slate-800 flex items-center gap-2 z-30 transition-transform hover:-translate-y-0.5">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>Erkend Financieel Adviseur</span>
          </div>

          <!-- Floating Action Button (Bottom Right, remains level/horizontal) -->
          <button 
            class="open-contact-drawer absolute bottom-4 sm:bottom-8 right-2 sm:right-6 w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-slate-900 hover:bg-brand-dark text-white flex items-center justify-center shadow-xl border-2 border-white backdrop-blur-md hover:scale-110 transition-transform duration-300 cursor-pointer z-30 group/btn"
            aria-label="Plan afspraak"
            title="Plan gratis adviesgesprek"
          >
            <span class="text-base sm:text-lg group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5 transition-transform">
              ↗
            </span>
          </button>

        </div>

      </div>

    </div>
  </div>
</section>
