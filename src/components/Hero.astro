            style="clip-path: url(#spekadvies-clover-exact); -webkit-clip-path: url(#spekadvies-clover-exact);"
          >
            <video 
              id="hero-video-mobile"
              autoplay 
              loop 
              muted 
              playsinline 
              preload="metadata"
              data-src="/videos/hero-video.mp4"
              class="w-full h-full object-cover pointer-events-none"
              style="transform: rotate(-19deg) scale(1.20); transform-origin: center center; object-position: center 38%;"
            ></video>
            <div class="absolute inset-0 bg-[#153b68]/12 pointer-events-none"></div>
          </div>
        </div>

        <svg 
          class="absolute z-30 text-[#ffce76] drop-shadow-md" 
          style="width: 15%; right: 6%; top: 46%; aspect-ratio: 80.08 / 83.08; transform: rotate(-25deg);"
          viewBox="0 0 80.08 83.08" 
          fill="currentColor"
        >
          <path d="M80.08,43.04c0,10.89-8.87,19.76-19.76,19.76-.18,0-.35-.01-.53-.02,0,.18.01.36.01.53,0,10.9-8.87,19.77-19.76,19.77s-19.76-8.87-19.76-19.77c0-.17,0-.35.01-.53-.18,0-.36.02-.53.02C8.86,62.8,0,53.93,0,43.04s8.86-19.76,19.76-19.76c.17,0,.35,0,.53,0-.01-.18-.01-.36-.01-.53,0-8.09,10.4-17.07,16.61-21.71,1.88-1.4,4.41-1.4,6.3,0,6.2,4.64,16.61,13.62,16.61,21.71,0,.17-.01.35-.01.53.18,0,.35,0,.53,0,10.89,0,19.76,8.86,19.76,19.76Z"/>
        </svg>
      </div>

    </div>
  </div>
</section>

<style>
  @keyframes partnerMarquee {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  .partner-marquee-track {
    animation: partnerMarquee 26s linear infinite;
    will-change: transform;
  }

  .partner-marquee-track:hover {
    animation-play-state: paused;
  }
</style>

<script>
  function setupHeroVideoAndGlow() {
    // 1. Only load & decode the single visible video (desktop vs mobile)
    const isDesktop = window.matchMedia('(min-width: 1024px)').matches;
    const activeVideo = document.getElementById(
      isDesktop ? 'hero-video-desktop' : 'hero-video-mobile'
    ) as HTMLVideoElement | null;

    if (activeVideo && !activeVideo.src) {
      const videoSrc = activeVideo.getAttribute('data-src');
      if (videoSrc) {
        activeVideo.src = videoSrc;
        activeVideo.play().catch(() => {});
      }
    }

    // 2. On-demand Mouse-Following Glow (0% CPU/GPU when mouse is stationary)
    const hero = document.getElementById('hero-section');
    const glow = document.getElementById('hero-mouse-glow');
    if (!hero || !glow) return;

    let rafId: number | null = null;
    let targetX = 0;
    let targetY = 0;
    let currentX = 0;
    let currentY = 0;
    let isInside = false;

    const updateGlow = () => {
      const dx = targetX - currentX;
      const dy = targetY - currentY;

      if (Math.abs(dx) > 0.25 || Math.abs(dy) > 0.25) {
        currentX += dx * 0.16;
        currentY += dy * 0.16;
        glow.style.setProperty('--mouse-x', `${currentX.toFixed(1)}px`);
        glow.style.setProperty('--mouse-y', `${currentY.toFixed(1)}px`);
        rafId = requestAnimationFrame(updateGlow);
      } else {
        rafId = null;
      }
    };

    const onMouseMove = (e: MouseEvent) => {
      const rect = hero.getBoundingClientRect();
      const inRange = e.clientY >= rect.top - 450 && e.clientY <= rect.bottom + 450;

      if (inRange) {
        targetX = e.clientX - rect.left;
        targetY = e.clientY - rect.top;

        if (!isInside) {
          isInside = true;
          currentX = targetX;
          currentY = targetY;
          glow.style.setProperty('--mouse-x', `${currentX.toFixed(1)}px`);
          glow.style.setProperty('--mouse-y', `${currentY.toFixed(1)}px`);
          glow.classList.remove('opacity-0');
          glow.classList.add('opacity-100');
        }

        if (!rafId) {
          rafId = requestAnimationFrame(updateGlow);
        }
      } else if (isInside) {
        isInside = false;
        glow.classList.remove('opacity-100');
        glow.classList.add('opacity-0');
        if (rafId) {
          cancelAnimationFrame(rafId);
          rafId = null;
        }
      }
    };

    window.addEventListener('mousemove', onMouseMove, { passive: true });
  }

  setupHeroVideoAndGlow();
  document.addEventListener('astro:page-load', setupHeroVideoAndGlow);
</script>
