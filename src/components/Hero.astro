        <div class="mt-8 sm:mt-10 lg:mt-12 pt-5 sm:pt-6 border-t border-slate-200/80 max-w-lg">
          <div class="flex items-center justify-between mb-3.5">
            <span class="text-[10px] font-semibold tracking-widest uppercase text-slate-400 font-sans">
              Onafhankelijke vergelijking van 40+ geldverstrekkers
            </span>
          </div>

          <!-- Smooth Infinite Scrolling Track with Spekadvies Blue & Gold/Orange Accents -->
          <div 
