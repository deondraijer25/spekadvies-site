---
import SectionDivider from './SectionDivider.astro';

const reviews = [
  {
    name: "Mark & Chantal",
    initials: "MC",
    city: "Moerkapelle",
    service: "Startershypotheek",
    quote: "Geweldige service! Martin nam alle tijd om onze eerste hypotheek en starterslening stap voor stap uit te leggen. Binnen no-time was alles rond."
  },
  {
    name: "Hanneke S.",
    initials: "HS",
    city: "Zoetermeer",
    service: "Hypotheek Oversluiten",
    quote: "Spekadvies heeft onze bestaande hypotheek overgesloten en onze overwaarde benut voor verduurzaming. Scheelt ons maandelijks flink in de lasten!"
  },
  {
    name: "Daan Vermeulen",
    initials: "DV",
    city: "Zevenhuizen",
    service: "AOV & Zakelijk",
    quote: "Als ZZP'er ontzettend goed geholpen met zowel mijn zakelijke verzekeringen als mijn AOV. Helder verhaal zonder kleine lettertjes."
  },
  {
    name: "Fam. De Graaf",
    initials: "FG",
    city: "Waddinxveen",
    service: "Woonverzekeringen",
    quote: "Al onze schade- en woonverzekeringen hier in één overzichtelijk pakket ondergebracht. Scherpe premie en altijd direct persoonlijk contact."
  },
  {
    name: "Jeroen & Sanne",
    initials: "JS",
    city: "Gouda",
    service: "Belastingaangifte",
    quote: "Na de aankoop van onze nieuwe woning heeft Spekadvies onze belastingaangifte en voorlopige aanslag verzorgd. Geen enkele aftrekpost gemist!"
  },
  {
    name: "Peter van Dijk",
    initials: "PD",
    city: "Bleiswijk",
    service: "Vermogen & Pensioen",
    quote: "Eindelijk volledig overzicht in mijn pensioenopbouw en vermogen voor later. Rustig, onafhankelijk en deskundig advies aan de keukentafel."
  }
];
---
<section class="py-20 lg:py-28 relative overflow-hidden bg-[#eef2f6]">
  
  <!-- Header & Score Summary (Aligned to 1280px grid) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-8 lg:px-12 relative z-10 mb-12 sm:mb-14">
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-8">
      
      <!-- Left: Section Heading -->
      <div class="space-y-2.5 max-w-2xl">
        <h2 class="ty-h2 text-brand-dark">
          Wat klanten over Spekadvies zeggen
        </h2>
        <p class="ty-lead text-slate-600">
          Financiële rust begint met persoonlijk en onafhankelijk advies. Ontdek hoe wij klanten in Moerkapelle en de regio dagelijks helpen.
        </p>
      </div>

      <!-- Right: Rating Summary Badge -->
      <div class="flex items-center gap-5 bg-white border border-slate-200/90 px-6 py-4 rounded-2xl shadow-sm shrink-0 self-start lg:self-auto">
        <div class="ty-stat text-brand-dark flex items-baseline">
          <span>4.9</span>
          <span class="text-slate-400 text-base font-semibold ml-0.5">/5</span>
        </div>
        <div class="h-10 w-px bg-slate-200"></div>
        <div>
          <div class="flex items-center gap-1.5">
            <span class="text-amber-400 text-sm tracking-tight">★★★★★</span>
            <span class="ty-small font-semibold text-brand-dark">Uitstekend</span>
          </div>
          <div class="ty-small text-slate-500 mt-0.5">Gebaseerd op 250+ klantbeoordelingen</div>
        </div>
      </div>

    </div>
  </div>

  <!-- Horizontal Infinite Moving Review Marquee -->
  <div 
    class="reviews-marquee-viewport relative w-full overflow-hidden py-3 select-none z-10"
    style="-webkit-mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent); mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);"
  >
    <div id="reviews-marquee-track" class="reviews-marquee-track flex items-stretch gap-6 w-max">
      {[0, 1].map(() => (
        <div class="reviews-marquee-group flex items-stretch gap-6 shrink-0 pr-6">
          {reviews.map((rev) => (
            <article class="review-card w-[320px] sm:w-[380px] bg-white border border-slate-200/90 hover:border-brand-dark/30 rounded-3xl p-6 sm:p-7 shadow-[0_8px_30px_rgba(21,59,104,0.05)] hover:shadow-[0_14px_36px_rgba(21,59,104,0.10)] transition-shadow duration-300 flex flex-col justify-between shrink-0">
              
              <div>
                <!-- Top Row: 5 Stars + Service Pill -->
                <div class="flex items-center justify-between gap-2 mb-4">
                  <div class="text-amber-400 text-sm tracking-tight" aria-label="5 van 5 sterren">★★★★★</div>
                  <span class="ty-small font-semibold px-3 py-1 rounded-full bg-[#ffce76]/35 border border-[#ffce76] text-brand-dark">
                    {rev.service}
                  </span>
                </div>

                <!-- Quote Text -->
                <p class="ty-body text-slate-600 mb-6">
                  "{rev.quote}"
                </p>
              </div>

              <!-- Reviewer Footer -->
              <div class="pt-4 border-t border-slate-100 flex items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                  <div class="w-9 h-9 rounded-full bg-brand-dark text-[#ffce76] ty-small font-semibold flex items-center justify-center shrink-0">
                    {rev.initials}
                  </div>
                  <div>
                    <div class="ty-h4 text-brand-dark leading-tight">{rev.name}</div>
                    <div class="ty-small text-slate-500">{rev.city}</div>
                  </div>
                </div>
                <span class="ty-small text-emerald-700 font-semibold flex items-center gap-1">
                  <i class="fa-solid fa-circle-check text-[11px]"></i>
                  <span>Geverifieerd</span>
                </span>
              </div>

            </article>
          ))}
        </div>
      ))}
    </div>
  </div>

  <!-- Stats Counters Row -->
  <div class="max-w-7xl mx-auto px-4 sm:px-8 lg:px-12 relative z-10">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-8 mt-12 sm:mt-14 pt-8 sm:pt-10 border-t border-slate-200/70">
      <div class="text-center space-y-1 p-2">
        <div class="ty-stat text-brand-dark">750+</div>
        <div class="ty-small text-slate-500">Gezinnen geholpen</div>
      </div>
      <div class="text-center space-y-1 p-2">
        <div class="ty-stat text-brand-dark">1.200+</div>
        <div class="ty-small text-slate-500">Succesvolle dossiers</div>
      </div>
      <div class="text-center space-y-1 p-2">
        <div class="ty-stat text-brand-dark">20+</div>
        <div class="ty-small text-slate-500">Jaar ervaring</div>
      </div>
      <div class="text-center space-y-1 p-2">
        <div class="ty-stat text-brand-dark">98%</div>
        <div class="ty-small text-slate-500">Tevreden klanten</div>
      </div>
    </div>
  </div>

  <SectionDivider fillColor="#ffffff" direction="left-high" />
</section>

<script is:inline>
  (function() {
    function initReviewsMarquee() {
      const tracks = document.querySelectorAll('.reviews-marquee-track');
      tracks.forEach((track) => {
        if (track.dataset.marqueeInitialized === 'true') return;
        track.dataset.marqueeInitialized = 'true';

        const firstGroup = track.querySelector('.reviews-marquee-group');
        if (!firstGroup) return;

        let offset = 0;
        let isHovered = false;
        let lastTime = performance.now();
        const normalSpeed = 60; // Smooth, clearly visible horizontal movement (px/sec)
        const hoverSpeed = 22;  // Gentle slow-down on hover so it never looks frozen

        track.querySelectorAll('.review-card').forEach((card) => {
          card.addEventListener('mouseenter', () => { isHovered = true; });
          card.addEventListener('mouseleave', () => { isHovered = false; });
        });

        function step(now) {
          const dt = Math.min((now - lastTime) / 1000, 0.1);
          lastTime = now;

          const singleWidth = firstGroup.offsetWidth;
          if (singleWidth > 0) {
            const currentSpeed = isHovered ? hoverSpeed : normalSpeed;
            offset -= currentSpeed * dt;
            if (Math.abs(offset) >= singleWidth) {
              offset += singleWidth;
            }
            track.style.transform = `translate3d(${offset.toFixed(2)}px, 0, 0)`;
          }
          requestAnimationFrame(step);
        }

        requestAnimationFrame(step);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initReviewsMarquee);
    } else {
      initReviewsMarquee();
    }
    document.addEventListener('astro:page-load', initReviewsMarquee);
  })();
</script>
