---
const pathname = Astro.url.pathname;
const segments = pathname.split('/').filter(Boolean);

// Build breadcrumb items
const items = [
  { name: 'Home', url: '/' }
];

let currentPath = '';
segments.forEach((segment, idx) => {
  currentPath += `/${segment}`;
  
  let name = segment;
  // Humanize names
  if (segment === 'hypotheken') name = 'Hypotheken';
  else if (segment === 'verzekeringen') name = 'Verzekeringen';
  else if (segment === 'aangiften') name = 'Belastingaangifte';
  else if (segment === 'over-ons') name = 'Over ons';
  else if (segment === 'klantenservice') name = 'Klantenservice';
  else if (segment === 'diensten') name = 'Diensten';
  else if (segment === 'hypotheekadviseur-in') name = 'Locaties';
  else {
    // For dynamic pages (startershypotheek, moerkapelle, etc.)
    name = segment
      .replace(/-/g, ' ')
      .replace(/\b\w/g, c => c.toUpperCase());
    
    // Custom mappings
    if (name.toLowerCase() === 'aov verzekering') name = 'AOV Verzekering';
    else if (name.toLowerCase() === 'startershypotheek') name = 'Startershypotheek';
    else if (name.toLowerCase() === 'hypotheek oversluiten') name = 'Hypotheek Oversluiten';
  }

  items.push({
    name,
    url: currentPath
  });
});

// JSON-LD Breadcrumb Schema for expert SEO
const schema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": items.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": item.name,
    "item": new URL(item.url, Astro.url.origin).href
  }))
};
---

<div class="w-full bg-slate-50 border-b border-slate-100 relative z-30">
  <nav aria-label="Breadcrumb" class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 py-3">
    <ol class="flex items-center space-x-2 text-[10px] font-bold uppercase tracking-widest font-sans">
      {items.map((item, idx) => {
        const isLast = idx === items.length - 1;
        return (
          <li class="flex items-center space-x-2">
            {idx > 0 && <span class="text-[8px] text-slate-350">/</span>}
            {isLast ? (
              <span class="text-brand-dark font-bold" aria-current="page">{item.name}</span>
            ) : (
              <a href={item.url} class="text-slate-400 hover:text-brand-accent transition-colors">
                {item.name}
              </a>
            )}
          </li>
        );
      })}
    </ol>
  </nav>
</div>

<!-- Insert breadcrumb JSON-LD schema for search engines -->
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
