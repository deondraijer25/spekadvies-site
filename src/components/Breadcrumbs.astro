---
const pathname = Astro.url.pathname;
const segments = pathname.split('/').filter(Boolean);

// Build breadcrumb items
const items = [
  { name: 'Home', url: '/' }
];

let currentPath = '';
segments.forEach((segment) => {
  currentPath += `/${segment}`;
  
  let name = segment;
  let itemUrl = `${currentPath}/`;

  // Humanize names
  if (segment === 'hypotheken') name = 'Hypotheken';
  else if (segment === 'verzekeringen') name = 'Verzekeringen';
  else if (segment === 'aangiften') name = 'Belastingaangifte';
  else if (segment === 'over-ons') name = 'Over ons';
  else if (segment === 'klantenservice') name = 'Klantenservice';
  else if (segment === 'diensten') {
    name = 'Diensten';
    itemUrl = '/diensten/';
  }
  else if (segment === 'hypotheekadviseur-in') {
    name = 'Locaties';
    itemUrl = '/locaties/';
  }
  else if (segment === 'locaties') name = 'Locaties';
  else if (segment === 'kennisbank') name = 'Kennisbank';
  else if (segment === 'privacybeleid') name = 'Privacybeleid';
  else if (segment === 'algemene-voorwaarden') name = 'Algemene Voorwaarden';
  else if (segment === 'adviesgesprek') name = 'Adviesgesprek';
  else {
    // For dynamic pages (startershypotheek, moerkapelle, etc.)
    name = segment
      .replace(/-/g, ' ')
      .replace(/\b\w/g, c => c.toUpperCase());
    
    // Custom mappings
    if (segment === 'nieuwerkerk-ad-ijssel') name = 'Nieuwerkerk a/d IJssel';
    else if (segment === 'aov-zzp-verzekering') name = 'AOV Verzekering';
    else if (segment === 'startershypotheek') name = 'Startershypotheek';
    else if (segment === 'hypotheek-oversluiten') name = 'Hypotheek Oversluiten';
    else if (segment === 'doorstromers-overbrugging') name = 'Doorstromers & Overbrugging';
    else if (segment === 'hypotheek-bij-scheiding') name = 'Hypotheek bij Scheiding';
    else if (segment === 'zzp-ondernemers-hypotheek') name = 'ZZP Hypotheek';
  }

  items.push({
    name,
    url: itemUrl
  });
});

// JSON-LD Breadcrumb Schema for expert SEO
const siteOrigin = Astro.site ? Astro.site.origin : (Astro.url ? Astro.url.origin : 'https://www.spekadvies.nl');
const schema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": items.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": item.name,
    "item": new URL(item.url, siteOrigin).href
  }))
};
---

<div class="w-full bg-slate-50 border-b border-slate-100 relative z-30">
  <nav aria-label="Breadcrumb" class="max-w-7xl mx-auto px-4 sm:px-8 lg:px-12 py-2.5 sm:py-3">
    <ol class="flex items-center space-x-2 text-[10px] font-semibold uppercase tracking-widest font-sans overflow-x-auto whitespace-nowrap hide-scrollbar flex-nowrap">
      {items.map((item, idx) => {
        const isLast = idx === items.length - 1;
        return (
          <li class="flex items-center space-x-2 flex-shrink-0">
            {idx > 0 && <span class="text-[8px] text-slate-400">/</span>}
            {isLast ? (
              <span class="text-brand-dark font-semibold" aria-current="page">{item.name}</span>
            ) : (
              <a href={item.url} class="text-slate-400 hover:text-brand-accent transition-colors">
                {item.name}
              </a>
            )}
          </li>
        );
      })}
    </ol>
  </nav>
</div>

<!-- Insert breadcrumb JSON-LD schema for search engines -->
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
