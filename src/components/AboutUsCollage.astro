---
import SectionDivider from './SectionDivider.astro';
---

<section id="over-ons" class="py-20 lg:py-28 relative overflow-hidden bg-white scroll-mt-20">
  
  <!-- Subtle decorative shapes in the background -->
  <div class="absolute left-0 bottom-0 w-[450px] h-[450px] rounded-full bg-brand-primary/5 blur-[120px] pointer-events-none"></div>

  <!-- Subtle large filled logo watermark (Option A - Variant 2) -->
  <div class="absolute right-[-10%] top-[10%] w-[380px] sm:w-[480px] h-auto pointer-events-none select-none z-0 animate-pulse" style="color: rgba(21, 59, 104, 0.05); animation-duration: 14s;">
    <svg viewBox="0 0 80.08 83.08" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
      <path d="M80.08,43.04c0,10.89-8.87,19.76-19.76,19.76-.18,0-.35-.01-.53-.02,0,.18.01.36.01.53,0,10.9-8.87,19.77-19.76,19.77s-19.76-8.87-19.76-19.77c0-.17,0-.35.01-.53-.18,0-.36.02-.53.02C8.86,62.8,0,53.93,0,43.04s8.86-19.76,19.76-19.76c.17,0,.35,0,.53,0-.01-.18-.01-.36-.01-.53,0-8.09,10.4-17.07,16.61-21.71,1.88-1.4,4.41-1.4,6.3,0,6.2,4.64,16.61,13.62,16.61,21.71,0,.17-.01.35-.01.53.18,0,.35,0,.53,0,10.89,0,19.76,8.86,19.76,19.76Z"/>
    </svg>
  </div>

  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
      
      <!-- Left Column: Overlapping Image Collage -->
      <div class="lg:col-span-6 relative">
        <div class="relative max-w-[500px] mx-auto lg:mx-0">
          
          <!-- Main Large Image (image-1.jpg) -->
          <div class="rounded-3xl overflow-hidden border border-slate-200/50 shadow-2xl relative z-10 w-[85%] aspect-[4/5]">
            <img 
              src="/insonis template/insonis-themer/elementor/assets/images/image-1.jpg" 
              alt="Spekadvies Kantoor" 
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>

          <!-- Secondary Smaller Overlapping Image (image-2.jpg) -->
          <div class="absolute right-0 bottom-6 sm:bottom-10 w-[45%] aspect-square rounded-2xl sm:rounded-3xl overflow-hidden border-4 sm:border-8 border-white shadow-[0_20px_40px_rgba(0,0,0,0.15)] z-20">
            <img 
              src="/insonis template/insonis-themer/elementor/assets/images/image-2.jpg" 
              alt="Financieel Advies" 
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>



        </div>
      </div>

      <!-- Right Column: Content & Bullet Points -->
      <div class="lg:col-span-6 space-y-7 text-left">
        <div class="space-y-2.5">
          <h2 class="ty-h2 text-brand-dark">
            Het beste advies & begeleiding voor jouw financiën
          </h2>
          <p class="ty-lead text-slate-600">
            Een hypotheek of verzekering moet passen bij jouw manier van leven. Onze onafhankelijke aanpak zorgt ervoor dat we meer dan 40 geldverstrekkers vergelijken om voor jou de scherpste deal en beste voorwaarden te vinden.
          </p>
        </div>

        <!-- Bullet List -->
        <div class="space-y-5 pt-1">
          
          <!-- Bullet 1 -->
          <div class="flex items-start space-x-4">
            <div class="w-11 h-11 rounded-2xl bg-amber-50 border border-amber-200/70 flex items-center justify-center flex-shrink-0 shadow-xs text-amber-800">
              <i class="fa-solid fa-chart-line text-base"></i>
            </div>
            <div class="space-y-1">
              <h4 class="ty-h4 text-brand-dark">
                Eenvoudige financiële planning
              </h4>
              <p class="ty-body text-slate-600">
                Wij vertalen ingewikkelde wet- en regelgeving naar heldere keuzes en duidelijke rekensommen die je begrijpt.
              </p>
            </div>
          </div>

          <!-- Bullet 2 -->
          <div class="flex items-start space-x-4">
            <div class="w-11 h-11 rounded-2xl bg-amber-50 border border-amber-200/70 flex items-center justify-center flex-shrink-0 shadow-xs text-amber-800">
              <i class="fa-solid fa-scale-balanced text-base"></i>
            </div>
            <div class="space-y-1">
              <h4 class="ty-h4 text-brand-dark">
                Vergelijk alle aanbieders
              </h4>
              <p class="ty-body text-slate-600">
                Doordat we onafhankelijk zijn, kijken we naar de gehele markt en staan we 100% aan jouw kant, niet aan die van de bank.
              </p>
            </div>
          </div>

        </div>

        <!-- CTA Button (Unified 15px Primary Button) -->
        <div class="pt-2">
          <a 
            href="/adviesgesprek"
            class="open-contact-drawer btn-primary group inline-flex items-center justify-center gap-3.5 px-7 py-3.5 rounded-full bg-brand-dark hover:bg-slate-900 text-white shadow-lg shadow-brand-dark/15 hover:shadow-xl hover:-translate-y-0.5 transition-all duration-300 cursor-pointer"
          >
            <span>Plan een afspraak</span>
            <span class="w-7 h-7 rounded-full bg-white/15 group-hover:bg-[#ffce76] group-hover:text-brand-dark flex items-center justify-center transition-all duration-300 shrink-0">
              <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M3 8H13M13 8L8.5 3.5M13 8L8.5 12.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
        </div>
      </div>

    </div>
  </div>

  <!-- Branded Stepped Divider to ServicesGrid (#f8fafc) -->
  <SectionDivider fillColor="#f8fafc" direction="left-high" />
</section>

<style>
  @keyframes bounce-slow {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }
  .animate-bounce-slow {
    animation: bounce-slow 4s ease-in-out infinite;
  }
</style>
