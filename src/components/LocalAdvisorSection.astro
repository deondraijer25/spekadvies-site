---
import SectionDivider from './SectionDivider.astro';
---

<section id="lokale-adviseur" class="py-20 lg:py-28 relative overflow-hidden bg-white scroll-mt-20">
  
  <!-- Subtle decorative shape in the background -->
  <div class="absolute right-0 bottom-0 w-[450px] h-[450px] rounded-full bg-brand-primary/5 blur-[120px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
      
      <!-- Left Column: Text Block -->
      <div class="lg:col-span-6 space-y-7 order-2 lg:order-1 text-left">
        <div class="space-y-2.5">
          <h2 class="ty-h2 text-brand-dark">
            Persoonlijk & dichtbij, met de kracht van de hele markt
          </h2>
          <p class="ty-lead text-slate-600">
            Als jouw lokale adviseur in Moerkapelle ken ik de regio door en door. Ik spreek je taal, weet wat er speelt in de buurt en ben flexibel bereikbaar – ook in de avonduren. Tegelijkertijd profiteer je bij Spekadvies van de professionaliteit en vergelijkingskracht van een grote landelijke speler.
          </p>
        </div>

        <!-- Custom USP list -->
        <div class="space-y-5 pt-1">
          <!-- USP 1 -->
          <div class="flex items-start space-x-4">
            <div class="flex-shrink-0 w-11 h-11 rounded-2xl bg-amber-50 border border-amber-200/70 flex items-center justify-center text-amber-800 shadow-xs text-lg">
              <i class="fa-solid fa-shield-halved"></i>
            </div>
            <div class="space-y-1">
              <h4 class="ty-h4 text-brand-dark">Persoonlijk aanspreekpunt</h4>
              <p class="ty-body text-slate-600">
                Geen wachttijden of callcenters. Je hebt altijd direct contact met Martin van der Spek voor al je vragen.
              </p>
            </div>
          </div>

          <!-- USP 2 -->
          <div class="flex items-start space-x-4">
            <div class="flex-shrink-0 w-11 h-11 rounded-2xl bg-amber-50 border border-amber-200/70 flex items-center justify-center text-amber-800 shadow-xs text-lg">
              <i class="fa-solid fa-scale-balanced"></i>
            </div>
            <div class="space-y-1">
              <h4 class="ty-h4 text-brand-dark">Landelijke vergelijkingskracht</h4>
              <p class="ty-body text-slate-600">
                Wij vergelijken meer dan 40 aanbieders op rente en voorwaarden. Zo garanderen we de beste deal van Nederland.
              </p>
            </div>
          </div>
        </div>

        <div class="pt-2">
          <a href="/adviesgesprek" class="open-contact-drawer btn-primary group inline-flex items-center justify-center gap-3.5 px-7 py-3.5 rounded-full bg-brand-dark hover:bg-slate-900 text-white shadow-lg shadow-brand-dark/15 hover:shadow-xl hover:-translate-y-0.5 transition-all duration-300 cursor-pointer">
            <span>Plan een afspraak</span>
            <span class="w-7 h-7 rounded-full bg-white/15 group-hover:bg-[#ffce76] group-hover:text-brand-dark flex items-center justify-center transition-all duration-300 shrink-0">
              <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M3 8H13M13 8L8.5 3.5M13 8L8.5 12.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
        </div>
      </div>

      <!-- Right Column: Overlapping Image Collage (Mirrored) -->
      <div class="lg:col-span-6 relative order-1 lg:order-2">
        <div class="relative max-w-[500px] mx-auto lg:mr-0 lg:ml-auto">
          
          <!-- Main Large Image -->
          <div class="rounded-3xl overflow-hidden border border-slate-200/50 shadow-2xl relative z-10 w-[85%] ml-auto aspect-[4/5]">
            <img 
              src="https://images.unsplash.com/photo-1573497019940-1c28c88b4f3e?auto=format&fit=crop&w=600&q=80" 
              alt="Spekadvies Martin Adviesgesprek" 
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>

          <!-- Smaller Overlapping Image (Bottom-Left) -->
          <div class="absolute left-0 bottom-[-16px] sm:bottom-[-30px] w-[50%] aspect-square border-4 sm:border-8 border-white shadow-2xl rounded-2xl sm:rounded-3xl overflow-hidden z-20 animate-bounce-slow">
            <img 
              src="https://images.unsplash.com/photo-1582213782179-e0d53f98f2ca?auto=format&fit=crop&w=400&q=80" 
              alt="Lokale Adviseur Moerkapelle" 
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<style>
  @keyframes bounce-slow {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }
  .animate-bounce-slow {
    animation: bounce-slow 4s ease-in-out infinite;
  }
</style>
