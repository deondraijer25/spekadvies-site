<!-- Zero-overhead event delegation routing any .open-contact-drawer trigger to /adviesgesprek -->
<script is:inline>
  document.addEventListener('click', (e) => {
    const trigger = e.target && e.target.closest ? e.target.closest('.open-contact-drawer') : null;
    if (!trigger) return;

    if (trigger.tagName === 'A' && trigger.getAttribute('href') && trigger.getAttribute('href').startsWith('/adviesgesprek')) {
      return; // Native anchor navigation
    }

    e.preventDefault();
    const path = window.location.pathname.toLowerCase();
    let topic = (trigger.dataset && trigger.dataset.topic) || '';

    if (!topic) {
      if (path.includes('verzekering') || path.includes('aov') || path.includes('orv') || path.includes('woonverzekering')) {
        topic = 'verzekeringen';
      } else if (path.includes('aangifte') || path.includes('belasting')) {
        topic = 'belastingaangifte';
      } else if (path.includes('vermogen') || path.includes('pensioen')) {
        topic = 'vermogen';
      } else if (path.includes('hypotheek') || path.includes('starter') || path.includes('doorstromer') || path.includes('overwaarde') || path.includes('zzp') || path.includes('nieuwbouw') || path.includes('scheiding')) {
        topic = 'hypotheken';
      }
    }

    window.location.href = topic ? `/adviesgesprek?onderwerp=${encodeURIComponent(topic)}` : '/adviesgesprek';
  });
</script>
