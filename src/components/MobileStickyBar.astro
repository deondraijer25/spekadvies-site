---
import { COMPANY_DATA } from '../data/company';
---

<!-- Mobile Quick Sticky Action Bar (Optimized for Mobile Conversions & Thumb Reach) -->
<aside 
  class="md:hidden fixed bottom-0 inset-x-0 z-40 bg-white/95 backdrop-blur-md border-t border-slate-200/90 shadow-[0_-4px_25px_rgba(21,59,104,0.10)] px-3 py-2.5 pb-[max(0.625rem,env(safe-area-inset-bottom))]"
  aria-label="Snelle contactopties voor mobiel"
>
  <div class="max-w-md mx-auto flex items-center gap-2.5">
    
    <!-- 1. Direct Call Button -->
    <a 
      href={`tel:${COMPANY_DATA.contact.phoneRaw}`}
      class="flex-1 flex items-center justify-center gap-2 py-3 px-3 rounded-2xl bg-slate-100 hover:bg-slate-200 text-brand-dark font-bold text-xs font-sans transition-colors active:scale-95"
      aria-label="Bel direct met Martin van der Spek"
    >
      <span class="text-sm">📞</span>
      <span class="tracking-tight">079 593 1241</span>
    </a>

    <!-- 2. Plan Appointment Drawer Trigger -->
    <button 
      class="open-contact-drawer flex-[1.3] flex items-center justify-center gap-2 py-3 px-4 rounded-2xl bg-brand-primary hover:bg-brand-primary-hover text-brand-dark font-bold text-xs uppercase tracking-wider font-sans transition-all shadow-md active:scale-95 cursor-pointer"
      aria-label="Open contactformulier voor gratis adviesgesprek"
    >
      <span>Gratis Advies</span>
      <span class="text-sm leading-none">➔</span>
    </button>

  </div>
</aside>
