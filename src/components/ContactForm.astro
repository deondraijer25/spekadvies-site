---
import SectionDivider from './SectionDivider.astro';
---
<section id="contact" class="py-16 lg:py-24 relative scroll-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-8 lg:px-12">
    <div class="bg-brand-dark border border-white/10 rounded-[28px] sm:rounded-[36px] p-6 sm:p-10 lg:p-12 shadow-2xl relative overflow-hidden">
      
      <!-- Subtle Spekadvies Clover Watermark in Background -->
      <svg 
        class="pointer-events-none select-none absolute -right-12 -top-12 w-72 h-72 text-[#ffce76]/[0.06] rotate-12" 
        viewBox="0 0 80.08 83.08" 
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M80.08,43.04c0,10.89-8.87,19.76-19.76,19.76-.18,0-.35-.01-.53-.02,0,.18.01.36.01.53,0,10.9-8.87,19.77-19.76,19.77s-19.76-8.87-19.76-19.77c0-.17,0-.35.01-.53-.18,0-.36.02-.53.02C8.86,62.8,0,53.93,0,43.04s8.86-19.76,19.76-19.76c.17,0,.35,0,.53,0-.01-.18-.01-.36-.01-.53,0-8.09,10.4-17.07,16.61-21.71,1.88-1.4,4.41-1.4,6.3,0,6.2,4.64,16.61,13.62,16.61,21.71,0,.17-.01.35-.01.53.18,0,.35,0,.53,0,10.89,0,19.76,8.86,19.76,19.76Z"/>
      </svg>

      <!-- Top Row: Headline + Primary CTA Button -->
      <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-6 lg:gap-12 pb-8 sm:pb-10 border-b border-white/10">
        <div class="space-y-2.5 max-w-2xl">
          <h2 class="ty-h2 text-white">
            Klaar voor helder financieel inzicht?
          </h2>
          <p class="ty-lead text-slate-300">
            Beantwoord 4 korte vragen over jouw situatie en plan direct een gratis en vrijblijvende afspraak met Martin van der Spek — op kantoor in Moerkapelle, bij jou thuis of telefonisch.
          </p>
        </div>

        <div class="flex flex-col sm:items-start lg:items-end shrink-0 gap-2.5">
          <a 
            href="/adviesgesprek" 
            class="open-contact-drawer btn-primary-gold w-full sm:w-auto bg-brand-primary hover:bg-brand-primary-hover text-brand-dark py-4 px-8 rounded-full shadow-lg transition-all duration-300 hover:-translate-y-0.5 inline-flex items-center justify-center gap-3 cursor-pointer whitespace-nowrap"
          >
            <span>Plan een afspraak</span>
            <span class="w-7 h-7 rounded-full bg-brand-dark/10 flex items-center justify-center shrink-0">
              <i class="fa-solid fa-arrow-right text-xs"></i>
            </span>
          </a>
          <span class="ty-small text-slate-400 text-center sm:text-left lg:text-right">
            ✓ Binnen 1 minuut geregeld • 100% vrijblijvend
          </span>
        </div>
      </div>

      <!-- Bottom Row: Direct Contact Details (Phone, Email, Office Address) -->
      <div class="relative z-10 pt-7 sm:pt-8 grid grid-cols-1 md:grid-cols-3 gap-5 sm:gap-6">
        
        <!-- Telefoon -->
        <a href="tel:+31795931241" class="group flex items-center gap-4 p-3.5 rounded-2xl bg-white/[0.04] hover:bg-white/[0.08] border border-white/10 transition-colors">
          <div class="w-11 h-11 bg-[#ffce76]/15 border border-[#ffce76]/30 rounded-xl flex items-center justify-center shrink-0 text-[#ffce76] group-hover:bg-[#ffce76] group-hover:text-brand-dark transition-colors">
            <i class="fa-solid fa-phone text-sm"></i>
          </div>
          <div>
            <div class="ty-small text-slate-400 font-medium">Direct bellen</div>
            <div class="ty-h4 text-white group-hover:text-[#ffce76] transition-colors">079 593 1241</div>
          </div>
        </a>

        <!-- E-mailadres -->
        <a href="mailto:info@spekadvies.nl" class="group flex items-center gap-4 p-3.5 rounded-2xl bg-white/[0.04] hover:bg-white/[0.08] border border-white/10 transition-colors">
          <div class="w-11 h-11 bg-[#ffce76]/15 border border-[#ffce76]/30 rounded-xl flex items-center justify-center shrink-0 text-[#ffce76] group-hover:bg-[#ffce76] group-hover:text-brand-dark transition-colors">
            <i class="fa-solid fa-envelope text-sm"></i>
          </div>
          <div class="min-w-0">
            <div class="ty-small text-slate-400 font-medium">E-mailadres</div>
            <div class="ty-h4 text-white group-hover:text-[#ffce76] transition-colors truncate">info@spekadvies.nl</div>
          </div>
        </a>

        <!-- Kantooradres -->
        <div class="flex items-center gap-4 p-3.5 rounded-2xl bg-white/[0.04] border border-white/10">
          <div class="w-11 h-11 bg-[#ffce76]/15 border border-[#ffce76]/30 rounded-xl flex items-center justify-center shrink-0 text-[#ffce76]">
            <i class="fa-solid fa-location-dot text-sm"></i>
          </div>
          <div>
            <div class="ty-small text-slate-400 font-medium">Kantoor Moerkapelle</div>
            <div class="ty-h4 text-white">Herenweg 42, 2751 DB Moerkapelle</div>
          </div>
        </div>

      </div>

    </div>
  </div>
  <SectionDivider fillColor="#153b68" direction="left-high" />
</section>
