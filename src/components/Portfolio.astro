---
const categories = ["Alles", "Hypotheken", "Verzekeringen", "Pensioen"];

const cases = [
  {
    title: "Eerste Huis in Moerkapelle",
    category: "Hypotheken",
    desc: "Hoe we Daan & Sophie hielpen hun eerste woning aan te kopen met een SVn Starterslening.",
    tag: "Starters"
  },
  {
    title: "AOV voor ZZP'er in Zuidplas",
    category: "Verzekeringen",
    desc: "Optimale inkomensbescherming bij arbeidsongeschiktheid voor een zelfstandige timmerman.",
    tag: "AOV"
  },
  {
    title: "Hypotheek Oversluiten",
    category: "Hypotheken",
    desc: "Rente verlagen en €250,- netto per maand besparen voor een gezin in Zoetermeer.",
    tag: "Oversluiten"
  },
  {
    title: "Bedrijfsrisico Inventarisatie",
    category: "Verzekeringen",
    desc: "Zakelijke dekkingen en aansprakelijkheid op maat ingericht voor een groeiend MKB-bedrijf.",
    tag: "Zakelijk"
  },
  {
    title: "Familie Risicopakket",
    category: "Verzekeringen",
    desc: "Woon-, opstal- en overlijdensrisicoverzekeringen samengevoegd voor optimale premiekorting.",
    tag: "Particulier"
  },
  {
    title: "Ondernemerspensioen",
    category: "Pensioen",
    desc: "Lijfrente en fiscaal vriendelijke oudedagsvoorziening ingericht voor een lokale ondernemer.",
    tag: "Pensioen"
  }
];
---

<section id="cases" class="py-20 lg:py-28 relative scroll-mt-20">
  <div class="absolute left-1/4 top-1/4 w-[350px] h-[350px] rounded-full bg-brand-primary/5 blur-[120px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col lg:flex-row items-end justify-between gap-6 mb-16">
      <div class="max-w-xl space-y-4">
        <span class="text-brand-primary text-xs font-bold tracking-widest uppercase block font-display">Succesverhalen</span>
        <h2 class="text-3xl sm:text-5xl font-bold text-brand-dark tracking-tight font-display">
          Onze Recente Projecten
        </h2>
      </div>

      <!-- Filter Tabs Mockup (Insonis Style) -->
      <div class="flex flex-wrap gap-2 text-xs font-semibold tracking-widest uppercase font-sans bg-brand-basetint border border-slate-200/60 p-1.5 rounded-2xl">
        {categories.map((cat, idx) => (
          <button 
            class={`px-5 py-2.5 rounded-xl cursor-pointer transition-colors ${idx === 0 ? 'bg-brand-primary text-brand-dark' : 'text-slate-500 hover:text-brand-dark'}`}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>

    <!-- Cases Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {cases.map((c) => (
        <div class="bg-white border border-slate-200/80 rounded-3xl p-8 flex flex-col justify-between hover:border-brand-primary/30 transition-all duration-300 shadow-xl group hover:-translate-y-1">
          <div>
            <div class="flex justify-between items-center mb-6">
              <span class="bg-brand-basetint border border-slate-100 px-3 py-1 rounded-full text-[10px] font-bold text-slate-500 uppercase tracking-widest">
                {c.category}
              </span>
              <span class="text-brand-primary font-bold text-xs uppercase tracking-widest font-display">
                {c.tag}
              </span>
            </div>
            
            <h3 class="text-xl font-bold text-brand-dark mb-3 font-display group-hover:text-brand-primary transition-colors">
              {c.title}
            </h3>
            <p  class="text-slate-600 text-xs sm:text-sm leading-relaxed font-sans font-normal mb-6">
              {c.desc}
            </p>
          </div>

          <a 
            href="#contact" 
            class="text-brand-primary font-bold text-xs uppercase tracking-widest flex items-center hover:text-brand-dark transition-colors pt-4 border-t border-slate-150"
          >
            Bekijk Case <span class="ml-2 group-hover:translate-x-1 transition-transform">→</span>
          </a>
        </div>
      ))}
    </div>

  </div>
</section>
