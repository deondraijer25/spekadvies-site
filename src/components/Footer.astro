---
import { getCollection } from 'astro:content';

const locaties = await getCollection('locaties');
---

<footer class="bg-[#153b68] pt-16 pb-8 relative overflow-hidden text-slate-350">
  <!-- Subtle large outline clover logo watermark -->
  <div class="absolute right-[-5%] bottom-[-5%] w-[320px] sm:w-[420px] h-auto pointer-events-none select-none z-0 opacity-[0.06]" style="color: #ffce76;">
    <svg viewBox="0 0 80.08 83.08" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
      <path d="M40.04,83.08c-10.9,0-19.76-8.87-19.76-19.76,0-.17,0-.35.01-.53-.18,0-.36.01-.53.01C8.86,62.8,0,53.93,0,43.04s8.86-19.76,19.76-19.76c.17,0,.35,0,.53.01,0-.18-.01-.36-.01-.53,0-8.08,10.41-17.07,16.61-21.7,1.88-1.41,4.42-1.41,6.3,0,6.2,4.64,16.61,13.62,16.61,21.7,0,.17,0,.35-.01.53.18,0,.36-.01.53-.01,10.9,0,19.76,8.86,19.76,19.76s-8.86,19.76-19.76,19.76c-.17,0-.35,0-.53-.01,0,.18.01.36.01.53,0,10.9-8.86,19.76-19.76,19.76ZM21.62,61.45l-.07.74c-.04.38-.06.76-.06,1.13,0,10.23,8.32,18.55,18.55,18.55s18.55-8.32,18.55-18.55c0-.36-.02-.74-.06-1.13l-.07-.73.73.07c.38.04.76.06,1.13.06,10.23,0,18.55-8.32,18.55-18.55s-8.32-18.55-18.55-18.55c-.36,0-.74.02-1.13.06l-.73.07.07-.73c.04-.39.06-.77.06-1.13,0-7.84-11.28-17.11-16.12-20.73-1.45-1.08-3.4-1.08-4.84,0-4.85,3.62-16.12,12.89-16.12,20.73,0,.36.02.74.06,1.12l.07.73-.73-.07c-.39-.04-.77-.06-1.13-.06-10.23,0-18.55,8.32-18.55,18.55s8.32,18.55,18.55,18.55c.36,0,.74-.02,1.13-.06l.74-.07Z"/>
    </svg>
  </div>

  <!-- Soft lighting overlay -->
  <div class="absolute left-1/2 bottom-0 -translate-x-1/2 w-[600px] h-[300px] rounded-full bg-brand-primary/5 blur-[120px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 relative z-10">

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-12 pb-12 border-b border-white/5">
      
      <!-- Column 1: Brand & About (4 cols) -->
      <div class="lg:col-span-4 space-y-6">
        <a href="/" class="inline-block">
          <img 
            src="/Logo/Middel 9 wit.svg" 
            alt="Spekadvies Logo" 
            class="h-16 sm:h-20 w-auto object-contain"
          />
        </a>
        <p  class="text-slate-400 text-sm leading-relaxed max-w-sm font-sans font-normal">
          Spekadvies is jouw onafhankelijke en betrouwbare partner in hypotheken en verzekeringen. Wij ontzorgen particulieren en ondernemers in Moerkapelle en de wijde omgeving.
        </p>
        <div class="flex items-center space-x-3">
          <a href="#" class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 hover:bg-brand-accent hover:border-brand-accent hover:text-brand-dark flex items-center justify-center transition-all text-slate-400" aria-label="Facebook">
            <i class="fa-brands fa-facebook-f text-sm"></i>
          </a>
          <a href="#" class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 hover:bg-brand-accent hover:border-brand-accent hover:text-brand-dark flex items-center justify-center transition-all text-slate-400" aria-label="LinkedIn">
            <i class="fa-brands fa-linkedin-in text-sm"></i>
          </a>
          <a href="#" class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 hover:bg-brand-accent hover:border-brand-accent hover:text-brand-dark flex items-center justify-center transition-all text-slate-400" aria-label="Instagram">
            <i class="fa-brands fa-instagram text-sm"></i>
          </a>
        </div>
      </div>

      <!-- Column 2: Quick Links - Diensten (2 cols) -->
      <div class="lg:col-span-2 space-y-4">
        <h3 class="text-xs font-bold text-white uppercase tracking-wider font-sans">Diensten</h3>
        <ul class="space-y-2.5 text-slate-400 text-xs font-normal">
          <li>
            <a href="/hypotheken" class="hover:text-brand-accent transition-colors block">
              Hypotheken
            </a>
          </li>
          <li>
            <a href="/verzekeringen" class="hover:text-brand-accent transition-colors block">
              Verzekeringen
            </a>
          </li>
          <li>
            <a href="/aangiften" class="hover:text-brand-accent transition-colors block">
              Belastingaangifte
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Quick Links - Locaties (2 cols) -->
      <div class="lg:col-span-2 space-y-4">
        <h3 class="text-xs font-bold text-white uppercase tracking-wider font-sans">Regio</h3>
        <ul class="space-y-2.5 text-slate-400 text-xs font-normal">
          {locaties.slice(0, 3).map((l) => (
            <li>
              <a href={`/hypotheekadviseur-in/${l.id}`} class="hover:text-brand-accent transition-colors block">
                Hypotheek {l.data.name}
              </a>
            </li>
          ))}
          <li class="pt-1.5">
            <a href="/locaties" class="text-brand-accent hover:text-white transition-colors block font-semibold uppercase tracking-wider text-[10px] font-sans">
              Alle locaties ➔
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 4: Contact & Hours (4 cols) -->
      <div class="lg:col-span-4 space-y-6">
        <h3 class="text-xs font-bold text-white uppercase tracking-wider font-sans">Contact</h3>
        
        <div class="space-y-4">
          <div class="flex items-start space-x-3">
            <span class="text-brand-accent text-sm mt-0.5">📞</span>
            <div>
              <div class="text-[9px] text-slate-500 font-semibold uppercase tracking-wider font-sans">Klantenservice</div>
              <a href="tel:+31795931241" class="text-white hover:text-brand-accent font-normal text-sm transition-colors font-sans">079 593 1241</a>
            </div>
          </div>

          <div class="flex items-start space-x-3">
            <span class="text-brand-accent text-sm mt-0.5">🕒</span>
            <div>
              <div class="text-[9px] text-slate-500 font-semibold uppercase tracking-wider font-sans">Openingstijden</div>
              <p class="text-slate-300 text-xs font-normal font-sans">Ma - Vr: 9:00 uur tot 18:00 uur</p>
            </div>
          </div>

          <div class="flex items-start space-x-3">
            <span class="text-brand-accent text-sm mt-0.5">🛡️</span>
            <div>
              <div class="text-[9px] text-slate-500 font-semibold uppercase tracking-wider font-sans">Registraties</div>
              <p class="text-slate-300 text-xs font-normal font-sans">KvK: 29051405 | AFM: 12009127</p>
            </div>
          </div>
        </div>

        <!-- Newsletter form stub similar to Insonis -->
        <div class="pt-4 border-t border-white/5">
          <h4 class="text-xs font-bold text-white uppercase tracking-wider mb-3 font-sans">Nieuwsbrief</h4>
          <form class="flex gap-2">
            <input 
              type="email" 
              placeholder="Jouw e-mailadres" 
              class="bg-white/5 border border-white/10 rounded-xl px-4 py-2.5 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-brand-accent transition-colors flex-grow font-sans font-medium"
              required
            />
            <button 
              type="submit" 
              class="bg-brand-accent hover:bg-brand-accent/90 text-brand-dark font-semibold px-4 py-2.5 rounded-full text-xs tracking-wider uppercase transition-colors font-sans cursor-pointer"
            >
              ➔
            </button>
          </form>
        </div>
      </div>

    </div>

    <!-- Bottom copyrights and legal links -->
    <div class="pt-8 flex flex-col sm:flex-row justify-between items-center text-[10px] text-slate-500 font-bold uppercase tracking-widest gap-4 font-display">
      <p>© {new Date().getFullYear()} Spekadvies. Alle rechten voorbehouden.</p>
      <div class="flex space-x-6">
        <a href="#" class="hover:text-brand-accent transition-colors">Algemene Voorwaarden</a>
        <a href="#" class="hover:text-brand-accent transition-colors">Privacybeleid</a>
      </div>
    </div>
  </div>
</footer>
