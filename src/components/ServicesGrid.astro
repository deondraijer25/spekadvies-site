---
const services = [
  {
    id: 1,
    title: "Hypotheekadvies",
    desc: "Onafhankelijk advies voor starters, doorstromers en ondernemers. Wij vergelijken meer dan 40 geldverstrekkers.",
    image: "https://images.unsplash.com/photo-1560518883-ce09059eeffa?auto=format&fit=crop&w=600&q=80",
    link: "/hypotheken"
  },
  {
    id: 2,
    title: "Verzekeringen",
    desc: "Bescherm je gezin, bezit en inkomen met de beste dekkingen en onafhankelijke vergelijking.",
    image: "https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&w=600&q=80",
    link: "/verzekeringen"
  },
  {
    id: 3,
    title: "Belastingaangifte",
    desc: "Zorgeloos je aangifte inkomstenbelasting geregeld en optimaal profiteren van alle fiscale voordelen.",
    image: "https://images.unsplash.com/photo-1554224155-8d04cb21cd6c?auto=format&fit=crop&w=600&q=80",
    link: "/aangiften"
  },
  {
    id: 4,
    title: "Vermogensbeheer",
    desc: "Slim vermogen opbouwen voor je toekomst en risico's beheersen met professionele begeleiding.",
    image: "https://images.unsplash.com/photo-1590283603385-17ffb3a7f29f?auto=format&fit=crop&w=600&q=80",
    link: "/diensten/vermogensbeheer"
  }
];
import SectionDivider from './SectionDivider.astro';
---

<section id="diensten" class="py-24 relative bg-[#f8fafc] scroll-mt-20 overflow-hidden">
  
  <!-- Subtle decorative bg glow -->
  <div class="absolute left-1/4 top-1/4 w-[500px] h-[500px] rounded-full bg-brand-primary/5 blur-[120px] pointer-events-none"></div>

  <!-- Subtle large logo watermark -->
  <div class="absolute left-[5%] bottom-[10%] w-[380px] sm:w-[480px] h-auto pointer-events-none select-none z-0 opacity-[0.03]" style="color: #153b68;">
    <svg viewBox="0 0 80.08 83.08" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
      <path d="M40.04,83.08c-10.9,0-19.76-8.87-19.76-19.76,0-.17,0-.35.01-.53-.18,0-.36.01-.53.01C8.86,62.8,0,53.93,0,43.04s8.86-19.76,19.76-19.76c.17,0,.35,0,.53.01,0-.18-.01-.36-.01-.53,0-8.08,10.41-17.07,16.61-21.7,1.88-1.41,4.42-1.41,6.3,0,6.2,4.64,16.61,13.62,16.61,21.7,0,.17,0,.35-.01.53.18,0,.36-.01.53-.01,10.9,0,19.76,8.86,19.76,19.76s-8.86,19.76-19.76,19.76c-.17,0-.35,0-.53-.01,0,.18.01.36.01.53,0,10.9-8.86,19.76-19.76,19.76ZM21.62,61.45l-.07.74c-.04.38-.06.76-.06,1.13,0,10.23,8.32,18.55,18.55,18.55s18.55-8.32,18.55-18.55c0-.36-.02-.74-.06-1.13l-.07-.73.73.07c.38.04.76.06,1.13.06,10.23,0,18.55-8.32,18.55-18.55s-8.32-18.55-18.55-18.55c-.36,0-.74.02-1.13.06l-.73.07.07-.73c.04-.39.06-.77.06-1.13,0-7.84-11.28-17.11-16.12-20.73-1.45-1.08-3.4-1.08-4.84,0-4.85,3.62-16.12,12.89-16.12,20.73,0,.36.02.74.06,1.12l.07.73-.73-.07c-.39-.04-.77-.06-1.13-.06-10.23,0-18.55,8.32-18.55,18.55s8.32,18.55,18.55,18.55c.36,0,.74-.02,1.13-.06l.74-.07Z"/>
    </svg>
  </div>

  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Left Column: Section Header (Insonis Style but Clean) -->
      <div class="lg:col-span-5 space-y-6">
        <div class="flex items-center space-x-2 text-brand-accent text-xs font-bold tracking-widest uppercase font-sans">
          <!-- Blue Shield Icon -->
          <svg class="w-3.5 h-3.5 fill-brand-accent" viewBox="0 0 24 24">
            <path d="M12 2L3 5v6c0 5.5 3.8 10.7 9 12 5.2-1.3 9-6.5 9-12V5l-9-3z"/>
          </svg>
          <span>Onze Diensten</span>
        </div>
        
        <h2 class="text-3xl sm:text-4xl font-bold text-brand-dark tracking-tight font-display leading-tight">
          De beste diensten voor jou
        </h2>
        
        <p class="text-slate-650 text-sm sm:text-base font-sans font-normal leading-relaxed">
          Onafhankelijk en betrouwbaar advies dat aansluit op jouw situatie. Selecteer een dienst om direct de details te bekijken.
        </p>
        
        <div class="pt-2">
          <button class="open-contact-drawer bg-brand-dark hover:bg-brand-primary hover:text-brand-dark text-white font-semibold px-8 py-4 rounded-full text-xs tracking-wider uppercase font-sans transition-all duration-300 shadow-md cursor-pointer">
            Plan adviesgesprek
          </button>
        </div>
      </div>

      <!-- Right Column: 2x2 Grid of Clean Rounded Image Cards -->
      <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-6">
        {services.map((svc) => (
          <a 
            href={svc.link} 
            class="group relative h-64 sm:h-72 overflow-hidden rounded-[32px] border border-slate-200/50 shadow-md hover:shadow-xl transition-all duration-300 block"
          >
            <!-- Background Image -->
            <img 
              src={svc.image} 
              alt={svc.title} 
              class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 z-0" 
            />
            
            <!-- Dark Gradient Overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-brand-dark/95 via-brand-dark/50 to-transparent z-10 transition-opacity duration-300 group-hover:from-brand-dark/100 group-hover:via-brand-dark/65"></div>
            
            <!-- Text Content -->
            <div class="absolute bottom-0 left-0 right-0 p-8 z-20 space-y-2 flex flex-col justify-end h-full">
              <h3 class="text-lg sm:text-xl font-bold text-white leading-tight font-display transition-transform duration-300 group-hover:-translate-y-1">
                {svc.title}
              </h3>
              <p class="text-xs text-slate-300 font-sans font-normal leading-relaxed opacity-85 group-hover:opacity-100 transition-opacity duration-300 line-clamp-2">
                {svc.desc}
              </p>
              <div class="flex items-center text-[10px] font-bold tracking-widest text-brand-accent uppercase pt-2 transition-transform duration-300 group-hover:translate-x-1">
                <span>Lees meer</span>
                <span class="ml-1">➔</span>
              </div>
            </div>
          </a>
        ))}
      </div>

    </div>
  </div>
  <SectionDivider fillColor="#eef2f6" direction="left-low" />
</section>
