---
import { getCollection } from 'astro:content';

const locaties = await getCollection('locaties');
const diensten = await getCollection('diensten');

const pathname = Astro.url.pathname;
const cleanPath = pathname.replace(/\/$/, "");
---

<header class="w-full relative z-50 bg-white shadow-[0_4px_25px_rgba(21,59,104,0.08)]">
  <!-- Top Utility Bar (Notification Bar - Right Aligned Contact Info & Polish Link) -->
  <div class="w-full bg-brand-dark border-b border-white/5 relative z-50 hidden lg:block">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 py-2.5 flex justify-between items-center text-[11px] text-slate-300">
      <!-- Polish Expats Info Link -->
      <a 
        href="https://www.ubezpieczenieholandii.nl/" 
        target="_blank" 
        rel="noopener noreferrer"
        class="flex items-center space-x-2 text-slate-300 hover:text-brand-accent transition-colors font-sans group"
        title="Van der Spek & Partners - Ubezpieczenia w Holandii (ubezpieczeniaholandia.nl)"
      >
        <span class="w-4 h-2.5 rounded-[2px] overflow-hidden shadow-[0_0_0_1px_rgba(255,255,255,0.25)] shrink-0 inline-block">
          <svg viewBox="0 0 16 11" class="w-full h-full block" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="16" height="5.5" fill="#FFFFFF" />
            <rect y="5.5" width="16" height="5.5" fill="#DC143C" />
          </svg>
        </span>
        <span class="font-medium">Polski: Ubezpieczenia w Holandii (Van der Spek & Partners) ↗</span>
      </a>

      <!-- Contact Info (Right) -->
      <div class="flex items-center space-x-8 font-sans">
        <span class="flex items-center space-x-2">
          <span class="text-brand-accent">📍</span> <span class="font-medium text-slate-300">Herenweg 42, Moerkapelle</span>
        </span>
        <span class="flex items-center space-x-2">
          <span class="text-brand-accent">✉️</span> <a href="mailto:info@spekadvies.nl" class="hover:text-brand-accent transition-colors font-medium text-slate-300">info@spekadvies.nl</a>
        </span>
        <span class="flex items-center space-x-2">
          <span class="text-brand-accent">📞</span> <a href="tel:+31795931241" class="hover:text-brand-accent transition-colors font-medium text-slate-300">079 593 1241</a>
        </span>
      </div>
    </div>
  </div>

  <!-- Main Header Bar -->
  <div class="w-full h-[72px] sm:h-20 md:h-24 relative border-b border-slate-100/50">
    
    <!-- Background Divider (Stretches full bleed to screen edges behind the content on md+) -->
    <div class="absolute inset-0 w-full h-full -z-10 hidden md:flex pointer-events-none">
      <!-- White area (left) -->
      <div class="w-[75%] lg:w-[84%] bg-white h-full transition-all"></div>
      
      <!-- Slanted Curved Divider (SVG in Sky Blue/Gold - S-Curve going from bottom-left to top-right) -->
      <svg class="h-full w-24 text-brand-accent fill-current -ml-1 -mr-1" viewBox="0 0 100 100" preserveAspectRatio="none">
        <path d="M 100 0 L 100 100 L 0 100 C 40 100, 60 0, 100 0 Z" />
      </svg>
      
      <!-- Gold/Accent area (right) -->
      <div class="flex-grow bg-brand-accent h-full"></div>
    </div>

    <!-- Solid white background on mobile (< md) for maximum contrast and zero clipping -->
    <div class="absolute inset-0 w-full h-full -z-10 bg-white md:hidden"></div>

    <!-- Header Contents (Constrained to centered page grid) -->
    <div class="max-w-7xl mx-auto px-4 sm:px-8 lg:px-12 w-full h-full flex justify-between items-center relative z-20">
      
      <!-- Left Side: Logo (Always crisp & legible on White Background) -->
      <div class="flex items-center h-full min-w-0 pr-2">
        <a href="/" class="flex items-center">
          <img 
            src="/Logo/Middel 9.svg" 
            alt="Spekadvies Logo" 
            class="h-8 sm:h-10 md:h-[48px] lg:h-[58px] w-auto max-w-[170px] sm:max-w-[230px] md:max-w-none object-contain select-none"
          />
        </a>
      </div>

      <!-- Right Side Group: Menu Links & Action Button -->
      <div class="flex items-center h-full space-x-3 sm:space-x-6 xl:space-x-12 flex-shrink-0">
        <!-- Desktop Menu (Title Case, Sans-Serif Bold, matching Insonis) -->
        <nav class="hidden xl:flex items-center space-x-8 font-sans font-medium text-[14px] h-full">
          
          <!-- Hypotheken Dropdown -->
          <div class="relative group">
            <a href="/hypotheken" class={`hover:text-amber-700 flex items-center space-x-1.5 focus:outline-none py-2 cursor-pointer font-sans font-semibold text-[14px] transition-colors ${
              cleanPath.startsWith("/diensten/hypotheek") || cleanPath.startsWith("/diensten/starter") || cleanPath.startsWith("/diensten/doorstromers") || cleanPath.startsWith("/diensten/overwaarde") || cleanPath.startsWith("/diensten/zzp") || cleanPath.startsWith("/diensten/nieuwbouw") || cleanPath === "/hypotheken" ? "text-amber-800 font-bold" : "text-slate-700"
            }`}>
              <span>Hypotheken</span>
              <span class="text-[8px] group-hover:rotate-180 transition-transform duration-300">▼</span>
            </a>
            <div class="absolute left-0 mt-1 w-64 bg-white border border-slate-200/90 rounded-2xl p-3 shadow-2xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 transform translate-y-2 group-hover:translate-y-0 z-50">
              <div class="flex flex-col space-y-1">
                <a href="/diensten/startershypotheek" class="hover:text-brand-dark hover:bg-amber-50/60 px-3 py-2 rounded-xl transition-all text-xs font-semibold text-slate-700">Startershypotheek</a>
                <a href="/diensten/doorstromers-overbrugging" class="hover:text-brand-dark hover:bg-amber-50/60 px-3 py-2 rounded-xl transition-all text-xs font-semibold text-slate-700">Doorstromers & Overbrugging</a>
                <a href="/diensten/hypotheek-oversluiten" class="hover:text-brand-dark hover:bg-amber-50/60 px-3 py-2 rounded-xl transition-all text-xs font-semibold text-slate-700">Hypotheek Oversluiten</a>
                <a href="/diensten/overwaarde-verzilveren" class="hover:text-brand-dark hover:bg-amber-50/60 px-3 py-2 rounded-xl transition-all text-xs font-semibold text-slate-700">Overwaarde & Senioren</a>
                <a href="/diensten/zzp-ondernemers-hypotheek" class="hover:text-brand-dark hover:bg-amber-50/60 px-3 py-2 rounded-xl transition-all text-xs font-semibold text-slate-700">ZZP & Ondernemers</a>
                <a href="/diensten/nieuwbouw-hypotheek" class="hover:text-brand-dark hover:bg-amber-50/60 px-3 py-2 rounded-xl transition-all text-xs font-semibold text-slate-700">Nieuwbouw Hypotheek</a>
                <a href="/diensten/hypotheek-verduurzamen" class="hover:text-brand-dark hover:bg-amber-50/60 px-3 py-2 rounded-xl transition-all text-xs font-semibold text-slate-700">Hypotheek Verduurzamen</a>
                <a href="/diensten/hypotheek-bij-scheiding" class="hover:text-brand-dark hover:bg-amber-50/60 px-3 py-2 rounded-xl transition-all text-xs font-semibold text-slate-700">Hypotheek bij Scheiding</a>
                <div class="pt-1.5 border-t border-slate-100">
                  <a href="/hypotheken" class="text-amber-800 hover:text-brand-dark px-3 py-1.5 rounded-xl transition-all text-xs font-bold block">
                    Alle hypotheken bekijken ➔
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- Verzekeringen Dropdown -->
          <div class="relative group">
            <a href="/verzekeringen" class={`hover:text-amber-700 flex items-center space-x-1.5 focus:outline-none py-2 cursor-pointer font-sans font-semibold text-[14px] transition-colors ${
              cleanPath.startsWith("/diensten/aov") || cleanPath.startsWith("/diensten/woon") || cleanPath.startsWith("/diensten/overlijdens") || cleanPath.startsWith("/diensten/zakelijke") || cleanPath === "/verzekeringen" ? "text-amber-800 font-bold" : "text-slate-700"
            }`}>
              <span>Verzekeringen</span>
              <span class="text-[8px] group-hover:rotate-180 transition-transform duration-300">▼</span>
            </a>
            <div class="absolute left-0 mt-1 w-64 bg-white border border-slate-200/90 rounded-2xl p-3 shadow-2xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 transform translate-y-2 group-hover:translate-y-0 z-50">
              <div class="flex flex-col space-y-1">
                <a href="/diensten/aov-zzp-verzekering" class="hover:text-brand-dark hover:bg-amber-50/60 px-3 py-2 rounded-xl transition-all text-xs font-semibold text-slate-700">AOV voor Ondernemers</a>
                <a href="/diensten/woonverzekeringen" class="hover:text-brand-dark hover:bg-amber-50/60 px-3 py-2 rounded-xl transition-all text-xs font-semibold text-slate-700">Woonverzekeringen</a>
                <a href="/diensten/overlijdensrisicoverzekering" class="hover:text-brand-dark hover:bg-amber-50/60 px-3 py-2 rounded-xl transition-all text-xs font-semibold text-slate-700">Overlijdensrisico (ORV)</a>
                <a href="/diensten/zakelijke-verzekeringen" class="hover:text-brand-dark hover:bg-amber-50/60 px-3 py-2 rounded-xl transition-all text-xs font-semibold text-slate-700">Zakelijke Verzekeringen</a>
                <a href="/diensten/vermogensbeheer" class="hover:text-brand-dark hover:bg-amber-50/60 px-3 py-2 rounded-xl transition-all text-xs font-semibold text-slate-700">Vermogensbeheer & Pensioen</a>
                <div class="pt-1.5 border-t border-slate-100">
                  <a href="/verzekeringen" class="text-amber-800 hover:text-brand-dark px-3 py-1.5 rounded-xl transition-all text-xs font-bold block">
                    Alle verzekeringen bekijken ➔
                  </a>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Aangiften & Belastingen -->
          <a href="/aangiften" class={`hover:text-amber-700 transition-colors py-2 font-semibold ${cleanPath === "/aangiften" ? "text-amber-800 font-bold" : "text-slate-700"}`}>
            Belastingaangifte
          </a>

          <!-- Over ons -->
          <a href="/over-ons" class={`hover:text-amber-700 transition-colors py-2 font-semibold ${cleanPath === "/over-ons" ? "text-amber-800 font-bold" : "text-slate-700"}`}>
            Over ons
          </a>
          
          <!-- Contact Knop (Drawer trigger) -->
          <button class="open-contact-drawer hover:text-amber-700 transition-colors py-2 cursor-pointer font-sans font-semibold text-[14px] text-slate-700">
            Contact
          </button>
        </nav>

        <!-- Right Side: Phone & Action Buttons -->
        <div class="flex items-center gap-2 sm:gap-3.5 h-full">
          <!-- Mobile Quick Call Button (< sm screens) -->
          <a 
            href="tel:+31795931241" 
            class="sm:hidden w-9 h-9 rounded-xl bg-slate-100 hover:bg-brand-primary text-brand-dark flex items-center justify-center text-sm transition-colors" 
            aria-label="Bel Spekadvies"
          >
            <i class="fa-solid fa-phone"></i>
          </a>

          <!-- Polish Website Button with Flag -->
          <a 
            href="https://www.ubezpieczenieholandii.nl/" 
            target="_blank" 
            rel="noopener noreferrer"
            title="Van der Spek & Partners - Ubezpieczenia w Holandii (ubezpieczeniaholandia.nl)"
            aria-label="Polski - Ubezpieczenia w Holandii (Van der Spek & Partners)"
            class="h-9 w-9 sm:h-11 sm:w-auto px-0 sm:px-4 rounded-xl sm:rounded-full bg-white hover:bg-slate-50 text-brand-dark border border-slate-200/90 shadow-xs hover:shadow-md transition-all duration-300 flex items-center justify-center space-x-2 cursor-pointer flex-shrink-0 group"
          >
            <span class="w-5 h-3.5 rounded-[2px] overflow-hidden shadow-[0_0_0_1px_rgba(0,0,0,0.15)] shrink-0 inline-block">
              <svg viewBox="0 0 16 11" class="w-full h-full block" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="16" height="5.5" fill="#FFFFFF" />
                <rect y="5.5" width="16" height="5.5" fill="#DC143C" />
              </svg>
            </span>
            <span class="font-sans font-semibold text-xs text-brand-dark hidden sm:inline group-hover:text-brand-dark transition-colors">Polski</span>
          </a>

          <!-- Action Button (Visible on sm+) -->
          <button 
            class="open-contact-drawer hidden sm:flex bg-brand-primary hover:bg-brand-primary-hover text-brand-dark font-bold text-xs px-5 py-3 rounded-full uppercase tracking-wider transition-all duration-300 items-center justify-center space-x-1.5 font-sans shadow-[0_4px_16px_rgba(255,206,118,0.3)] hover:-translate-y-0.5 whitespace-nowrap flex-shrink-0 cursor-pointer"
          >
            <span>Plan Gesprek ➔</span>
          </button>

          <!-- Mobile Menu Trigger Button (Always visible on mobile/tablet) -->
          <button 
            id="mobile-menu-btn" 
            class="xl:hidden w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-slate-100 hover:bg-slate-200 text-brand-dark focus:outline-none flex items-center justify-center text-xl transition-colors cursor-pointer flex-shrink-0" 
            aria-label="Menu openen"
            aria-expanded="false"
          >
            <span id="mobile-menu-icon" class="leading-none">☰</span>
          </button>
        </div>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Backdrop Overlay -->
  <div id="mobile-menu-backdrop" class="hidden fixed inset-0 top-[72px] sm:top-[80px] md:top-[96px] bg-slate-900/50 backdrop-blur-xs z-35 transition-opacity"></div>

  <!-- Mobile Dropdown Menu (Scrollable & Responsive for Samsung S24 & Z Flip) -->
  <div 
    id="mobile-menu" 
    class="hidden fixed inset-x-0 top-[72px] sm:top-[80px] md:top-[96px] max-h-[calc(100dvh-72px)] sm:max-h-[calc(100dvh-80px)] overflow-y-auto bg-white border-b border-slate-200 p-5 sm:p-6 z-40 shadow-2xl transition-all"
  >
    <div class="flex flex-col space-y-4 text-xs font-semibold uppercase tracking-wider font-sans">
      
      <!-- Quick Contact Badges on Mobile -->
      <div class="flex items-center justify-between gap-2 p-3 bg-slate-50 rounded-2xl border border-slate-100 text-[11px] font-sans normal-case">
        <a href="tel:+31795931241" class="flex items-center space-x-2 text-brand-dark font-medium hover:text-brand-accent transition-colors">
          <span class="w-7 h-7 rounded-lg bg-white shadow-xs flex items-center justify-center text-xs">📞</span>
          <span>079 593 1241</span>
        </a>
        <a href="mailto:info@spekadvies.nl" class="flex items-center space-x-2 text-slate-500 font-medium hover:text-brand-accent transition-colors">
          <span class="w-7 h-7 rounded-lg bg-white shadow-xs flex items-center justify-center text-xs">✉️</span>
          <span>info@spekadvies.nl</span>
        </a>
      </div>

      <a href="/" class="text-brand-dark hover:text-brand-accent py-2 transition-colors flex items-center justify-between border-b border-slate-50">
        <span>Home</span>
        <span class="text-slate-400">➔</span>
      </a>

      <div>
        <span class="text-slate-400 text-[10px] tracking-widest block mb-2 font-display">Diensten</span>
        <div class="flex flex-col pl-3 space-y-2 border-l-2 border-brand-accent/30">
          <a href="/hypotheken" class="text-slate-700 hover:text-brand-dark py-1.5 transition-colors font-sans font-semibold text-sm">Hypotheken</a>
          <a href="/verzekeringen" class="text-slate-700 hover:text-brand-dark py-1.5 transition-colors font-sans font-semibold text-sm">Verzekeringen</a>
          <a href="/aangiften" class="text-slate-700 hover:text-brand-dark py-1.5 transition-colors font-sans font-semibold text-sm">Belastingaangifte</a>
          <a href="/diensten/vermogensbeheer" class="text-slate-700 hover:text-brand-dark py-1.5 transition-colors font-sans font-semibold text-sm">Vermogen</a>
        </div>
      </div>
      
      <div class="border-t border-slate-100 pt-3">
        <span class="text-slate-400 text-[10px] tracking-widest block mb-2 font-display">Over & Contact</span>
        <div class="flex flex-col pl-3 space-y-2 border-l-2 border-brand-dark/20">
          <a href="/over-ons" class="text-slate-700 hover:text-brand-dark py-1.5 transition-colors font-sans font-semibold text-sm">Over Spekadvies</a>
          <a href="/klantenservice" class="text-slate-700 hover:text-brand-dark py-1.5 transition-colors font-sans font-semibold text-sm">Klantenservice & Downloads</a>
        </div>
      </div>

      <!-- Polish Website Link in Mobile Menu -->
      <div class="border-t border-slate-100 pt-3">
        <a 
          href="https://www.ubezpieczenieholandii.nl/" 
          target="_blank" 
          rel="noopener noreferrer"
          class="flex items-center justify-between p-3.5 bg-slate-50 hover:bg-slate-100 rounded-2xl border border-slate-200/80 transition-colors group"
        >
          <div class="flex items-center space-x-3">
            <span class="w-6 h-4 rounded-[2px] overflow-hidden shadow-[0_0_0_1px_rgba(0,0,0,0.15)] shrink-0 inline-block">
              <svg viewBox="0 0 16 11" class="w-full h-full block" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="16" height="5.5" fill="#FFFFFF" />
                <rect y="5.5" width="16" height="5.5" fill="#DC143C" />
              </svg>
            </span>
            <div>
              <div class="font-sans font-semibold text-xs text-brand-dark normal-case">Ubezpieczenia w Holandii</div>
              <div class="font-sans text-[10px] text-slate-500 font-normal normal-case">Van der Spek & Partners (Polski)</div>
            </div>
          </div>
          <span class="text-slate-400 group-hover:text-brand-dark transition-colors text-xs">↗</span>
        </a>
      </div>

      <div class="pt-2">
        <button 
          class="open-contact-drawer w-full bg-brand-primary hover:bg-brand-primary-hover text-brand-dark font-bold text-center py-4 rounded-full transition-colors shadow-md block cursor-pointer text-xs uppercase tracking-wider"
        >
          Plan Gratis Adviesgesprek ↗
        </button>
      </div>

    </div>
  </div>
</header>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('mobile-menu-btn');
    const icon = document.getElementById('mobile-menu-icon');
    const menu = document.getElementById('mobile-menu');
    const backdrop = document.getElementById('mobile-menu-backdrop');
    
    function toggleMobileMenu(open) {
      if (!menu || !btn) return;
      const isCurrentlyOpen = !menu.classList.contains('hidden');
      const shouldOpen = open !== undefined ? open : !isCurrentlyOpen;

      if (shouldOpen) {
        menu.classList.remove('hidden');
        if (backdrop) backdrop.classList.remove('hidden');
        if (icon) icon.textContent = '✕';
        btn.setAttribute('aria-expanded', 'true');
        document.body.classList.add('overflow-hidden');
      } else {
        menu.classList.add('hidden');
        if (backdrop) backdrop.classList.add('hidden');
        if (icon) icon.textContent = '☰';
        btn.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('overflow-hidden');
      }
    }

    if (btn) {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleMobileMenu();
      });
    }

    if (backdrop) {
      backdrop.addEventListener('click', () => toggleMobileMenu(false));
    }

    // Close menu when tapping any internal link
    if (menu) {
      const menuLinks = menu.querySelectorAll('a, button');
      menuLinks.forEach(link => {
        link.addEventListener('click', () => {
          toggleMobileMenu(false);
        });
      });
    }
  });
</script>
