---
import { getCollection } from 'astro:content';

const locaties = await getCollection('locaties');
const diensten = await getCollection('diensten');

const pathname = Astro.url.pathname;
const cleanPath = pathname.replace(/\/$/, "");
---

<header class="w-full relative z-50 bg-white shadow-[0_4px_25px_rgba(21,59,104,0.08)]">
  <!-- Top Utility Bar (Notification Bar - Right Aligned Contact Info) -->
  <div class="w-full bg-brand-dark border-b border-white/5 relative z-50 hidden lg:block">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 py-3 flex justify-end items-center text-[11px] text-slate-300">
      <!-- Contact Info (Right) -->
      <div class="flex items-center space-x-8 font-sans">
        <span class="flex items-center space-x-2">
          <span class="text-brand-accent">📍</span> <span class="font-medium text-slate-300">Herenweg 42, Moerkapelle</span>
        </span>
        <span class="flex items-center space-x-2">
          <span class="text-brand-accent">✉️</span> <a href="mailto:info@spekadvies.nl" class="hover:text-brand-accent transition-colors font-medium text-slate-300">info@spekadvies.nl</a>
        </span>
        <span class="flex items-center space-x-2">
          <span class="text-brand-accent">📞</span> <a href="tel:+31795931241" class="hover:text-brand-accent transition-colors font-medium text-slate-300">079 593 1241</a>
        </span>
      </div>
    </div>
  </div>

  <!-- Main Header Bar -->
  <div class="w-full h-20 sm:h-24 relative border-b border-slate-100/50">
    
    <!-- Background Divider (Stretches full bleed to screen edges behind the content) -->
    <div class="absolute inset-0 w-full h-full -z-10 flex pointer-events-none">
      <!-- White area (left) -->
      <div class="w-[70%] sm:w-[75%] lg:w-[84%] bg-white h-full transition-all"></div>
      
      <!-- Slanted Curved Divider (SVG in Sky Blue - S-Curve going from bottom-left to top-right) -->
      <svg class="h-full w-24 text-brand-accent fill-current -ml-1 -mr-1" viewBox="0 0 100 100" preserveAspectRatio="none">
        <path d="M 100 0 L 100 100 L 0 100 C 40 100, 60 0, 100 0 Z" />
      </svg>
      
      <!-- Sky Blue area (right) -->
      <div class="flex-grow bg-brand-accent h-full"></div>
    </div>

    <!-- Header Contents (Constrained to centered page grid) -->
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 w-full h-full flex justify-between items-center relative z-20">
      
      <!-- Left Side: Logo (Always on White Background) -->
      <div class="flex items-center h-full">
        <!-- Logo -->
        <a href="/" class="flex items-center">
          <img 
            src="/Logo/Middel 9.svg" 
            alt="Spekadvies Logo" 
            class="h-[48px] sm:h-[60px] w-auto object-contain select-none"
          />
        </a>
      </div>

      <!-- Right Side Group: Menu Links & Action Button -->
      <div class="flex items-center h-full space-x-8 xl:space-x-12">
        <!-- Desktop Menu (Title Case, Sans-Serif Bold, matching Insonis) -->
        <nav class="hidden xl:flex items-center space-x-8 font-sans font-medium text-[14px] h-full">
          
          <!-- Diensten Dropdown -->
          <div class="relative group">
            <button class={`hover:text-brand-accent flex items-center space-x-1.5 focus:outline-none py-2 cursor-pointer font-sans font-medium text-[14px] ${
              ["/hypotheken", "/verzekeringen", "/aangiften", "/diensten/vermogensbeheer"].includes(cleanPath) ? "text-brand-accent" : "text-slate-700"
            }`}>
              <span>Diensten</span>
              <span class="text-[8px] group-hover:rotate-180 transition-transform duration-300">▼</span>
            </button>
            <div class="absolute left-0 mt-1 w-60 bg-white border border-slate-200/85 rounded-2xl p-4 shadow-2xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 transform translate-y-2 group-hover:translate-y-0 z-50">
              <div class="flex flex-col space-y-2">
                <a 
                  href="/hypotheken" 
                  class={`hover:text-brand-dark hover:bg-slate-50 px-3 py-2.5 rounded-xl transition-all text-xs font-semibold ${cleanPath === "/hypotheken" ? "text-brand-dark bg-slate-50" : "text-slate-650"}`}
                >
                  Hypotheken
                </a>
                <a 
                  href="/verzekeringen" 
                  class={`hover:text-brand-dark hover:bg-slate-50 px-3 py-2.5 rounded-xl transition-all text-xs font-semibold ${cleanPath === "/verzekeringen" ? "text-brand-dark bg-slate-50" : "text-slate-650"}`}
                >
                  Verzekeringen
                </a>
                <a 
                  href="/aangiften" 
                  class={`hover:text-brand-dark hover:bg-slate-50 px-3 py-2.5 rounded-xl transition-all text-xs font-semibold ${cleanPath === "/aangiften" ? "text-brand-dark bg-slate-50" : "text-slate-650"}`}
                >
                  Belastingaangifte
                </a>
                <a 
                  href="/diensten/vermogensbeheer" 
                  class={`hover:text-brand-dark hover:bg-slate-50 px-3 py-2.5 rounded-xl transition-all text-xs font-semibold ${cleanPath === "/diensten/vermogensbeheer" ? "text-brand-dark bg-slate-50" : "text-slate-650"}`}
                >
                  Vermogensbeheer
                </a>
              </div>
            </div>
          </div>
          
          <!-- Klantenservice Dropdown -->
          <div class="relative group">
            <button class={`hover:text-brand-accent flex items-center space-x-1.5 focus:outline-none py-2 cursor-pointer font-sans font-medium text-[14px] ${
              ["/klantenservice", "/over-ons"].includes(cleanPath) ? "text-brand-accent" : "text-slate-700"
            }`}>
              <span>Klantenservice</span>
              <span class="text-[8px] group-hover:rotate-180 transition-transform duration-300">▼</span>
            </button>
            <div class="absolute left-0 mt-1 w-56 bg-white border border-slate-200/85 rounded-2xl p-4 shadow-2xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 transform translate-y-2 group-hover:translate-y-0 z-50">
              <div class="flex flex-col space-y-2">
                <a 
                  href="/klantenservice" 
                  class={`hover:text-brand-dark hover:bg-slate-50 px-3 py-2.5 rounded-xl transition-all text-xs font-semibold ${cleanPath === "/klantenservice" ? "text-brand-dark bg-slate-50" : "text-slate-650"}`}
                >
                  Klantenservice
                </a>
                <a 
                  href="/over-ons" 
                  class={`hover:text-brand-dark hover:bg-slate-50 px-3 py-2.5 rounded-xl transition-all text-xs font-semibold ${cleanPath === "/over-ons" ? "text-brand-dark bg-slate-50" : "text-slate-650"}`}
                >
                  Over ons
                </a>
              </div>
            </div>
          </div>
          
          <!-- Contact Link -->
          <a href="/klantenservice?tab=klantenservice" class={cleanPath === "/klantenservice" && Astro.url.searchParams.get("tab") === "klantenservice" ? "text-brand-accent py-2" : "text-slate-700 hover:text-brand-accent transition-colors py-2"}>Contact</a>
        </nav>

        <!-- Right Side: Phone & Button (Sitting over the Gold/Orange Background) -->
        <div class="flex items-center gap-4 sm:gap-6 h-full">
          <!-- Action Button (Insonis Style - Dark Pill on Gold/Orange) -->
          <button 
            class="open-contact-drawer bg-brand-dark hover:bg-white hover:text-brand-dark text-white font-medium text-[10px] sm:text-xs px-5 py-3 sm:px-7 sm:py-3.5 rounded-full tracking-widest uppercase transition-all duration-300 flex items-center justify-center space-x-2 font-sans relative overflow-hidden shadow-md min-w-[140px] whitespace-nowrap flex-shrink-0 cursor-pointer"
          >
            <span>Plan Gesprek ↗</span>
          </button>

          <!-- Mobile Menu Trigger (Styled White on Gold/Orange) -->
          <button id="mobile-menu-btn" class="xl:hidden text-white hover:text-brand-dark focus:outline-none text-2xl flex-shrink-0" aria-label="Menu openen">
            ☰
          </button>
        </div>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden fixed inset-x-0 top-[80px] sm:top-[96px] bg-white border-b border-slate-200 p-6 z-40 shadow-2xl transition-all">
    <div class="flex flex-col space-y-4 text-xs font-semibold uppercase tracking-wider font-sans">
      <a href="/klantenservice?tab=klantenservice" class="text-brand-dark hover:text-brand-accent py-2 transition-colors">Contact</a>
      
      <div class="border-t border-slate-100 pt-2">
        <span class="text-slate-400 text-[10px] tracking-widest block mb-2">Diensten</span>
        <div class="flex flex-col pl-4 space-y-2">
          <a href="/hypotheken" class="text-slate-650 hover:text-brand-dark py-1 transition-colors font-sans font-semibold text-sm">Hypotheken</a>
          <a href="/verzekeringen" class="text-slate-650 hover:text-brand-dark py-1 transition-colors font-sans font-semibold text-sm">Verzekeringen</a>
          <a href="/aangiften" class="text-slate-650 hover:text-brand-dark py-1 transition-colors font-sans font-semibold text-sm">Belastingaangifte</a>
          <a href="/diensten/vermogensbeheer" class="text-slate-650 hover:text-brand-dark py-1 transition-colors font-sans font-semibold text-sm">Vermogensbeheer</a>
        </div>
      </div>
      
      <div class="border-t border-slate-100 pt-2">
        <span class="text-slate-400 text-[10px] tracking-widest block mb-2">Klantenservice</span>
        <div class="flex flex-col pl-4 space-y-2">
          <a href="/klantenservice" class="text-slate-650 hover:text-brand-dark py-1 transition-colors font-sans font-semibold text-sm">Klantenservice</a>
          <a href="/over-ons" class="text-slate-650 hover:text-brand-dark py-1 transition-colors font-sans font-semibold text-sm">Over ons</a>
        </div>
      </div>
      
      <button 
        class="open-contact-drawer w-full bg-brand-primary hover:bg-brand-primary-hover text-brand-dark font-semibold text-center py-3.5 rounded-full transition-colors mt-4 block cursor-pointer"
      >
        Plan Gesprek
      </button>
    </div>
  </div>
</header>

<script is:inline>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
      btn.innerHTML = menu.classList.contains('hidden') ? '☰' : '✕';
    });
  }
</script>
