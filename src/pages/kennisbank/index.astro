---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Footer from '../../components/Footer.astro';
import { KENNISBANK_ARTIKELEN } from '../../data/kennisbank';

const title = "Kennisbank & Financiële Gidsen | Spekadvies Moerkapelle";
const description = "Onafhankelijke uitleg, rekenregels en antwoorden op al jouw vragen over hypotheken, overbrugging, oversluiten, AOV en fiscale regelgeving.";
---

<Layout title={title} description={description}>
  <Navbar />
  <Breadcrumbs />

  <main class="relative z-10 flex-grow bg-white">

    <!-- Hero Section -->
    <section 
      class="relative py-20 sm:py-28 bg-[#153b68] bg-center bg-cover bg-no-repeat overflow-hidden rounded-b-[40px] sm:rounded-b-[56px] lg:rounded-b-[72px] shadow-xl"
      style="background-image: linear-gradient(rgba(21, 59, 104, 0.88), rgba(11, 26, 47, 0.96)), url('https://images.unsplash.com/photo-1450133064473-71024230f91b?auto=format&fit=crop&w=1800&q=80');"
    >
      <div class="max-w-4xl mx-auto px-4 sm:px-8 text-center relative z-10">
        <span class="inline-block bg-white/10 text-brand-accent border border-white/15 text-[11px] font-semibold tracking-widest uppercase px-4 py-1.5 rounded-full mb-6 font-sans">
          Financiële Kennis & Adviesgidsen
        </span>
        
        <h1 class="text-3xl sm:text-5xl lg:text-5.5xl font-bold text-white tracking-tight leading-tight font-display mb-6">
          Kennisbank: Duidelijke Antwoorden op Complexe Financiële Vragen
        </h1>
        
        <p class="text-slate-200 text-base sm:text-lg leading-relaxed max-w-2xl mx-auto mb-8 font-sans font-normal">
          Geen onbegrijpelijk bancair jargon, maar heldere uitleg van erkend adviseur <strong>Martin van der Spek</strong> over overbruggingshypotheken, boeterente, startersleningen en ondernemershypotheken.
        </p>
      </div>
    </section>

    <!-- Articles Grid Section -->
    <section class="py-16 sm:py-24 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-8 lg:px-12">
        
        <div class="text-center max-w-2xl mx-auto mb-16">
          <h2 class="text-2xl sm:text-3xl font-bold text-brand-dark font-display mb-3">
            Populaire Gidsen & Artikelen
          </h2>
          <p class="text-slate-600 text-sm font-sans">
            Klik op een artikel voor een direct en volledig antwoord op jouw financiële vraagstuk.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {KENNISBANK_ARTIKELEN.map((artikel) => (
            <article class="bg-[#f8fafc] border border-slate-200/80 rounded-3xl p-6 sm:p-8 flex flex-col justify-between shadow-xs hover:shadow-lg transition-all duration-300 group">
              <div>
                <div class="flex items-center justify-between gap-2 mb-4">
                  <span class="text-[10px] font-bold uppercase tracking-wider text-brand-accent bg-brand-dark px-3 py-1 rounded-full font-sans">
                    {artikel.category}
                  </span>
                  <span class="text-[11px] text-slate-400 font-sans">
                    {artikel.readTime}
                  </span>
                </div>
                
                <h3 class="text-lg sm:text-xl font-bold text-brand-dark font-display mb-3 group-hover:text-brand-accent transition-colors leading-snug">
                  <a href={`/kennisbank/${artikel.slug}`} class="focus:outline-none">
                    {artikel.title}
                  </a>
                </h3>

                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-sans mb-6 line-clamp-3">
                  {artikel.directAnswer}
                </p>
              </div>

              <div class="pt-4 border-t border-slate-200/60 flex items-center justify-between">
                <a 
                  href={`/kennisbank/${artikel.slug}`} 
                  class="text-xs font-bold text-brand-dark group-hover:text-brand-accent transition-colors flex items-center gap-1.5 font-sans"
                >
                  <span>Lees complete gids</span>
                  <span>➔</span>
                </a>
              </div>
            </article>
          ))}
        </div>

      </div>
    </section>

    <!-- Consultation CTA Section -->
    <section class="py-16 bg-[#153b68] text-white text-center">
      <div class="max-w-4xl mx-auto px-4 sm:px-8">
        <h2 class="text-2xl sm:text-4xl font-bold font-display tracking-tight mb-4">
          Staat jouw vraag er niet tussen?
        </h2>
        <p class="text-slate-200 text-sm sm:text-base max-w-xl mx-auto mb-8 font-sans">
          Elke persoonlijke situatie is uniek. Neem direct contact op met Martin van der Spek voor een vrijblijvend en deskundig antwoord.
        </p>
        <button 
          class="open-contact-drawer inline-block bg-brand-accent hover:bg-brand-accent/90 text-brand-dark font-bold px-8 py-4 rounded-full shadow-lg transition-all text-xs tracking-wider uppercase font-sans cursor-pointer"
        >
          Stel jouw vraag direct ➔
        </button>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
