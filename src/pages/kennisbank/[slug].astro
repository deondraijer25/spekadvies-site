---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqSchema from '../../components/FaqSchema.astro';
import Footer from '../../components/Footer.astro';
import { KENNISBANK_ARTIKELEN, type KennisbankArticle } from '../../data/kennisbank';
import { COMPANY_DATA } from '../../data/company';

export async function getStaticPaths() {
  return KENNISBANK_ARTIKELEN.map((artikel) => ({
    params: { slug: artikel.slug },
    props: { artikel },
  }));
}

interface Props {
  artikel: KennisbankArticle;
}

const { artikel } = Astro.props;

// Schema.org Article Structured Data
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": artikel.title,
  "description": artikel.seoDescription,
  "datePublished": artikel.publishedDate,
  "dateModified": artikel.publishedDate,
  "author": {
    "@type": "Person",
    "name": COMPANY_DATA.founder.name,
    "jobTitle": COMPANY_DATA.founder.role,
    "url": "https://www.spekadvies.nl/over-ons"
  },
  "publisher": {
    "@type": "Organization",
    "name": COMPANY_DATA.name,
    "logo": {
      "@type": "ImageObject",
      "url": "https://www.spekadvies.nl/Logo/Middel%209.svg"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://www.spekadvies.nl/kennisbank/${artikel.slug}`
  }
};
---

<Layout title={artikel.seoTitle} description={artikel.seoDescription}>
  <!-- Schema.org FAQ & Article Structured Data -->
  {artikel.faqs && artikel.faqs.length > 0 && <FaqSchema faqs={artikel.faqs} />}
  <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />

  <Navbar />
  <Breadcrumbs />

  <main class="relative z-10 flex-grow bg-white">
    
    <!-- Hero Header -->
    <header class="py-16 sm:py-24 bg-[#153b68] text-white relative overflow-hidden rounded-b-[40px] sm:rounded-b-[56px]">
      <div class="max-w-4xl mx-auto px-4 sm:px-8 text-center relative z-10">
        <div class="inline-flex items-center gap-2 bg-white/10 text-brand-accent px-3 py-1 rounded-full text-[11px] font-semibold tracking-wider uppercase mb-6 font-sans">
          <span>{artikel.category}</span>
          <span>•</span>
          <span>{artikel.readTime}</span>
        </div>
        
        <h1 class="text-2xl sm:text-4xl lg:text-5xl font-bold font-display tracking-tight leading-tight mb-6">
          {artikel.title}
        </h1>

        <div class="flex items-center justify-center gap-3 text-xs text-slate-300 font-sans">
          <span>Auteur: <strong>{COMPANY_DATA.founder.name}</strong></span>
          <span>•</span>
          <span>Moerkapelle</span>
        </div>
      </div>
    </header>

    <!-- Main Content Area -->
    <div class="max-w-4xl mx-auto px-4 sm:px-8 py-16">
      
      <!-- GEO AI DIRECT ANSWER BOX (Optimized for ChatGPT, Perplexity & Google SGE) -->
      <section class="bg-gradient-to-br from-amber-50/90 to-amber-100/50 border-2 border-brand-accent/60 rounded-3xl p-6 sm:p-8 mb-12 shadow-sm">
        <div class="flex items-center gap-2 text-brand-dark text-xs font-bold uppercase tracking-wider mb-3 font-sans">
          <span class="w-6 h-6 rounded-full bg-brand-accent text-brand-dark flex items-center justify-center text-xs">✓</span>
          <span>Direct Antwoord in het kort (Samenvatting)</span>
        </div>
        <p class="text-base sm:text-lg font-medium text-slate-900 leading-relaxed font-sans">
          {artikel.directAnswer}
        </p>
        <div class="mt-4 pt-4 border-t border-amber-200/60 flex items-center justify-between text-xs text-slate-500 font-sans">
          <span>Geverifieerd door Erkend Hypothecair Planner</span>
          <span class="text-brand-dark font-semibold">Martin van der Spek</span>
        </div>
      </section>

      <!-- Editorial Body -->
      <article class="prose prose-slate prose-brand max-w-none font-sans text-slate-700 leading-relaxed space-y-6 text-sm sm:text-base">
        <div set:html={artikel.content.replace(/\n/g, '<br />')} />
      </article>

      <!-- Related Subservices -->
      {artikel.relatedServices && artikel.relatedServices.length > 0 && (
        <section class="mt-16 pt-8 border-t border-slate-200">
          <h2 class="text-xl font-bold text-brand-dark font-display mb-4">Gerelateerde Diensten & Advies</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {artikel.relatedServices.map((rel) => (
              <a 
                href={rel.url} 
                class="bg-[#f8fafc] border border-slate-200 p-4 rounded-2xl flex items-center justify-between hover:border-brand-accent transition-colors font-sans text-sm font-semibold text-slate-800"
              >
                <span>{rel.name}</span>
                <span class="text-brand-accent font-bold">➔</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- GEO AI FAQs -->
      {artikel.faqs && artikel.faqs.length > 0 && (
        <section class="mt-16 pt-8 border-t border-slate-200">
          <h2 class="text-2xl font-bold text-brand-dark font-display mb-6">Veelgestelde Vragen</h2>
          <div class="space-y-4">
            {artikel.faqs.map((faq) => (
              <details class="group bg-white border border-slate-200/80 rounded-2xl p-5 shadow-xs transition-all duration-300 [&_summary::-webkit-details-marker]:hidden">
                <summary class="flex justify-between items-center font-bold text-brand-dark cursor-pointer select-none outline-none font-display">
                  <span class="text-sm sm:text-base">{faq.question}</span>
                  <span class="transition-transform duration-300 group-open:rotate-180 text-brand-accent font-bold text-lg ml-4">
                    ↓
                  </span>
                </summary>
                <div class="mt-4 text-slate-650 text-xs sm:text-sm leading-relaxed border-t border-slate-100 pt-4 font-sans">
                  {faq.answer}
                </div>
              </details>
            ))}
          </div>
        </section>
      )}

      <!-- Maatwerk Consultation Box -->
      <section class="mt-16 bg-[#153b68] text-white rounded-3xl p-8 sm:p-10 shadow-xl text-center">
        <h2 class="text-xl sm:text-2xl font-bold font-display mb-3">
          Wil je dit berekenen voor jouw specifieke situatie?
        </h2>
        <p class="text-slate-200 text-xs sm:text-sm max-w-lg mx-auto mb-6 font-sans">
          Neem vrijblijvend contact op met Martin van der Spek. Binnen 24 uur heb je een heldere, onafhankelijke berekening op maat.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <button 
            class="open-contact-drawer bg-brand-accent hover:bg-brand-accent/90 text-brand-dark font-bold px-6 py-3.5 rounded-full text-xs uppercase tracking-wider font-sans transition-all cursor-pointer w-full sm:w-auto"
          >
            Plan gratis adviesgesprek ➔
          </button>
          <a 
            href={`tel:${COMPANY_DATA.contact.phoneRaw}`} 
            class="bg-white/10 hover:bg-white/20 text-white font-semibold px-6 py-3.5 rounded-full text-xs uppercase tracking-wider font-sans transition-all w-full sm:w-auto border border-white/20"
          >
            Bel: {COMPANY_DATA.contact.phoneDisplay}
          </a>
        </div>
      </section>

    </div>
  </main>

  <Footer />
</Layout>
