---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqSchema from '../../components/FaqSchema.astro';
import Footer from '../../components/Footer.astro';
import { KENNISBANK_ARTIKELEN, type KennisbankArticle } from '../../data/kennisbank';
import { COMPANY_DATA } from '../../data/company';

export async function getStaticPaths() {
  return KENNISBANK_ARTIKELEN.map((artikel) => ({
    params: { slug: artikel.slug },
    props: { artikel },
  }));
}

interface Props {
  artikel: KennisbankArticle;
}

const { artikel } = Astro.props;

// Schema.org Article Structured Data
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": artikel.title,
  "description": artikel.seoDescription,
  "datePublished": artikel.publishedDate,
  "dateModified": artikel.publishedDate,
  "author": {
    "@type": "Person",
    "name": COMPANY_DATA.founder.name,
    "jobTitle": COMPANY_DATA.founder.role,
    "url": "https://www.spekadvies.nl/over-ons"
  },
  "publisher": {
    "@type": "Organization",
    "name": COMPANY_DATA.name,
    "logo": {
      "@type": "ImageObject",
      "url": "https://www.spekadvies.nl/Logo/Middel%209.svg"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://www.spekadvies.nl/kennisbank/${artikel.slug}`
  }
};
---

<Layout title={artikel.seoTitle} description={artikel.seoDescription}>
  <!-- Schema.org FAQ & Article Structured Data -->
  {artikel.faqs && artikel.faqs.length > 0 && <FaqSchema faqs={artikel.faqs} />}
  <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />

  <Navbar />
  <Breadcrumbs />

  <main class="relative z-10 flex-grow bg-white">
    
    <!-- Hero Header -->
    <header class="py-16 sm:py-24 bg-brand-dark text-white relative overflow-hidden rounded-b-[40px] sm:rounded-b-[56px] shadow-xl">
      <!-- Ambient glow -->
      <div class="absolute left-1/2 top-0 -translate-x-1/2 w-[500px] h-[250px] bg-brand-primary/10 blur-[100px] pointer-events-none rounded-full"></div>

      <div class="max-w-4xl mx-auto px-4 sm:px-8 text-center relative z-10">
        <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-md text-brand-primary border border-white/20 px-3.5 py-1.5 rounded-full text-[11px] font-semibold tracking-wider uppercase mb-6 font-sans shadow-xs">
          <span>{artikel.category}</span>
          <span>•</span>
          <span>⏱ {artikel.readTime}</span>
        </div>
        
        <h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold font-display tracking-tight leading-[1.2] mb-6">
          {artikel.title}
        </h1>

        <div class="inline-flex items-center gap-3 bg-white/5 border border-white/10 px-4 py-2 rounded-full text-xs text-slate-300 font-sans backdrop-blur-xs">
          <span>Auteur: <strong class="text-white">{COMPANY_DATA.founder.name}</strong></span>
          <span class="text-white/30">•</span>
          <span>Erkend Hypothecair Planner</span>
          <span class="text-white/30">•</span>
          <span>Moerkapelle</span>
        </div>
      </div>
    </header>

    <!-- Main Content Area -->
    <div class="max-w-4xl mx-auto px-4 sm:px-8 py-14 sm:py-20">
      
      <!-- GEO AI DIRECT ANSWER BOX (Optimized for ChatGPT, Perplexity & Google SGE) -->
      <section class="bg-gradient-to-br from-amber-50/90 via-white to-amber-100/50 border-2 border-amber-300/80 rounded-3xl p-6 sm:p-9 mb-12 shadow-sm relative overflow-hidden">
        <div class="flex items-center gap-2 text-brand-dark text-xs font-bold uppercase tracking-wider mb-3.5 font-sans">
          <span class="w-6 h-6 rounded-full bg-amber-400 text-brand-dark flex items-center justify-center text-xs font-black shadow-xs">✓</span>
          <span class="text-amber-950 font-extrabold">Direct Antwoord in het kort (GEO Direct Answer)</span>
        </div>
        
        <p class="text-base sm:text-lg font-medium text-slate-900 leading-relaxed font-sans">
          {artikel.directAnswer}
        </p>

        <div class="mt-5 pt-4 border-t border-amber-200/70 flex flex-col sm:flex-row sm:items-center justify-between text-xs text-slate-600 font-sans gap-2">
          <span>Geverifieerd conform Wft-normen door Erkend Hypothecair Planner</span>
          <span class="text-brand-dark font-bold">Martin van der Spek</span>
        </div>
      </section>

      <!-- Editorial Body -->
      <article class="prose prose-slate max-w-none font-sans text-slate-700 leading-relaxed space-y-6 text-sm sm:text-base font-normal">
        <div set:html={artikel.content.replace(/\n/g, '<br />')} />
      </article>

      <!-- Related Subservices -->
      {artikel.relatedServices && artikel.relatedServices.length > 0 && (
        <section class="mt-16 pt-10 border-t border-slate-200">
          <h2 class="text-xl sm:text-2xl font-bold text-brand-dark font-display mb-4">Gerelateerde Diensten & Advies</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {artikel.relatedServices.map((rel) => (
              <a 
                href={rel.url} 
                class="bento-card p-5 flex items-center justify-between group hover:border-amber-300 font-sans text-sm font-semibold text-slate-800"
              >
                <span class="group-hover:text-brand-dark transition-colors">{rel.name}</span>
                <span class="w-8 h-8 rounded-full bg-slate-100 group-hover:bg-amber-100 text-brand-dark flex items-center justify-center text-xs font-bold transition-all group-hover:translate-x-0.5">➔</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- GEO AI FAQs -->
      {artikel.faqs && artikel.faqs.length > 0 && (
        <section class="mt-16 pt-10 border-t border-slate-200">
          <div class="mb-6">
            <span class="inline-block bg-amber-50 text-amber-800 border border-amber-200/80 text-[10px] font-bold uppercase tracking-wider px-3 py-1 rounded-full mb-2 font-sans">
              Veelgestelde Vragen
            </span>
            <h2 class="text-2xl sm:text-3xl font-bold text-brand-dark font-display">Veelgestelde vragen over dit onderwerp</h2>
          </div>
          
          <div class="space-y-4">
            {artikel.faqs.map((faq) => (
              <details class="group bg-white border border-slate-200/90 rounded-2xl p-5 sm:p-6 shadow-xs hover:border-slate-300 transition-all duration-300 [&_summary::-webkit-details-marker]:hidden">
                <summary class="flex justify-between items-center cursor-pointer select-none outline-none">
                  <span class="text-sm sm:text-base font-semibold text-slate-800 font-sans leading-snug pr-4">{faq.question}</span>
                  <span class="w-8 h-8 rounded-full bg-slate-100 group-hover:bg-amber-100 group-open:rotate-180 transition-all duration-300 text-brand-dark flex items-center justify-center text-xs font-bold shrink-0">
                    ↓
                  </span>
                </summary>
                <div class="mt-4 text-slate-650 text-xs sm:text-sm leading-relaxed border-t border-slate-100 pt-4 font-sans font-normal">
                  {faq.answer}
                </div>
              </details>
            ))}
          </div>
        </section>
      )}

      <!-- Maatwerk Consultation Box -->
      <section class="mt-16 bg-gradient-to-br from-[#153b68] via-[#102d50] to-[#0b1a2f] text-white rounded-3xl p-8 sm:p-12 shadow-2xl text-center relative overflow-hidden border border-white/10">
        <h2 class="text-xl sm:text-3xl font-bold font-display tracking-tight mb-3">
          Wil je dit berekenen voor jouw specifieke situatie?
        </h2>
        <p class="text-slate-200 text-xs sm:text-base max-w-lg mx-auto mb-8 font-sans font-normal leading-relaxed">
          Neem vrijblijvend contact op met Martin van der Spek. Binnen 24 uur heb je een heldere, onafhankelijke berekening op maat.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5">
          <button 
            class="open-contact-drawer bg-brand-primary hover:bg-brand-primary-hover text-brand-dark font-bold px-7 py-3.5 rounded-full text-xs uppercase tracking-wider font-sans transition-all cursor-pointer shadow-[0_8px_20px_rgba(255,206,118,0.25)] hover:-translate-y-0.5 w-full sm:w-auto"
          >
            Plan gratis adviesgesprek ➔
          </button>
          <a 
            href={`tel:${COMPANY_DATA.contact.phoneRaw}`} 
            class="bg-white/10 hover:bg-white/20 text-white font-semibold px-6 py-3.5 rounded-full text-xs uppercase tracking-wider font-sans transition-all w-full sm:w-auto border border-white/20 backdrop-blur-xs"
          >
            Bel direct: {COMPANY_DATA.contact.phoneDisplay}
          </a>
        </div>
      </section>

    </div>
  </main>

  <Footer />
</Layout>
