<!-- Client side tab logic -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Tab Navigation Logic
    const tabs = document.querySelectorAll('.tab-btn');
    const panels = document.querySelectorAll('.tab-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        // Deactivate all tabs & panels
        tabs.forEach(t => {
          t.classList.remove('active', 'border-brand-accent', 'text-brand-dark');
          t.classList.add('border-transparent', 'text-slate-400');
        });
        panels.forEach(p => p.classList.add('hidden'));

        // Activate clicked tab & panel
        tab.classList.add('active', 'border-brand-accent', 'text-brand-dark');
        tab.classList.remove('border-transparent', 'text-slate-400');
        const targetId = `panel-${tab.getAttribute('data-tab')}`;
        document.getElementById(targetId).classList.remove('hidden');
      });
    });

    // Handle initial tab selection via URL parameter
    const urlParams = new URLSearchParams(window.location.search);
    const initialTab = urlParams.get('tab');
    if (initialTab) {
      const targetTab = document.querySelector(`.tab-btn[data-tab="${initialTab}"]`);
      if (targetTab) {
        targetTab.click();
      }
    }
  });
</script>
