---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import SectionDivider from '../components/SectionDivider.astro';
import { COMPANY_DATA } from '../data/company';
---

<Layout 
  title="Plan een afspraak | Persoonlijk Advies op Maat — Spekadvies Moerkapelle"
  description="Plan in 1 minuut een vrijblijvende afspraak met Martin van der Spek voor onafhankelijk advies over hypotheken, verzekeringen, belastingaangiften of vermogen."
>
  <div class="min-h-screen flex flex-col bg-white relative overflow-hidden">
    
    <!-- Subtle 24px dot-grid background matching Hero & FeatureCards -->
    <div 
      class="pointer-events-none absolute inset-0 z-0 opacity-25" 
      aria-hidden="true"
      style="background-image: radial-gradient(circle, rgba(148, 163, 184, 0.45) 1px, transparent 1px); background-size: 24px 24px;"
    ></div>

    <!-- Soft Spekadvies brand background glows -->
    <div class="absolute top-0 right-1/4 w-[500px] h-[500px] rounded-full bg-[#ffce76]/15 blur-[120px] pointer-events-none z-0"></div>
    <div class="absolute bottom-0 left-10 w-[450px] h-[450px] rounded-full bg-[#153b68]/[0.06] blur-[120px] pointer-events-none z-0"></div>

    <!-- Minimal Distraction-Free Header -->
    <header class="w-full bg-white/95 backdrop-blur-md border-b border-slate-200/70 relative z-30">
      <div class="max-w-7xl mx-auto px-4 sm:px-8 lg:px-12 h-20 flex items-center justify-between">
        <div class="flex items-center gap-6">
          <a href="/" class="flex items-center group" aria-label="Terug naar Spekadvies homepage">
            <img 
              src="/Logo/Middel 9.svg" 
              alt="Spekadvies Logo" 
              class="h-9 sm:h-11 w-auto object-contain select-none"
            />
          </a>
          <a 
            href="/" 
            class="hidden sm:inline-flex items-center gap-2 ty-small text-slate-500 hover:text-brand-dark font-semibold transition-colors pl-6 border-l border-slate-200"
          >
            <i class="fa-solid fa-arrow-left text-[11px]"></i>
            <span>Terug naar website</span>
          </a>
        </div>

        <div class="flex items-center gap-3 sm:gap-5">
          <div class="hidden md:flex items-center gap-2 ty-small text-slate-600">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span>Al <strong class="text-brand-dark font-semibold">1.200+ klanten</strong> persoonlijk geholpen</span>
          </div>
          <a 
            href={`tel:${COMPANY_DATA.contact.phoneRaw}`} 
            class="btn-nav inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#153b68]/[0.05] hover:bg-[#ffce76]/30 text-brand-dark border border-[#153b68]/15 transition-colors"
          >
            <i class="fa-solid fa-phone text-brand-dark text-xs"></i>
            <span>{COMPANY_DATA.contact.phone}</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Main Interactive Funnel Container -->
    <main class="flex-grow flex items-center justify-center pt-10 pb-24 sm:pt-16 sm:pb-32 px-4 sm:px-8 relative z-10 overflow-x-clip">
      <div class="w-full max-w-3xl mx-auto relative">

        <!-- =====================================================================
             SPEKADVIES 3-CLOVER COMPOSITIE ACHTER HET FORMULIER (ZONDER VIDEO, MET KLEUR)
             ===================================================================== -->
        <div 
          class="pointer-events-none select-none absolute -top-12 sm:-top-16 -right-24 sm:-right-44 lg:-right-64 w-[360px] sm:w-[580px] lg:w-[720px] aspect-[1/1] z-0"
          aria-hidden="true"
        >
          <!-- 1. Medium Spekadvies Gold Clover (#ffce76, Behind Top-Left, Upright 0deg) -->
          <svg 
            class="absolute z-10 text-[#ffce76]" 
            style="height: 43%; left: 6%; top: 2%; aspect-ratio: 80.08 / 83.08;"
            viewBox="0 0 80.08 83.08" 
            fill="currentColor" 
            xmlns="http://www.w3.org/2000/svg"
          >
            <path d="M80.08,43.04c0,10.89-8.87,19.76-19.76,19.76-.18,0-.35-.01-.53-.02,0,.18.01.36.01.53,0,10.9-8.87,19.77-19.76,19.77s-19.76-8.87-19.76-19.77c0-.17,0-.35.01-.53-.18,0-.36.02-.53.02C8.86,62.8,0,53.93,0,43.04s8.86-19.76,19.76-19.76c.17,0,.35,0,.53,0-.01-.18-.01-.36-.01-.53,0-8.09,10.4-17.07,16.61-21.71,1.88-1.4,4.41-1.4,6.3,0,6.2,4.64,16.61,13.62,16.61,21.71,0,.17-.01.35-.01.53.18,0,.35,0,.53,0,10.89,0,19.76,8.86,19.76,19.76Z"/>
          </svg>

          <!-- 2. Large Spekadvies Dark-Blue Clover (#153b68, Tilted 19deg Clockwise, Solid Color) -->
          <svg 
            class="absolute z-20 text-[#153b68] drop-shadow-[0_20px_50px_rgba(21,59,104,0.18)]" 
            style="height: 89%; right: -3%; top: 3.5%; aspect-ratio: 80.08 / 83.08; transform: rotate(19deg); transform-origin: center center;"
            viewBox="0 0 80.08 83.08" 
            fill="currentColor" 
            xmlns="http://www.w3.org/2000/svg"
          >
            <path d="M80.08,43.04c0,10.89-8.87,19.76-19.76,19.76-.18,0-.35-.01-.53-.02,0,.18.01.36.01.53,0,10.9-8.87,19.77-19.76,19.77s-19.76-8.87-19.76-19.77c0-.17,0-.35.01-.53-.18,0-.36.02-.53.02C8.86,62.8,0,53.93,0,43.04s8.86-19.76,19.76-19.76c.17,0,.35,0,.53,0-.01-.18-.01-.36-.01-.53,0-8.09,10.4-17.07,16.61-21.71,1.88-1.4,4.41-1.4,6.3,0,6.2,4.64,16.61,13.62,16.61,21.71,0,.17-.01.35-.01.53.18,0,.35,0,.53,0,10.89,0,19.76,8.86,19.76,19.76Z"/>
          </svg>

          <!-- 3. Small Spekadvies Gold Accent Clover (#ffce76, In Front on Right, Tilted -25deg) -->
          <svg 
            class="absolute z-30 text-[#ffce76] drop-shadow-[0_6px_16px_rgba(21,59,104,0.25)]" 
            style="height: 13.5%; right: 5%; top: 44%; aspect-ratio: 80.08 / 83.08; transform: rotate(-25deg); transform-origin: center center;"
            viewBox="0 0 80.08 83.08" 
            fill="currentColor" 
            xmlns="http://www.w3.org/2000/svg"
          >
            <path d="M80.08,43.04c0,10.89-8.87,19.76-19.76,19.76-.18,0-.35-.01-.53-.02,0,.18.01.36.01.53,0,10.9-8.87,19.77-19.76,19.77s-19.76-8.87-19.76-19.77c0-.17,0-.35.01-.53-.18,0-.36.02-.53.02C8.86,62.8,0,53.93,0,43.04s8.86-19.76,19.76-19.76c.17,0,.35,0,.53,0-.01-.18-.01-.36-.01-.53,0-8.09,10.4-17.07,16.61-21.71,1.88-1.4,4.41-1.4,6.3,0,6.2,4.64,16.61,13.62,16.61,21.71,0,.17-.01.35-.01.53.18,0,.35,0,.53,0,10.89,0,19.76,8.86,19.76,19.76Z"/>
          </svg>
        </div>

        <!-- Funnel Card Wrapper (Foreground z-10) -->
        <div class="bg-white/95 backdrop-blur-xs border border-slate-200/90 rounded-[28px] sm:rounded-[36px] p-6 sm:p-10 lg:p-12 shadow-[0_24px_70px_-15px_rgba(21,59,104,0.18)] relative z-10 overflow-hidden">
          <!-- Interactive Top Progress Bar (Spekadvies Gold #ffce76 filling across Spekadvies Dark-Blue #153b68) -->
          <div class="absolute top-0 inset-x-0 h-2 bg-brand-dark overflow-hidden">
            <div 
              id="funnel-progress-bar" 
              class="h-full bg-[#ffce76] transition-all duration-500 ease-out rounded-r-full"
              style="width: 20%;"
            ></div>
          </div>

          <!-- Step Navigation Header (Vorige vraag + Stap X van 5) -->
          <div id="funnel-progress-wrapper" class="flex items-center justify-between mb-6 sm:mb-7 pt-1">
            <button 
              type="button" 
              id="funnel-prev-btn" 
              class="invisible inline-flex items-center gap-2 ty-small font-semibold text-brand-dark/80 hover:text-brand-dark bg-slate-50 hover:bg-[#ffce76]/30 border border-slate-200/90 px-3.5 py-1.5 rounded-full transition-all cursor-pointer"
            >
              <i class="fa-solid fa-arrow-left text-[11px]"></i>
              <span>Vorige vraag</span>
            </button>
            <span id="funnel-step-indicator" class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-brand-dark text-[#ffce76] ty-eyebrow shadow-2xs">
              Stap 1 van 5
            </span>
          </div>
          
          <!-- ==========================================
               STAP 1: ONDERWERP KIEZEN
               ========================================== -->
          <div class="funnel-step" data-step="1">
            <div class="space-y-2.5 mb-7 sm:mb-8">
              <h1 class="ty-h1 text-brand-dark">Waarmee kunnen we je helpen?</h1>
              <p class="ty-lead text-slate-600">
                Kies het onderwerp waar je vragen over hebt. We stellen je 4 korte vragen zodat we ons direct goed op jouw afspraak kunnen voorbereiden.
              </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <!-- Optie 1: Hypotheken -->
              <button 
                type="button"
                data-select-topic="hypotheken"
                data-topic-label="Hypotheek & Wonen"
                class="topic-card group text-left p-5 sm:p-6 rounded-2xl border-2 border-slate-200/80 hover:border-brand-dark bg-white hover:bg-[#153b68]/[0.02] transition-all duration-200 flex items-start gap-4 cursor-pointer shadow-xs hover:shadow-md"
              >
                <div class="w-12 h-12 rounded-2xl bg-[#ffce76]/35 border border-[#ffce76] group-hover:bg-brand-dark group-hover:border-brand-dark text-brand-dark group-hover:text-[#ffce76] flex items-center justify-center shrink-0 transition-colors">
                  <i class="fa-solid fa-house-chimney text-lg"></i>
                </div>
                <div class="space-y-1 flex-1">
                  <div class="flex items-center justify-between">
                    <h3 class="ty-h4 text-brand-dark">Hypotheek &amp; Wonen</h3>
                    <span class="text-slate-300 group-hover:text-brand-dark group-hover:translate-x-1 transition-all">→</span>
                  </div>
                  <p class="ty-body text-slate-600">
                    Eerste woning kopen, verhuizen, oversluiten of overwaarde benutten.
                  </p>
                </div>
              </button>

              <!-- Optie 2: Verzekeringen -->
              <button 
                type="button"
                data-select-topic="verzekeringen"
                data-topic-label="Verzekeringen"
                class="topic-card group text-left p-5 sm:p-6 rounded-2xl border-2 border-slate-200/80 hover:border-brand-dark bg-white hover:bg-[#153b68]/[0.02] transition-all duration-200 flex items-start gap-4 cursor-pointer shadow-xs hover:shadow-md"
              >
                <div class="w-12 h-12 rounded-2xl bg-[#ffce76]/35 border border-[#ffce76] group-hover:bg-brand-dark group-hover:border-brand-dark text-brand-dark group-hover:text-[#ffce76] flex items-center justify-center shrink-0 transition-colors">
                  <i class="fa-solid fa-shield-halved text-lg"></i>
                </div>
                <div class="space-y-1 flex-1">
                  <div class="flex items-center justify-between">
                    <h3 class="ty-h4 text-brand-dark">Verzekeringen</h3>
                    <span class="text-slate-300 group-hover:text-brand-dark group-hover:translate-x-1 transition-all">→</span>
                  </div>
                  <p class="ty-body text-slate-600">
                    Wonen, gezin, auto, AOV of een vrijblijvende bespaarcheck op je pakket.
                  </p>
                </div>
              </button>

              <!-- Optie 3: Belastingaangifte -->
              <button 
                type="button"
                data-select-topic="belastingaangifte"
                data-topic-label="Belastingaangifte"
                class="topic-card group text-left p-5 sm:p-6 rounded-2xl border-2 border-slate-200/80 hover:border-brand-dark bg-white hover:bg-[#153b68]/[0.02] transition-all duration-200 flex items-start gap-4 cursor-pointer shadow-xs hover:shadow-md"
              >
                <div class="w-12 h-12 rounded-2xl bg-[#ffce76]/35 border border-[#ffce76] group-hover:bg-brand-dark group-hover:border-brand-dark text-brand-dark group-hover:text-[#ffce76] flex items-center justify-center shrink-0 transition-colors">
                  <i class="fa-solid fa-file-invoice-dollar text-lg"></i>
                </div>
                <div class="space-y-1 flex-1">
                  <div class="flex items-center justify-between">
                    <h3 class="ty-h4 text-brand-dark">Belastingaangifte</h3>
                    <span class="text-slate-300 group-hover:text-brand-dark group-hover:translate-x-1 transition-all">→</span>
                  </div>
                  <p class="ty-body text-slate-600">
                    Inkomstenbelasting, voorlopige aanslag, toeslagen of ondernemersaangifte.
                  </p>
                </div>
              </button>

              <!-- Optie 4: Vermogen & Pensioen -->
              <button 
                type="button"
                data-select-topic="vermogen"
                data-topic-label="Vermogen & Pensioen"
                class="topic-card group text-left p-5 sm:p-6 rounded-2xl border-2 border-slate-200/80 hover:border-brand-dark bg-white hover:bg-[#153b68]/[0.02] transition-all duration-200 flex items-start gap-4 cursor-pointer shadow-xs hover:shadow-md"
              >
                <div class="w-12 h-12 rounded-2xl bg-[#ffce76]/35 border border-[#ffce76] group-hover:bg-brand-dark group-hover:border-brand-dark text-brand-dark group-hover:text-[#ffce76] flex items-center justify-center shrink-0 transition-colors">
                  <i class="fa-solid fa-chart-line text-lg"></i>
                </div>
                <div class="space-y-1 flex-1">
                  <div class="flex items-center justify-between">
                    <h3 class="ty-h4 text-brand-dark">Vermogen &amp; Pensioen</h3>
                    <span class="text-slate-300 group-hover:text-brand-dark group-hover:translate-x-1 transition-all">→</span>
                  </div>
                  <p class="ty-body text-slate-600">
                    Vermogen opbouwen, pensioen aanvullen, lijfrente of financiële planning.
                  </p>
                </div>
              </button>
            </div>
          </div>

          <!-- ==========================================
               STAP 2: SPECIFIEKE SITUATIE (DYNAMISCH)
               ========================================== -->
          <div class="funnel-step hidden" data-step="2">
            <div class="space-y-2.5 mb-7 sm:mb-8">
              <h2 class="ty-h2 text-brand-dark">Wat past het beste bij jouw situatie?</h2>
              <p class="ty-lead text-slate-600">
                Selecteer de optie die het beste aansluit op jouw vraag.
              </p>
            </div>

            <div id="step2-options-container" class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
              <!-- Populated dynamically by JS based on Step 1 -->
            </div>
          </div>

          <!-- ==========================================
               STAP 3: GEWENSTE TERMIJN
               ========================================== -->
          <div class="funnel-step hidden" data-step="3">
            <div class="space-y-2.5 mb-7 sm:mb-8">
              <h2 class="ty-h2 text-brand-dark">Op welke termijn speelt dit voor jou?</h2>
              <p class="ty-lead text-slate-600">
                Zo weten we of er haast bij is (bijvoorbeeld bij een bod op een woning of een lopende deadline).
              </p>
            </div>

            <div class="space-y-3.5">
              <button 
                type="button"
                data-select-timeline="Zo snel mogelijk (concrete actie of woning)"
                class="timeline-card group w-full text-left p-5 rounded-2xl border-2 border-slate-200/80 hover:border-brand-dark bg-white hover:bg-[#153b68]/[0.02] transition-all duration-200 flex items-center justify-between gap-4 cursor-pointer shadow-xs"
              >
                <div class="flex items-center gap-4">
                  <div class="w-11 h-11 rounded-2xl bg-[#ffce76]/35 border border-[#ffce76] group-hover:bg-brand-dark group-hover:border-brand-dark text-brand-dark group-hover:text-[#ffce76] flex items-center justify-center shrink-0 transition-colors">
                    <i class="fa-solid fa-bolt text-base"></i>
                  </div>
                  <div>
                    <h4 class="ty-h4 text-brand-dark">Zo snel mogelijk</h4>
                    <p class="ty-body text-slate-600">Ik heb al een concrete woning, deadline of vraag op het oog</p>
                  </div>
                </div>
                <span class="text-slate-300 group-hover:text-brand-dark group-hover:translate-x-1 transition-all font-semibold">→</span>
              </button>

              <button 
                type="button"
                data-select-timeline="Binnen 1 tot 3 maanden"
                class="timeline-card group w-full text-left p-5 rounded-2xl border-2 border-slate-200/80 hover:border-brand-dark bg-white hover:bg-[#153b68]/[0.02] transition-all duration-200 flex items-center justify-between gap-4 cursor-pointer shadow-xs"
              >
                <div class="flex items-center gap-4">
                  <div class="w-11 h-11 rounded-2xl bg-[#ffce76]/35 border border-[#ffce76] group-hover:bg-brand-dark group-hover:border-brand-dark text-brand-dark group-hover:text-[#ffce76] flex items-center justify-center shrink-0 transition-colors">
                    <i class="fa-regular fa-calendar-check text-base"></i>
                  </div>
                  <div>
                    <h4 class="ty-h4 text-brand-dark">Binnen 1 tot 3 maanden</h4>
                    <p class="ty-body text-slate-600">Ik wil binnenkort stappen zetten en goed voorbereid zijn</p>
                  </div>
                </div>
                <span class="text-slate-300 group-hover:text-brand-dark group-hover:translate-x-1 transition-all font-semibold">→</span>
              </button>

              <button 
                type="button"
                data-select-timeline="Oriënterend (eerst inzicht in mogelijkheden)"
                class="timeline-card group w-full text-left p-5 rounded-2xl border-2 border-slate-200/80 hover:border-brand-dark bg-white hover:bg-[#153b68]/[0.02] transition-all duration-200 flex items-center justify-between gap-4 cursor-pointer shadow-xs"
              >
                <div class="flex items-center gap-4">
                  <div class="w-11 h-11 rounded-2xl bg-[#ffce76]/35 border border-[#ffce76] group-hover:bg-brand-dark group-hover:border-brand-dark text-brand-dark group-hover:text-[#ffce76] flex items-center justify-center shrink-0 transition-colors">
                    <i class="fa-regular fa-compass text-base"></i>
                  </div>
                  <div>
                    <h4 class="ty-h4 text-brand-dark">Ik oriënteer me rustig</h4>
                    <p class="ty-body text-slate-600">Ik wil eerst vrijblijvend weten wat mijn financiële mogelijkheden zijn</p>
                  </div>
                </div>
                <span class="text-slate-300 group-hover:text-brand-dark group-hover:translate-x-1 transition-all font-semibold">→</span>
              </button>
            </div>
          </div>

          <!-- ==========================================
               STAP 4: VOORKEUR KENNISMAKING / AFSPRAAK
               ========================================== -->
          <div class="funnel-step hidden" data-step="4">
            <div class="space-y-2.5 mb-7 sm:mb-8">
              <h2 class="ty-h2 text-brand-dark">Hoe wil je het liefst afspreken?</h2>
              <p class="ty-lead text-slate-600">
                Ons eerste oriëntatiegesprek is altijd gratis en 100% vrijblijvend. Kies wat jij het prettigst vindt.
              </p>
            </div>

            <div class="space-y-3.5">
              <button 
                type="button"
                data-select-preference="Op kantoor in Moerkapelle (Herenweg 42)"
                class="preference-card group w-full text-left p-5 rounded-2xl border-2 border-slate-200/80 hover:border-brand-dark bg-white hover:bg-[#153b68]/[0.02] transition-all duration-200 flex items-center justify-between gap-4 cursor-pointer shadow-xs"
              >
                <div class="flex items-center gap-4">
                  <div class="w-11 h-11 rounded-2xl bg-[#ffce76]/35 border border-[#ffce76] group-hover:bg-brand-dark group-hover:border-brand-dark text-brand-dark group-hover:text-[#ffce76] flex items-center justify-center shrink-0 transition-colors">
                    <i class="fa-solid fa-mug-hot text-base"></i>
                  </div>
                  <div>
                    <h4 class="ty-h4 text-brand-dark">Op kantoor in Moerkapelle</h4>
                    <p class="ty-body text-slate-600">Aan de Herenweg 42 onder het genot van een goede kop koffie (ook 's avonds mogelijk)</p>
                  </div>
                </div>
                <span class="text-slate-300 group-hover:text-brand-dark group-hover:translate-x-1 transition-all font-semibold">→</span>
              </button>

              <button 
                type="button"
                data-select-preference="Persoonlijk bij mij thuis"
                class="preference-card group w-full text-left p-5 rounded-2xl border-2 border-slate-200/80 hover:border-brand-dark bg-white hover:bg-[#153b68]/[0.02] transition-all duration-200 flex items-center justify-between gap-4 cursor-pointer shadow-xs"
              >
                <div class="flex items-center gap-4">
                  <div class="w-11 h-11 rounded-2xl bg-[#ffce76]/35 border border-[#ffce76] group-hover:bg-brand-dark group-hover:border-brand-dark text-brand-dark group-hover:text-[#ffce76] flex items-center justify-center shrink-0 transition-colors">
                    <i class="fa-solid fa-house-user text-base"></i>
                  </div>
                  <div>
                    <h4 class="ty-h4 text-brand-dark">Persoonlijk bij mij thuis</h4>
                    <p class="ty-body text-slate-600">Gewoon bij jou aan de keukentafel in Moerkapelle en omliggende gemeenten</p>
                  </div>
                </div>
                <span class="text-slate-300 group-hover:text-brand-dark group-hover:translate-x-1 transition-all font-semibold">→</span>
              </button>

              <button 
                type="button"
                data-select-preference="Eerst kort telefonisch of digitaal sparren (15 min)"
                class="preference-card group w-full text-left p-5 rounded-2xl border-2 border-slate-200/80 hover:border-brand-dark bg-white hover:bg-[#153b68]/[0.02] transition-all duration-200 flex items-center justify-between gap-4 cursor-pointer shadow-xs"
              >
                <div class="flex items-center gap-4">
                  <div class="w-11 h-11 rounded-2xl bg-[#ffce76]/35 border border-[#ffce76] group-hover:bg-brand-dark group-hover:border-brand-dark text-brand-dark group-hover:text-[#ffce76] flex items-center justify-center shrink-0 transition-colors">
                    <i class="fa-solid fa-phone-volume text-base"></i>
                  </div>
                  <div>
                    <h4 class="ty-h4 text-brand-dark">Eerst kort telefonisch sparren</h4>
                    <p class="ty-body text-slate-600">Even 15 minuten bellen met Martin om snel je vragen en cijfers door te nemen</p>
                  </div>
                </div>
                <span class="text-slate-300 group-hover:text-brand-dark group-hover:translate-x-1 transition-all font-semibold">→</span>
              </button>
            </div>
          </div>

          <!-- ==========================================
               STAP 5: CONTACTGEGEVENS & VERZENDEN
               ========================================== -->
          <div class="funnel-step hidden" data-step="5">
            <div class="space-y-2.5 mb-6">
              <h2 class="ty-h2 text-brand-dark">Hoe kunnen we je bereiken?</h2>
              <p class="ty-lead text-slate-600">
                Vul je gegevens in, dan neemt Martin van der Spek binnen 24 uur persoonlijk contact met je op om de afspraak te bevestigen.
              </p>
            </div>

            <!-- Selected Summary Box in Spekadvies Blue & Gold -->
            <div class="bg-[#153b68]/[0.04] border border-[#153b68]/15 rounded-2xl p-4 mb-6 flex flex-wrap items-center gap-2">
              <span class="ty-small font-semibold text-brand-dark mr-1">Jouw keuzes:</span>
              <span id="summary-pill-topic" class="ty-small bg-white border border-[#153b68]/15 px-3 py-1 rounded-full text-brand-dark font-medium"></span>
              <span id="summary-pill-situation" class="ty-small bg-white border border-[#153b68]/15 px-3 py-1 rounded-full text-brand-dark font-medium"></span>
              <span id="summary-pill-preference" class="ty-small bg-[#ffce76]/35 border border-[#ffce76] px-3 py-1 rounded-full text-brand-dark font-semibold"></span>
            </div>

            <form id="interactive-funnel-form" class="space-y-5">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="funnel-name" class="block ty-small font-semibold text-brand-dark mb-1.5">Voor- en achternaam *</label>
                  <input 
                    type="text" 
                    id="funnel-name" 
                    name="name" 
                    placeholder="Bijv. Jan de Vries" 
                    required
                    class="w-full bg-slate-50/70 border border-slate-300/90 rounded-xl px-4 py-3.5 text-sm text-brand-dark placeholder-slate-400 focus:outline-none focus:border-brand-dark focus:bg-white transition-all font-sans"
                  />
                </div>
                <div>
                  <label for="funnel-phone" class="block ty-small font-semibold text-brand-dark mb-1.5">Telefoonnummer *</label>
                  <input 
                    type="tel" 
                    id="funnel-phone" 
                    name="phone" 
                    placeholder="Bijv. 06 - 12345678" 
                    required
                    class="w-full bg-slate-50/70 border border-slate-300/90 rounded-xl px-4 py-3.5 text-sm text-brand-dark placeholder-slate-400 focus:outline-none focus:border-brand-dark focus:bg-white transition-all font-sans"
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="funnel-email" class="block ty-small font-semibold text-brand-dark mb-1.5">E-mailadres *</label>
                  <input 
                    type="email" 
                    id="funnel-email" 
                    name="email" 
                    placeholder="naam@voorbeeld.nl" 
                    required
                    class="w-full bg-slate-50/70 border border-slate-300/90 rounded-xl px-4 py-3.5 text-sm text-brand-dark placeholder-slate-400 focus:outline-none focus:border-brand-dark focus:bg-white transition-all font-sans"
                  />
                </div>
                <div>
                  <label for="funnel-city" class="block ty-small font-semibold text-brand-dark mb-1.5">Woonplaats <span class="text-slate-400 font-normal">(Optioneel)</span></label>
                  <input 
                    type="text" 
                    id="funnel-city" 
                    name="city" 
                    placeholder="Bijv. Moerkapelle, Zevenhuizen, Gouda..." 
                    class="w-full bg-slate-50/70 border border-slate-300/90 rounded-xl px-4 py-3.5 text-sm text-brand-dark placeholder-slate-400 focus:outline-none focus:border-brand-dark focus:bg-white transition-all font-sans"
                  />
                </div>
              </div>

              <div>
                <label for="funnel-message" class="block ty-small font-semibold text-brand-dark mb-1.5">Wil je alvast iets meegeven? <span class="text-slate-400 font-normal">(Optioneel)</span></label>
                <textarea 
                  id="funnel-message" 
                  name="message" 
                  rows="2" 
                  placeholder="Bijv. voorkeursdag/tijdstip of een korte toelichting op je vraag..." 
                  class="w-full bg-slate-50/70 border border-slate-300/90 rounded-xl px-4 py-3 text-sm text-brand-dark placeholder-slate-400 focus:outline-none focus:border-brand-dark focus:bg-white transition-all font-sans resize-none"
                ></textarea>
              </div>

              <div class="pt-2">
                <button 
                  type="submit" 
                  id="funnel-submit-btn"
                  class="btn-primary w-full group inline-flex items-center justify-center gap-3.5 px-8 py-4 rounded-full bg-brand-dark hover:bg-slate-900 text-white shadow-lg shadow-brand-dark/15 hover:shadow-xl hover:-translate-y-0.5 transition-all duration-300 cursor-pointer"
                >
                  <span>Plan een afspraak</span>
                  <span class="w-7 h-7 rounded-full bg-white/15 group-hover:bg-[#ffce76] group-hover:text-brand-dark flex items-center justify-center transition-all duration-300 shrink-0">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M3 8H13M13 8L8.5 3.5M13 8L8.5 12.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                </button>
              </div>

              <div id="funnel-error" class="hidden ty-small text-red-600 font-semibold text-center pt-1"></div>
            </form>
          </div>

          <!-- ==========================================
               SUCCES SCHERM NA VERZENDING
               ========================================== -->
          <div id="funnel-success-step" class="hidden text-center py-8 sm:py-12 space-y-5">
            <div class="w-16 h-16 rounded-full bg-[#ffce76]/35 border-2 border-[#ffce76] text-brand-dark flex items-center justify-center text-2xl mx-auto shadow-xs">
              <i class="fa-solid fa-check"></i>
            </div>
            <div class="space-y-2.5 max-w-lg mx-auto">
              <h2 class="ty-h2 text-brand-dark">Bedankt! We gaan direct voor je aan de slag.</h2>
              <p class="ty-lead text-slate-600">
                Martin van der Spek heeft je antwoorden ontvangen en neemt binnen 24 uur persoonlijk contact met je op om de afspraak definitief in te plannen.
              </p>
            </div>
            <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-3.5">
              <a 
                href="/" 
                class="btn-primary inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full bg-brand-dark text-white hover:bg-slate-900 transition-all"
              >
                <span>Terug naar de homepage</span>
              </a>
              <a 
                href={`tel:${COMPANY_DATA.contact.phoneRaw}`} 
                class="btn-secondary inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-slate-100 text-brand-dark border border-slate-200/80 hover:bg-white transition-all"
              >
                <i class="fa-solid fa-phone text-xs text-brand-dark"></i>
                <span>Direct bellen: {COMPANY_DATA.contact.phone}</span>
              </a>
            </div>
          </div>

          <!-- ==========================================
               TELLER BALK ONDERAAN IN DE KAART (1.200+ KLANTEN GEHOLPEN)
               ========================================== -->
          <div class="mt-8 pt-6 border-t border-slate-100 grid grid-cols-3 gap-3 sm:gap-6 text-center">
            <div>
              <div class="ty-stat text-brand-dark flex items-baseline justify-center">
                <span id="klanten-counter" data-target="1200">1.200</span><span>+</span>
              </div>
              <div class="ty-small text-slate-500 mt-0.5">Klanten geholpen</div>
            </div>
            <div class="border-x border-slate-100 px-2">
              <div class="ty-stat text-brand-dark">40+</div>
              <div class="ty-small text-slate-500 mt-0.5">Aanbieders vergeleken</div>
            </div>
            <div>
              <div class="ty-stat text-brand-dark flex items-baseline justify-center gap-1">
                <span>9.4</span>
                <span class="text-[#ffce76] text-base sm:text-lg">★</span>
              </div>
              <div class="ty-small text-slate-500 mt-0.5">Klantwaardering</div>
            </div>
          </div>

        </div>

        <!-- Bottom E-E-A-T Trust Strip (Zonder pill, direct op de achtergrond) -->
        <div class="mt-6 relative z-10 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 ty-small text-brand-dark text-center">
          <span class="flex items-center gap-1.5 font-medium">
            <span class="w-4 h-4 rounded-full bg-[#ffce76] text-brand-dark inline-flex items-center justify-center text-[10px] font-semibold">✓</span>
            <span>100% Vrijblijvend oriëntatiegesprek</span>
          </span>
          <span class="flex items-center gap-1.5 font-medium">
            <span class="w-4 h-4 rounded-full bg-[#ffce76] text-brand-dark inline-flex items-center justify-center text-[10px] font-semibold">✓</span>
            <span>Onafhankelijk financieel advies</span>
          </span>
          <span class="flex items-center gap-1.5 font-medium">
            <span class="w-4 h-4 rounded-full bg-[#ffce76] text-brand-dark inline-flex items-center justify-center text-[10px] font-semibold">✓</span>
            <span>AFM-vergunning: {COMPANY_DATA.accreditations.afm}</span>
          </span>
        </div>

      </div>

      <SectionDivider fillColor="#153b68" direction="left-high" />
    </main>

    <Footer />
  </div>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const situationsByTopic = {
      hypotheken: [
        { label: 'Eerste woning kopen (Starter)', desc: 'Bereken je maximale hypotheek & starterslening', icon: 'fa-solid fa-key' },
        { label: 'Verhuizen naar een volgende woning', desc: 'Doorstromen, overbrugging & verhuisregeling', icon: 'fa-solid fa-truck-fast' },
        { label: 'Bestaande hypotheek oversluiten', desc: 'Lagere maandlasten of betere voorwaarden', icon: 'fa-solid fa-arrows-rotate' },
        { label: 'Verbouwen, verduurzamen of overwaarde', desc: 'Financiering voor uitbouw, verduurzaming of opname', icon: 'fa-solid fa-hammer' },
        { label: 'Hypotheek als ZZP\'er / ondernemer', desc: 'Zakelijk inkomen optimaal meenemen vanaf 1 jaar', icon: 'fa-solid fa-briefcase' },
        { label: 'Uit elkaar gaan & woning behouden', desc: 'Hoofdelijke ontslag & uitkoop berekenen', icon: 'fa-solid fa-scale-balanced' }
      ],
      verzekeringen: [
        { label: 'Pakketcheck op bestaande verzekeringen', desc: 'Kijk of je kunt besparen met betere dekking', icon: 'fa-solid fa-magnifying-glass-dollar' },
        { label: 'Woon-, gezins- of autoverzekering', desc: 'Opstal, inboedel, aansprakelijkheid of auto', icon: 'fa-solid fa-house-lock' },
        { label: 'AOV of zakelijke verzekeringen', desc: 'Arbeidsongeschiktheid en bedrijfsrisico\'s voor ZZP/MKB', icon: 'fa-solid fa-briefcase-medical' },
        { label: 'Overlijdensrisico- of woonlastenverzekering', desc: 'Financiële zekerheid voor je partner en gezin', icon: 'fa-solid fa-heart-shield' }
      ],
      belastingaangifte: [
        { label: 'Particuliere aangifte inkomstenbelasting', desc: 'Individueel of samen met je fiscaal partner', icon: 'fa-solid fa-user-check' },
        { label: 'Aangifte in jaar van huisaankoop / verbouwing', desc: 'Haal het maximale uit je hypotheekrenteaftrek', icon: 'fa-solid fa-house-circle-check' },
        { label: 'Voorlopige aanslag of toeslagen wijzigen', desc: 'Direct maandelijks terugkrijgen of bijstellen', icon: 'fa-solid fa-sliders' },
        { label: 'Fiscale aangifte voor ZZP / ondernemer', desc: 'Inkomstenbelasting en aftrekposten voor ondernemers', icon: 'fa-solid fa-building' }
      ],
      vermogen: [
        { label: 'Verstandig vermogen opbouwen', desc: 'Sparen en beleggen voor later met persoonlijk plan', icon: 'fa-solid fa-seedling' },
        { label: 'Pensioen aanvullen of lijfrente regelen', desc: 'Fiscaal voordelig extra inkomen voor later opbouwen', icon: 'fa-solid fa-umbrella-beach' },
        { label: 'Overwaarde benutten voor extra inkomen', desc: 'Verzilver de waarde van je woning zorgeloos', icon: 'fa-solid fa-coins' },
        { label: 'Financiële planning of schenken', desc: 'Helder overzicht voor je toekomst of je kinderen', icon: 'fa-solid fa-sitemap' }
      ]
    };

    const topicLabels = {
      hypotheken: 'Hypotheek & Wonen',
      verzekeringen: 'Verzekeringen',
      belastingaangifte: 'Belastingaangifte',
      vermogen: 'Vermogen & Pensioen'
    };

    const state = {
      step: 1,
      serviceType: 'hypotheken',
      topicLabel: 'Hypotheek & Wonen',
      situation: '',
      timeline: '',
      preference: ''
    };

    const steps = document.querySelectorAll('.funnel-step');
    const prevBtn = document.getElementById('funnel-prev-btn');
    const stepIndicator = document.getElementById('funnel-step-indicator');
    const progressBar = document.getElementById('funnel-progress-bar');
    const progressWrapper = document.getElementById('funnel-progress-wrapper');
    const step2Container = document.getElementById('step2-options-container');
    const step2Eyebrow = document.getElementById('step2-eyebrow');

    const summaryTopic = document.getElementById('summary-pill-topic');
    const summarySituation = document.getElementById('summary-pill-situation');
    const summaryPreference = document.getElementById('summary-pill-preference');

    function renderStep2Options(topicKey) {
      if (!step2Container) return;
      const items = situationsByTopic[topicKey] || situationsByTopic.hypotheken;
      if (step2Eyebrow) {
        step2Eyebrow.textContent = topicLabels[topicKey] || 'Jouw situatie';
      }
      step2Container.innerHTML = items.map((item) => `
        <button 
          type="button"
          data-select-situation="${item.label.replace(/"/g, '&quot;')}"
          class="situation-card group text-left p-4 sm:p-5 rounded-2xl border-2 border-slate-200/80 hover:border-brand-dark bg-white hover:bg-[#153b68]/[0.02] transition-all duration-200 flex items-start gap-3.5 cursor-pointer shadow-xs hover:shadow-md"
        >
          <div class="w-10 h-10 rounded-xl bg-[#ffce76]/35 border border-[#ffce76] group-hover:bg-brand-dark group-hover:border-brand-dark text-brand-dark group-hover:text-[#ffce76] flex items-center justify-center shrink-0 transition-colors mt-0.5">
            <i class="${item.icon} text-sm"></i>
          </div>
          <div class="space-y-0.5 flex-1">
            <div class="flex items-center justify-between gap-2">
              <h4 class="ty-h4 text-brand-dark">${item.label}</h4>
              <span class="text-slate-300 group-hover:text-brand-dark group-hover:translate-x-1 transition-all shrink-0">→</span>
            </div>
            <p class="ty-body text-slate-600">${item.desc}</p>
          </div>
        </button>
      `).join('');

      step2Container.querySelectorAll('[data-select-situation]').forEach((btn) => {
        btn.addEventListener('click', () => {
          state.situation = btn.getAttribute('data-select-situation') || '';
          goToStep(3);
        });
      });
    }

    function goToStep(stepNumber) {
      state.step = stepNumber;
      steps.forEach((el) => {
        const s = parseInt(el.getAttribute('data-step') || '0', 10);
        if (s === stepNumber) {
          el.classList.remove('hidden');
        } else {
          el.classList.add('hidden');
        }
      });

      if (prevBtn) {
        if (stepNumber > 1) {
          prevBtn.classList.remove('invisible');
        } else {
          prevBtn.classList.add('invisible');
        }
      }

      if (stepIndicator) {
        stepIndicator.textContent = `Stap ${stepNumber} van 5`;
      }

      if (progressBar) {
        progressBar.style.width = `${stepNumber * 20}%`;
      }

      if (stepNumber === 5) {
        if (summaryTopic) summaryTopic.textContent = state.topicLabel;
        if (summarySituation) summarySituation.textContent = state.situation;
        if (summaryPreference) summaryPreference.textContent = state.preference;
      }

      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Bind Step 1 buttons
    document.querySelectorAll('[data-select-topic]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const topic = btn.getAttribute('data-select-topic') || 'hypotheken';
        const label = btn.getAttribute('data-topic-label') || 'Hypotheek & Wonen';
        state.serviceType = topic;
        state.topicLabel = label;
        renderStep2Options(topic);
        goToStep(2);
      });
    });

    // Bind Step 3 buttons
    document.querySelectorAll('[data-select-timeline]').forEach((btn) => {
      btn.addEventListener('click', () => {
        state.timeline = btn.getAttribute('data-select-timeline') || '';
        goToStep(4);
      });
    });

    // Bind Step 4 buttons
    document.querySelectorAll('[data-select-preference]').forEach((btn) => {
      btn.addEventListener('click', () => {
        state.preference = btn.getAttribute('data-select-preference') || '';
        goToStep(5);
      });
    });

    // Bind Back button
    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        if (state.step > 1) {
          goToStep(state.step - 1);
        }
      });
    }

    // Check URL parameter ?onderwerp=hypotheken|verzekeringen|belastingaangifte|vermogen
    const params = new URLSearchParams(window.location.search);
    const preselectedTopic = (params.get('onderwerp') || '').toLowerCase();
    if (preselectedTopic && situationsByTopic[preselectedTopic]) {
      state.serviceType = preselectedTopic;
      state.topicLabel = topicLabels[preselectedTopic] || 'Hypotheek & Wonen';
      renderStep2Options(preselectedTopic);
      goToStep(2);
    }

    // Form Submission to /api/contact.php (GoHighLevel + Email Backup)
    const form = document.getElementById('interactive-funnel-form');
    const submitBtn = document.getElementById('funnel-submit-btn');
    const errorDiv = document.getElementById('funnel-error');
    const successStep = document.getElementById('funnel-success-step');

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerHTML = '<span>Aanvraag wordt verzonden...</span>';
        }
        if (errorDiv) {
          errorDiv.classList.add('hidden');
          errorDiv.textContent = '';
        }

        const formData = new FormData(form);
        const userMessage = (formData.get('message') || '').toString().trim();
        const city = (formData.get('city') || '').toString().trim();

        const payload = {
          name: formData.get('name'),
          phone: formData.get('phone'),
          email: formData.get('email'),
          city: city,
          'service-type': state.serviceType,
          situation: state.situation,
          timeline: state.timeline,
          preference: state.preference,
          message: userMessage
        };

        const endpoints = ['/api/contact', '/api/contact.php', '/contact.php'];
        let success = false;

        for (const url of endpoints) {
          try {
            const response = await fetch(url, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
              },
              body: JSON.stringify(payload)
            });

            if (response.ok) {
              const data = await response.json();
              if (data && data.success === true) {
                success = true;
                break;
              }
            }
          } catch (err) {
            // Try next endpoint (e.g. if static server returned raw PHP text instead of JSON)
          }
        }

        if (success) {
          steps.forEach((el) => el.classList.add('hidden'));
          if (progressWrapper) progressWrapper.classList.add('hidden');
          if (progressBar) progressBar.style.width = '100%';
          if (successStep) successStep.classList.remove('hidden');
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } else {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<span>Plan een afspraak</span>';
          }
          if (errorDiv) {
            errorDiv.classList.remove('hidden');
            errorDiv.textContent = 'Er ging iets mis bij het verzenden. Bel ons gerust direct op 079 593 1241.';
          }
        }
      });
    }

    // Smooth count-up animation for 1.200+ klanten geholpen
    const counterEl = document.getElementById('klanten-counter');
    if (counterEl) {
      const target = parseInt(counterEl.getAttribute('data-target') || '1200', 10);
      const duration = 1100;
      const startTime = performance.now();
      const tick = (now) => {
        const elapsed = now - startTime;
        const progress = Math.min(elapsed / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        const current = Math.round(eased * target);
        counterEl.textContent = current.toLocaleString('nl-NL');
        if (progress < 1) {
          requestAnimationFrame(tick);
        }
      };
      requestAnimationFrame(tick);
    }
  });
</script>
