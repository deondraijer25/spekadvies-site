---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqSchema from '../../components/FaqSchema.astro';
import RatingsClaim from '../../components/RatingsClaim.astro';
import ContactForm from '../../components/ContactForm.astro';
import Footer from '../../components/Footer.astro';
import { COMPANY_DATA } from '../../data/company';

// Generate static paths for all services
export async function getStaticPaths() {
  const dienstenEntries = await getCollection('diensten');
  return dienstenEntries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { 
  name, 
  seoTitle, 
  seoDescription, 
  heroTitle, 
  heroSubtitle, 
  ctaText, 
  category = 'hypotheken',
  usps, 
  statsBento,
  comparisonTable,
  expertTips,
  problemsTitle, 
  problems, 
  reviewQuote,
  faqItems, 
  articleBlocks 
} = entry.data;

const { Content } = await render(entry);

// Unified 3-card array under hero: exactly 1 section with 1 background and uniform sizing
const featureCards = (usps && usps.length > 0)
  ? usps.slice(0, 3).map((usp, idx) => ({
      icon: usp.icon || (idx === 0 ? "fa-solid fa-scale-balanced" : idx === 1 ? "fa-solid fa-calculator" : "fa-solid fa-piggy-bank"),
      badge: statsBento && statsBento[idx] ? statsBento[idx].stat : null,
      title: usp.title,
      description: usp.description
    }))
  : (statsBento && statsBento.length > 0)
    ? statsBento.slice(0, 3).map((bento) => ({
        icon: "fa-solid fa-check",
        badge: bento.stat,
        title: bento.label,
        description: bento.detail
      }))
    : [];
---

<Layout title={seoTitle} description={seoDescription}>
  <!-- Schema.org FAQPage Structured Data -->
  {faqItems && faqItems.length > 0 && <FaqSchema faqs={faqItems} />}

  <Navbar />
  <Breadcrumbs />
  
  <main class="relative z-10 flex-grow bg-white">

    <!-- [SECTIE 1] HERO HEADER -->
    <section 
      class="relative py-20 sm:py-28 lg:py-32 bg-brand-dark bg-center bg-cover bg-no-repeat overflow-hidden rounded-b-[40px] sm:rounded-b-[56px] lg:rounded-b-[72px] shadow-2xl"
      style="background-image: linear-gradient(rgba(21, 59, 104, 0.88), rgba(11, 26, 47, 0.96)), url('https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1800&q=80');"
    >
      <!-- Soft ambient glow -->
      <div class="absolute left-1/2 -top-20 -translate-x-1/2 w-[600px] h-[300px] bg-brand-primary/10 blur-[120px] pointer-events-none rounded-full"></div>

      <div class="max-w-5xl mx-auto px-4 sm:px-8 text-center relative z-10">
        <!-- GEO Trust Badge -->
        <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-md text-brand-primary border border-white/20 text-[11px] font-semibold tracking-wider uppercase px-4 py-1.5 rounded-full mb-6 font-sans shadow-xs">
          <i class="fa-solid fa-location-dot text-xs text-brand-primary"></i>
          <span>Moerkapelle & Regio • 100% Onafhankelijk</span>
        </div>
        
        <h1 class="ty-h1 text-white mb-6 max-w-4xl mx-auto">
          {heroTitle}
        </h1>
        
        <p class="ty-lead text-slate-200 max-w-3xl mx-auto mb-10">
          {heroSubtitle}
        </p>
        
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a 
            href="/adviesgesprek"
            class="open-contact-drawer btn-primary-gold inline-flex items-center justify-center gap-2.5 bg-brand-primary hover:bg-brand-primary-hover text-brand-dark px-7 py-3.5 rounded-full shadow-[0_10px_25px_rgba(255,206,118,0.25)] hover:shadow-[0_14px_32px_rgba(255,206,118,0.35)] hover:-translate-y-0.5 transition-all duration-300 cursor-pointer w-full sm:w-auto text-center"
          >
            <span>Plan een afspraak</span>
            <i class="fa-solid fa-arrow-right text-xs"></i>
          </a>
          <a 
            href={`tel:${COMPANY_DATA.contact.phoneRaw}`}
            class="btn-secondary inline-flex items-center justify-center gap-2.5 bg-white/10 hover:bg-white/20 text-white px-6 py-3.5 rounded-full border border-white/20 backdrop-blur-xs hover:-translate-y-0.5 transition-all w-full sm:w-auto text-center"
          >
            <i class="fa-solid fa-phone text-xs"></i>
            <span>{COMPANY_DATA.contact.phoneDisplay}</span>
          </a>
        </div>
      </div>
    </section>

    <!-- [SECTIE 2] 3 KERNVOORDELEN / HIGHLIGHTS (UNIFIED 3 CARDS, 1 BACKGROUND) -->
    {featureCards && featureCards.length > 0 && (
      <section class="py-12 sm:py-16 bg-slate-50/70 border-b border-slate-200/60">
        <div class="max-w-7xl mx-auto px-4 sm:px-8 lg:px-12">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
            {featureCards.map((card) => (
              <div class="bg-white border border-slate-200/80 p-6 sm:p-8 rounded-2xl sm:rounded-3xl shadow-xs hover:shadow-md transition-all duration-300 flex flex-col justify-between">
                <div>
                  <div class="flex items-center justify-between mb-5">
                    <div class="w-12 h-12 rounded-2xl bg-amber-50 border border-amber-200/70 flex items-center justify-center text-amber-700 text-lg shadow-xs">
                      <i class={card.icon || "fa-solid fa-check"}></i>
                    </div>
                    {card.badge && (
                      <span class="inline-flex items-center px-3 py-1 rounded-full text-[11px] font-semibold tracking-wider font-sans bg-slate-100 text-brand-dark border border-slate-200/60">
                        {card.badge}
                      </span>
                    )}
                  </div>
                  <h3 class="text-base sm:text-lg font-semibold text-brand-dark !font-sans mb-2.5 leading-snug">
                    {card.title}
                  </h3>
                  <p class="text-xs sm:text-sm text-slate-600 font-sans font-normal leading-relaxed">
                    {card.description}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- [SECTIE 3] REDACTIONELE VERDIEPING MET VERGELIJKINGSTABEL & EXPERT TIPS -->
    <section class="py-14 sm:py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-8 lg:px-12">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
          
          <!-- Article Content (Clean Editorial Layout) -->
          <article class="lg:col-span-8 space-y-8">
            <div>
              <h2 class="text-2xl sm:text-3.5xl !font-sans font-semibold text-brand-dark tracking-tight leading-tight pb-4 border-b border-slate-100">
                Volledig inzicht in {name}
              </h2>
            </div>

            <!-- Main Prose Content -->
            <div class="prose prose-slate max-w-none prose-headings:!font-sans prose-headings:font-semibold prose-headings:text-brand-dark prose-p:text-slate-600 prose-p:leading-relaxed prose-p:text-sm sm:prose-p:text-base prose-strong:text-slate-900 prose-strong:font-semibold">
              <Content />
            </div>

            <!-- Structured Comparison Table (if provided) -->
            {comparisonTable && (
              <div class="mt-10 pt-8 border-t border-slate-100">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
                  <div>
                    <h3 class="text-lg sm:text-xl font-semibold text-brand-dark !font-sans">
                      {comparisonTable.title}
                    </h3>
                    {comparisonTable.description && (
                      <p class="text-xs sm:text-sm text-slate-500 mt-1 font-sans">{comparisonTable.description}</p>
                    )}
                  </div>
                  <!-- Mobile scroll hint badge -->
                  <div class="inline-flex items-center gap-1.5 text-[11px] text-slate-500 md:hidden bg-slate-100 px-3 py-1 rounded-full self-start font-sans">
                    <i class="fa-solid fa-arrows-left-right text-[10px]"></i>
                    <span>Veeg voor alle kolommen</span>
                  </div>
                </div>
                
                <div class="overflow-x-auto rounded-2xl border border-slate-200/80 shadow-xs bg-white">
                  <table class="w-full text-left border-collapse text-xs sm:text-sm font-sans min-w-[500px]">
                    <thead class="bg-slate-50 border-b border-slate-200/80 text-slate-700 font-semibold uppercase tracking-wider text-[11px]">
                      <tr>
                        {comparisonTable.headers.map((header) => (
                          <th class="p-4">{header}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                      {comparisonTable.rows.map((row) => (
                        <tr class="hover:bg-amber-50/20 transition-colors">
                          {row.map((cell, idx) => (
                            <td class={`p-4 text-slate-600 ${idx === 0 ? "font-semibold text-slate-900 bg-slate-50/40" : ""}`}>
                              {cell}
                            </td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            )}

            <!-- E-E-A-T Expert Tips from Martin van der Spek -->
            {expertTips && expertTips.length > 0 && (
              <div class="mt-10 pt-8 border-t border-slate-100 space-y-4">
                <div class="flex items-center gap-2.5 mb-3">
                  <div class="w-9 h-9 rounded-xl bg-amber-100/80 border border-amber-300/60 flex items-center justify-center text-amber-800 text-sm">
                    <i class="fa-solid fa-lightbulb"></i>
                  </div>
                  <h3 class="text-base sm:text-lg font-semibold text-brand-dark !font-sans">
                    Advies van Martin van der Spek (Erkend Hypothecair Planner)
                  </h3>
                </div>
                {expertTips.map((tip) => (
                  <div class="bg-gradient-to-br from-amber-50/60 to-white border border-amber-200/60 rounded-2xl p-5 sm:p-6 text-slate-700 font-sans shadow-xs">
                    <div class="font-semibold text-brand-dark mb-1.5 text-sm sm:text-base">{tip.title}</div>
                    <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">{tip.tip}</p>
                  </div>
                ))}
              </div>
            )}
            
            <!-- Article Sub-blocks -->
            {articleBlocks && articleBlocks.map((block) => (
              <div class="mt-8 pt-8 border-t border-slate-100">
                <h3 class="text-lg font-semibold text-brand-dark mb-2.5 !font-sans">{block.title}</h3>
                <p class="text-sm text-slate-600 leading-relaxed font-sans">{block.body}</p>
              </div>
            ))}
          </article>

          <!-- Sidebar (Calm, Premium Light Cards) -->
          <aside class="lg:col-span-4 space-y-6 lg:sticky lg:top-24">
            <!-- Aandachtspunten / Problems Check -->
            {problems && (
              <div class="bg-white border border-slate-200/80 p-6 sm:p-7 rounded-2xl sm:rounded-3xl shadow-xs">
                <div class="flex items-center gap-3 mb-5 pb-3 border-b border-slate-100">
                  <div class="w-8 h-8 rounded-xl bg-amber-50 border border-amber-200/80 text-amber-700 flex items-center justify-center text-xs shrink-0">
                    <i class="fa-solid fa-circle-info"></i>
                  </div>
                  <h3 class="text-base font-semibold text-brand-dark font-sans" style="font-family: var(--font-sans) !important;">
                    {problemsTitle || "Belangrijke Aandachtspunten"}
                  </h3>
                </div>
                <ul class="space-y-4">
                  {problems.map((prob, idx) => (
                    <li class="flex items-start gap-3.5">
                      <span class="flex-shrink-0 w-6 h-6 rounded-full bg-amber-50 border border-amber-200/70 text-amber-800 text-[11px] font-semibold font-sans flex items-center justify-center mt-0.5">
                        {String(idx + 1).padStart(2, '0')}
                      </span>
                      <div>
                        <h4 class="text-xs sm:text-sm font-semibold text-slate-900 mb-1 font-sans leading-snug" style="font-family: var(--font-sans) !important;">
                          {prob.title}
                        </h4>
                        <p class="text-slate-600 text-xs leading-relaxed font-sans font-normal">
                          {prob.description}
                        </p>
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <!-- Contact Card with Office Moerkapelle -->
            <div class="bg-white border border-slate-200/80 p-6 sm:p-7 rounded-2xl sm:rounded-3xl shadow-xs">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 rounded-xl bg-brand-dark text-brand-primary flex items-center justify-center text-sm shadow-xs shrink-0">
                  <i class="fa-solid fa-location-dot"></i>
                </div>
                <div>
                  <h3 class="text-base font-semibold text-brand-dark font-sans leading-tight" style="font-family: var(--font-sans) !important;">
                    Kantoor Moerkapelle
                  </h3>
                  <span class="text-[11px] text-emerald-700 font-medium font-sans">
                    <i class="fa-solid fa-circle-check text-[10px] mr-1"></i>Gratis parkeren voor de deur
                  </span>
                </div>
              </div>

              <p class="text-xs text-slate-600 leading-relaxed mb-4 font-sans">
                {COMPANY_DATA.address.street}<br/>
                {COMPANY_DATA.address.postalCode} {COMPANY_DATA.address.city}
              </p>

              <div class="space-y-2 pt-3 border-t border-slate-100 text-xs font-sans">
                <div class="flex justify-between items-center text-slate-600">
                  <span>Telefoon:</span>
                  <a href={`tel:${COMPANY_DATA.contact.phoneRaw}`} class="font-semibold text-brand-dark hover:text-amber-700 transition-colors">
                    {COMPANY_DATA.contact.phoneDisplay}
                  </a>
                </div>
                <div class="flex justify-between items-center text-slate-600">
                  <span>Openingstijden:</span>
                  <span class="font-medium text-slate-700">09:00 - 17:30</span>
                </div>
              </div>

              <a 
                href="/adviesgesprek"
                class="open-contact-drawer btn-primary w-full mt-5 bg-brand-dark hover:bg-slate-800 text-white py-3.5 px-4 rounded-full transition-colors cursor-pointer text-center inline-flex items-center justify-center gap-2"
              >
                <span>Plan een afspraak</span>
                <i class="fa-solid fa-calendar-check text-[11px]"></i>
              </a>
            </div>
          </aside>
          
        </div>
      </div>
    </section>

    <!-- [SECTIE 4] GEO FAQ ACCORDIONS (MET FAQPAGE SCHEMA) -->
    {faqItems && faqItems.length > 0 && (
      <section class="py-16 sm:py-20 bg-slate-50/70 border-t border-slate-200/60">
        <div class="max-w-4xl mx-auto px-4 sm:px-8">
          <div class="text-center mb-10">
            <h2 class="text-2xl sm:text-3.5xl !font-sans font-semibold text-brand-dark">Veelgestelde vragen over {name}</h2>
            <p class="text-xs sm:text-sm text-slate-500 mt-2 font-sans font-normal">Antwoorden volgens de richtlijnen van onze erkend hypothecair planner</p>
          </div>
          
          <div class="space-y-4">
            {faqItems.map((faq) => (
              <details class="group bg-white border border-slate-200/90 rounded-2xl p-5 sm:p-6 shadow-xs hover:border-slate-300 transition-all duration-300 [&_summary::-webkit-details-marker]:hidden">
                <summary class="flex justify-between items-center cursor-pointer select-none outline-none">
                  <span class="text-sm sm:text-base font-medium sm:font-semibold text-slate-800 font-sans leading-snug pr-4">{faq.question}</span>
                  <span class="w-8 h-8 rounded-full bg-slate-100 group-hover:bg-amber-100 group-open:rotate-180 transition-all duration-300 text-brand-dark flex items-center justify-center text-xs shrink-0">
                    <i class="fa-solid fa-chevron-down text-xs"></i>
                  </span>
                </summary>
                <div class="mt-4 text-slate-600 text-xs sm:text-sm leading-relaxed border-t border-slate-100 pt-4 font-sans font-normal">
                  {faq.answer}
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- [SECTIE 5] TESTIMONIALS & DOSSIER TRACKER MET BEWEGENDE REVIEWS -->
    <RatingsClaim />

    <!-- [SECTIE 6] CONTACT & LEAD INTAKE FORMULIER -->
    <ContactForm />

  </main>
  
  <Footer />
</Layout>
