---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Footer from '../../components/Footer.astro';

// Generate paths for each markdown file in src/content/diensten/
export async function getStaticPaths() {
  const dienstenEntries = await getCollection('diensten');
  return dienstenEntries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { name, seoTitle, seoDescription, heroTitle, heroSubtitle, ctaText, usps, problemsTitle, problems, faqItems, articleBlocks } = entry.data;
const { Content } = await render(entry);
---

<Layout title={seoTitle} description={seoDescription}>
  <Navbar />
  <Breadcrumbs />
  
  <main class="relative z-10 flex-grow bg-white">

    <!-- Hero Section with Background Image and Dark Gradient Overlay (matching hypotheken.astro) -->
    <section 
      class="relative py-24 sm:py-32 bg-[#153b68] bg-center bg-cover bg-no-repeat overflow-hidden rounded-b-[48px] sm:rounded-b-[64px] lg:rounded-b-[80px] shadow-xl"
      style="background-image: linear-gradient(rgba(21, 59, 104, 0.82), rgba(11, 26, 47, 0.94)), url('https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1800&q=80');"
    >
      <div class="max-w-4xl mx-auto px-6 sm:px-8 text-center relative z-10">
        <!-- Badge -->
        <span class="inline-block bg-white/10 text-brand-accent border border-white/10 text-[10px] font-semibold tracking-widest uppercase px-4 py-1.5 rounded-full mb-6 font-sans">
          Dienstverlening op maat
        </span>
        
        <h1 class="text-4xl sm:text-5xl lg:text-6.5xl font-bold text-white tracking-tight leading-tight font-display mb-6">
          {heroTitle}
        </h1>
        
        <p class="text-slate-300 text-base sm:text-lg leading-relaxed max-w-2xl mx-auto mb-10 font-sans font-normal">
          {heroSubtitle}
        </p>
        
        <div>
          <button 
            class="open-contact-drawer inline-block bg-brand-accent hover:bg-brand-accent/90 text-brand-dark font-semibold px-8 py-4 rounded-full shadow-lg transition-all duration-300 text-xs tracking-wider uppercase font-sans cursor-pointer"
          >
            {ctaText}
          </button>
        </div>
      </div>
    </section>

    <!-- USPs Section (matching hypotheken.astro white cards) -->
    {usps && usps.length > 0 && (
      <section class="py-16 bg-[#f8fafc] border-b border-slate-100">
        <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {usps.map((usp) => (
              <div class="bg-white border border-slate-200/80 p-8 rounded-3xl shadow-sm hover:shadow-md transition-shadow">
                <div class="w-12 h-12 rounded-xl bg-slate-100 flex items-center justify-center text-brand-dark text-xl mb-6">
                  <span class="text-brand-accent font-bold">✦</span>
                </div>
                <h3 class="text-base font-bold text-brand-dark font-display mb-3">{usp.title}</h3>
                <p class="text-sm text-slate-600 font-sans font-normal leading-relaxed">{usp.description}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Main Content and Problems Section -->
    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
          
          <!-- Article (Clean Light Prose Layout) -->
          <article class="lg:col-span-7 bg-white border border-slate-200/80 p-8 sm:p-10 rounded-3xl shadow-sm prose prose-slate prose-brand max-w-none">
            <h2 class="text-2xl sm:text-3xl font-bold text-brand-dark mb-6 border-b border-slate-100 pb-4 font-display">
              Alles over {name}
            </h2>
            <div class="text-slate-600 space-y-6 leading-relaxed font-sans font-normal">
              <Content />
            </div>
            
            {articleBlocks && articleBlocks.map((block) => (
              <div class="mt-8 pt-8 border-t border-slate-100">
                <h3 class="text-lg font-bold text-brand-dark mb-3 font-display">{block.title}</h3>
                <p class="text-sm text-slate-600 leading-relaxed font-sans font-normal">{block.body}</p>
              </div>
            ))}
          </article>

          <!-- Sidebar -->
          <aside class="lg:col-span-5 space-y-8">
            {problems && (
              <div class="bg-brand-dark border border-white/5 p-8 rounded-3xl shadow-xl text-white">
                <h3 class="text-xl font-bold text-white mb-6 font-display">
                  {problemsTitle || "Aandachtspunten"}
                </h3>
                <ul class="space-y-6">
                  {problems.map((prob) => (
                    <li class="flex items-start">
                      <span class="flex-shrink-0 w-8 h-8 rounded-lg bg-white/10 text-brand-accent flex items-center justify-center font-bold text-lg mr-4 mt-0.5 font-sans">
                        !
                      </span>
                      <div>
                        <h4 class="text-base font-semibold text-white mb-1 font-sans">{prob.title}</h4>
                        <p class="text-slate-300 text-sm leading-relaxed font-sans font-normal">{prob.description}</p>
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <!-- Lead Form (Light Grey/White Theme) -->
            <div id="contact" class="bg-[#f8fafc] border border-slate-200/60 p-8 rounded-3xl shadow-sm relative overflow-hidden">
              <h3 class="text-xl font-bold text-brand-dark mb-2 font-display">Kosteloze check aanvragen</h3>
              <p class="text-slate-600 text-sm mb-6 leading-relaxed font-sans font-normal">
                Laat je gegevens achter en onze specialist neemt binnen 24 uur contact met je op voor een onafhankelijke check.
              </p>
              <form class="space-y-4">
                <div>
                  <label for="form-name" class="block text-[10px] font-semibold text-slate-500 uppercase tracking-wider mb-1.5 font-sans">Naam</label>
                  <input type="text" id="form-name" name="name" placeholder="Jouw naam" class="w-full bg-white border border-slate-200 rounded-xl px-4 py-3 text-sm text-slate-700 placeholder-slate-400 focus:outline-none focus:border-brand-primary transition-colors font-sans" required />
                </div>
                <div>
                  <label for="form-phone" class="block text-[10px] font-semibold text-slate-500 uppercase tracking-wider mb-1.5 font-sans">Telefoonnummer</label>
                  <input type="tel" id="form-phone" name="phone" placeholder="06 - 12345678" class="w-full bg-white border border-slate-200 rounded-xl px-4 py-3 text-sm text-slate-700 placeholder-slate-400 focus:outline-none focus:border-brand-primary transition-colors font-sans" required />
                </div>
                <div>
                  <label for="form-email" class="block text-[10px] font-semibold text-slate-500 uppercase tracking-wider mb-1.5 font-sans">E-mailadres</label>
                  <input type="email" id="form-email" name="email" placeholder="naam@voorbeeld.nl" class="w-full bg-white border border-slate-200 rounded-xl px-4 py-3 text-sm text-slate-700 placeholder-slate-400 focus:outline-none focus:border-brand-primary transition-colors font-sans" required />
                </div>
                <button type="submit" class="w-full bg-brand-primary hover:bg-brand-primary-hover text-brand-dark font-semibold py-3.5 rounded-full shadow-md hover:shadow-lg transition-all mt-2 cursor-pointer text-sm font-sans">
                  Berekening starten
                </button>
              </form>
            </div>
          </aside>
          
        </div>
      </div>
    </section>

    <!-- FAQ Accordion Section -->
    {faqItems && faqItems.length > 0 && (
      <section class="py-20 bg-[#f8fafc] border-t border-slate-100">
        <div class="max-w-4xl mx-auto px-6 sm:px-8">
          <h2 class="text-2xl sm:text-3xl font-bold text-center text-brand-dark mb-10 font-display">Veelgestelde vragen over {name}</h2>
          <div class="space-y-4">
            {faqItems.map((faq, index) => (
              <details class="group bg-white border border-slate-200/80 rounded-2xl p-6 shadow-sm transition-all duration-300 [&_summary::-webkit-details-marker]:hidden">
                <summary class="flex justify-between items-center font-bold text-brand-dark cursor-pointer select-none outline-none font-display">
                  <span class="text-base sm:text-lg leading-snug">{faq.question}</span>
                  <span class="transition-transform duration-300 group-open:rotate-180 text-brand-accent font-bold text-xl ml-4">
                    ↓
                  </span>
                </summary>
                <p class="mt-4 text-slate-650 text-sm sm:text-base leading-relaxed border-t border-slate-100 pt-4 font-sans font-normal">
                  {faq.answer}
                </p>
              </details>
            ))}
          </div>
        </div>
      </section>
    )}

  </main>
  <Footer />
</Layout>
