---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqSchema from '../../components/FaqSchema.astro';
import Footer from '../../components/Footer.astro';
import { COMPANY_DATA } from '../../data/company';

// Generate static paths for all services
export async function getStaticPaths() {
  const dienstenEntries = await getCollection('diensten');
  return dienstenEntries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { 
  name, 
  seoTitle, 
  seoDescription, 
  heroTitle, 
  heroSubtitle, 
  ctaText, 
  category = 'hypotheken',
  usps, 
  statsBento,
  comparisonTable,
  expertTips,
  problemsTitle, 
  problems, 
  reviewQuote,
  faqItems, 
  articleBlocks 
} = entry.data;

const { Content } = await render(entry);
---

<Layout title={seoTitle} description={seoDescription}>
  <!-- Schema.org FAQPage Structured Data -->
  {faqItems && faqItems.length > 0 && <FaqSchema faqs={faqItems} />}

  <Navbar />
  <Breadcrumbs />
  
  <main class="relative z-10 flex-grow bg-white">

    <!-- [SECTIE 1] HERO HEADER -->
    <section 
      class="relative py-20 sm:py-28 bg-[#153b68] bg-center bg-cover bg-no-repeat overflow-hidden rounded-b-[40px] sm:rounded-b-[56px] lg:rounded-b-[72px] shadow-xl"
      style="background-image: linear-gradient(rgba(21, 59, 104, 0.85), rgba(11, 26, 47, 0.95)), url('https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1800&q=80');"
    >
      <div class="max-w-4xl mx-auto px-4 sm:px-8 text-center relative z-10">
        <!-- GEO Trust Badge -->
        <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-xs text-brand-accent border border-white/15 text-[11px] font-semibold tracking-wider uppercase px-4 py-1.5 rounded-full mb-6 font-sans">
          <span>📍</span>
          <span>Moerkapelle & Regio • 100% Onafhankelijk</span>
        </div>
        
        <h1 class="text-3xl sm:text-5xl lg:text-5.5xl font-bold text-white tracking-tight leading-tight font-display mb-6">
          {heroTitle}
        </h1>
        
        <p class="text-slate-200 text-base sm:text-lg leading-relaxed max-w-2xl mx-auto mb-10 font-sans font-normal">
          {heroSubtitle}
        </p>
        
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <button 
            class="open-contact-drawer inline-flex items-center justify-center gap-2 bg-brand-accent hover:bg-brand-accent/90 text-brand-dark font-bold px-8 py-4 rounded-full shadow-lg transition-all duration-300 text-xs tracking-wider uppercase font-sans cursor-pointer w-full sm:w-auto text-center"
          >
            <span>{ctaText || "Plan gratis adviesgesprek"}</span>
            <span>➔</span>
          </button>
          <a 
            href={`tel:${COMPANY_DATA.contact.phoneRaw}`}
            class="inline-flex items-center justify-center gap-2 bg-white/10 hover:bg-white/20 text-white font-semibold px-6 py-4 rounded-full border border-white/20 transition-all text-xs tracking-wider uppercase font-sans w-full sm:w-auto text-center"
          >
            <span>📞</span>
            <span>{COMPANY_DATA.contact.phoneDisplay}</span>
          </a>
        </div>
      </div>
    </section>

    <!-- [SECTIE 2] 3-KOLOMS STATS & BENTO CARDS -->
    {statsBento && statsBento.length > 0 && (
      <section class="py-12 -mt-6 relative z-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-8 lg:px-12">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {statsBento.map((bento) => (
              <div class="bg-white border border-slate-200/90 rounded-2xl sm:rounded-3xl p-6 sm:p-8 shadow-lg hover:shadow-xl transition-all duration-300">
                <div class="text-3xl sm:text-4xl font-black text-brand-dark font-display mb-1 text-brand-accent">
                  {bento.stat}
                </div>
                <div class="text-sm font-bold text-slate-800 font-sans mb-2">
                  {bento.label}
                </div>
                <p class="text-xs text-slate-600 leading-relaxed font-sans">
                  {bento.detail}
                </p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- USPs Section (Fallback or complementary) -->
    {usps && usps.length > 0 && (
      <section class="py-12 bg-[#f8fafc] border-y border-slate-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-8 lg:px-12">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
            {usps.map((usp) => (
              <div class="bg-white border border-slate-200/80 p-6 rounded-2xl shadow-xs hover:shadow-md transition-shadow">
                <div class="w-10 h-10 rounded-xl bg-slate-100 flex items-center justify-center text-brand-dark text-lg mb-4">
                  <span class="text-brand-accent font-bold">✦</span>
                </div>
                <h3 class="text-base font-bold text-brand-dark font-display mb-2">{usp.title}</h3>
                <p class="text-xs sm:text-sm text-slate-600 font-sans leading-relaxed">{usp.description}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- [SECTIE 3] PERSOONLIJKE HAALBAARHEIDSCHECK & MAATWERK BANNER (High-trust vervanger voor glitchy calculator) -->
    <section class="py-12 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-8 lg:px-12">
        <div class="relative bg-gradient-to-br from-[#153b68] to-[#0c1f38] text-white rounded-3xl p-8 sm:p-12 shadow-xl overflow-hidden border border-white/10">
          <div class="relative z-10 max-w-3xl">
            <div class="inline-flex items-center gap-2 bg-brand-accent/20 text-brand-accent px-3 py-1 rounded-full text-[11px] font-bold tracking-wider uppercase mb-4">
              <span>✓</span>
              <span>100% Maatwerk Feasibility Check</span>
            </div>
            <h2 class="text-2xl sm:text-3xl font-bold font-display tracking-tight text-white mb-4">
              Exact weten wat jouw maximale financiering & maandlasten worden?
            </h2>
            <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-8 font-sans">
              Geen standaard geautomatiseerde widgets die jouw unieke situatie missen. <strong>Martin van der Spek</strong> berekent jouw exacte leencapaciteit, rentevaste opties en netto maandlasten persoonlijk via 40+ banken en geldverstrekkers. Binnen 24 uur volledige duidelijkheid.
            </p>
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
              <button 
                class="open-contact-drawer bg-brand-accent hover:bg-brand-accent/90 text-brand-dark font-bold px-8 py-4 rounded-full text-xs tracking-wider uppercase font-sans transition-all text-center cursor-pointer shadow-md"
              >
                Vraag gratis haalbaarheidstoets aan ➔
              </button>
              <a 
                href={`tel:${COMPANY_DATA.contact.phoneRaw}`} 
                class="bg-white/10 hover:bg-white/20 text-white font-semibold px-6 py-4 rounded-full text-xs tracking-wider uppercase font-sans transition-all text-center border border-white/20"
              >
                Direct bellen: {COMPANY_DATA.contact.phoneDisplay}
              </a>
            </div>
          </div>
          <!-- Decorative Background Icon -->
          <div class="absolute right-[-20px] bottom-[-30px] opacity-10 pointer-events-none text-9xl text-white select-none hidden lg:block">
            ⚖️
          </div>
        </div>
      </div>
    </section>

    <!-- [SECTIE 4] REDACTIONELE VERDIEPING MET VERGELIJKINGSTABEL & EXPERT TIPS -->
    <section class="py-16 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-8 lg:px-12">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
          
          <!-- Article Content (Clean Prose Layout) -->
          <article class="lg:col-span-8 bg-white border border-slate-200/80 p-6 sm:p-10 rounded-2xl sm:rounded-3xl shadow-xs prose prose-slate max-w-none">
            <h2 class="text-2xl sm:text-3xl font-bold text-brand-dark mb-6 border-b border-slate-100 pb-4 font-display">
              Volledig inzicht in {name}
            </h2>
            <div class="text-slate-650 space-y-6 leading-relaxed font-sans text-sm sm:text-base">
              <Content />
            </div>

            <!-- Structured Comparison Table (if provided) -->
            {comparisonTable && (
              <div class="mt-10 pt-8 border-t border-slate-100 not-prose">
                <h3 class="text-xl font-bold text-brand-dark mb-2 font-display">
                  {comparisonTable.title}
                </h3>
                {comparisonTable.description && (
                  <p class="text-xs text-slate-500 mb-4 font-sans">{comparisonTable.description}</p>
                )}
                <div class="overflow-x-auto rounded-2xl border border-slate-200 shadow-xs">
                  <table class="w-full text-left border-collapse text-xs sm:text-sm font-sans">
                    <thead class="bg-slate-50 border-b border-slate-200 text-slate-700 font-bold uppercase tracking-wider text-[11px]">
                      <tr>
                        {comparisonTable.headers.map((header) => (
                          <th class="p-3.5 sm:p-4">{header}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                      {comparisonTable.rows.map((row) => (
                        <tr class="hover:bg-slate-50/70 transition-colors">
                          {row.map((cell, idx) => (
                            <td class={`p-3.5 sm:p-4 text-slate-700 ${idx === 0 ? "font-semibold text-brand-dark" : ""}`}>
                              {cell}
                            </td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            )}

            <!-- E-E-A-T Expert Tips from Martin van der Spek -->
            {expertTips && expertTips.length > 0 && (
              <div class="mt-10 pt-8 border-t border-slate-100 space-y-4 not-prose">
                <h3 class="text-lg font-bold text-brand-dark font-display flex items-center gap-2">
                  <span>💡</span>
                  <span>Advies van Martin van der Spek (Erkend Hypothecair Planner)</span>
                </h3>
                {expertTips.map((tip) => (
                  <div class="bg-amber-50/60 border border-amber-200/70 rounded-2xl p-5 text-amber-950 font-sans text-xs sm:text-sm leading-relaxed">
                    <div class="font-bold text-amber-900 mb-1">{tip.title}</div>
                    <p class="text-amber-900/90">{tip.tip}</p>
                  </div>
                ))}
              </div>
            )}
            
            <!-- Article Sub-blocks -->
            {articleBlocks && articleBlocks.map((block) => (
              <div class="mt-8 pt-8 border-t border-slate-100 not-prose">
                <h3 class="text-lg font-bold text-brand-dark mb-3 font-display">{block.title}</h3>
                <p class="text-sm text-slate-600 leading-relaxed font-sans">{block.body}</p>
              </div>
            ))}
          </article>

          <!-- Sidebar -->
          <aside class="lg:col-span-4 space-y-8">
            <!-- Aandachtspunten / Problems -->
            {problems && (
              <div class="bg-brand-dark border border-white/5 p-6 sm:p-8 rounded-2xl sm:rounded-3xl shadow-xl text-white">
                <h3 class="text-lg font-bold text-white mb-5 font-display flex items-center gap-2">
                  <span>⚠️</span>
                  <span>{problemsTitle || "Belangrijke Aandachtspunten"}</span>
                </h3>
                <ul class="space-y-4">
                  {problems.map((prob) => (
                    <li class="flex items-start gap-3">
                      <span class="flex-shrink-0 w-6 h-6 rounded-lg bg-white/10 text-brand-accent flex items-center justify-center font-bold text-xs mt-0.5 font-sans">
                        !
                      </span>
                      <div>
                        <h4 class="text-xs font-semibold text-white mb-0.5 font-sans">{prob.title}</h4>
                        <p class="text-slate-350 text-xs leading-relaxed font-sans">{prob.description}</p>
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <!-- Contact Card with Office Moerkapelle -->
            <div class="bg-slate-50 border border-slate-200/80 p-6 sm:p-8 rounded-2xl sm:rounded-3xl shadow-xs">
              <div class="w-12 h-12 rounded-2xl bg-[#153b68] text-white flex items-center justify-center text-xl mb-4">
                📍
              </div>
              <h3 class="text-lg font-bold text-brand-dark mb-2 font-display">Kantoor Moerkapelle</h3>
              <p class="text-xs text-slate-600 leading-relaxed mb-4 font-sans">
                {COMPANY_DATA.address.street}<br/>
                {COMPANY_DATA.address.postalCode} {COMPANY_DATA.address.city}<br/>
                <span class="text-slate-400">Parkeren gratis voor de deur</span>
              </p>
              <div class="space-y-2 pt-4 border-t border-slate-200/60 text-xs font-sans">
                <div class="flex justify-between text-slate-600">
                  <span>Telefoon:</span>
                  <a href={`tel:${COMPANY_DATA.contact.phoneRaw}`} class="font-bold text-brand-dark hover:text-brand-accent">{COMPANY_DATA.contact.phoneDisplay}</a>
                </div>
                <div class="flex justify-between text-slate-600">
                  <span>Openingstijden:</span>
                  <span class="font-medium text-slate-700">09:00 - 17:30</span>
                </div>
              </div>
              <button 
                class="open-contact-drawer w-full mt-6 bg-brand-dark hover:bg-slate-800 text-white font-semibold py-3 rounded-full text-xs uppercase tracking-wider font-sans transition-colors cursor-pointer"
              >
                Plan afspraak op kantoor ➔
              </button>
            </div>
          </aside>
          
        </div>
      </div>
    </section>

    <!-- [SECTIE 5] GEO AI FAQ ACCORDIONS (MET FAQPAGE SCHEMA) -->
    {faqItems && faqItems.length > 0 && (
      <section class="py-16 bg-[#f8fafc] border-y border-slate-100">
        <div class="max-w-4xl mx-auto px-4 sm:px-8">
          <div class="text-center mb-10">
            <span class="text-xs font-bold text-brand-accent uppercase tracking-wider font-sans">GEO & Zoekvragen</span>
            <h2 class="text-2xl sm:text-3xl font-bold text-brand-dark mt-1 font-display">Veelgestelde vragen over {name}</h2>
            <p class="text-xs sm:text-sm text-slate-500 mt-2 font-sans">Antwoorden volgens de richtlijnen van onze erkend hypothecair planner</p>
          </div>
          
          <div class="space-y-4">
            {faqItems.map((faq) => (
              <details class="group bg-white border border-slate-200/80 rounded-2xl p-5 shadow-xs transition-all duration-300 [&_summary::-webkit-details-marker]:hidden">
                <summary class="flex justify-between items-center font-bold text-brand-dark cursor-pointer select-none outline-none font-display">
                  <span class="text-sm sm:text-base leading-snug">{faq.question}</span>
                  <span class="transition-transform duration-300 group-open:rotate-180 text-brand-accent font-bold text-lg ml-4">
                    ↓
                  </span>
                </summary>
                <div class="mt-4 text-slate-650 text-xs sm:text-sm leading-relaxed border-t border-slate-100 pt-4 font-sans">
                  {faq.answer}
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- [SECTIE 6] SOCIAL PROOF & REVIEWCARDS -->
    <section class="py-16 bg-white">
      <div class="max-w-5xl mx-auto px-4 sm:px-8">
        <div class="bg-gradient-to-r from-slate-50 to-slate-100 border border-slate-200/80 rounded-3xl p-8 sm:p-12 text-center shadow-xs">
          <div class="flex items-center justify-center gap-1 text-amber-400 text-lg mb-4">
            ★★★★★
          </div>
          <blockquote class="text-base sm:text-xl font-medium text-slate-800 font-display italic mb-6 max-w-2xl mx-auto">
            {reviewQuote ? `"${reviewQuote.quote}"` : `"Martin heeft ons fantastisch geholpen. Binnen no-time was onze hypotheek geregeld met uitstekende voorwaarden. Persoonlijk, snel en zonder gedoe."`}
          </blockquote>
          <div class="text-xs font-bold text-brand-dark font-sans uppercase tracking-wider">
            {reviewQuote ? reviewQuote.author : "Familie De Jong uit Moerkapelle"}
          </div>
          <div class="text-[11px] text-slate-500 font-sans mt-0.5">
            {reviewQuote ? reviewQuote.context : "Beoordeling 5.0 / 5.0 • Google Reviews"}
          </div>
        </div>
      </div>
    </section>

    <!-- [SECTIE 7] CONVERSIE FOOTER-CTA -->
    <section class="py-16 bg-[#153b68] text-white text-center">
      <div class="max-w-4xl mx-auto px-4 sm:px-8">
        <h2 class="text-2xl sm:text-4xl font-bold font-display tracking-tight mb-4">
          Jouw financiering zorgeloos geregeld?
        </h2>
        <p class="text-slate-200 text-sm sm:text-base max-w-xl mx-auto mb-8 font-sans">
          Maak vrijblijvend een afspraak met Martin van der Spek aan de Herenweg 42 te Moerkapelle of bij jou aan de keukentafel.
        </p>
        <button 
          class="open-contact-drawer inline-block bg-brand-accent hover:bg-brand-accent/90 text-brand-dark font-bold px-8 py-4 rounded-full shadow-lg transition-all text-xs tracking-wider uppercase font-sans cursor-pointer"
        >
          Plan jouw kosteloze intake ➔
        </button>
      </div>
    </section>

  </main>
  
  <Footer />
</Layout>
