---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AboutSection from '../components/AboutSection.astro';
import RatingsClaim from '../components/RatingsClaim.astro';
import FaqSection from '../components/FaqSection.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Onafhankelijk Hypotheekadvies | Spekadvies, Jouw droomhuis perfect geregeld" 
  description="Onafhankelijk hypotheekadvies voor starters, doorstromers en ondernemers in Moerkapelle. Wij vergelijken meer dan 40 geldverstrekkers voor de laagste rente."
>
  <Navbar />
  <Breadcrumbs />
  
  <main class="relative z-10 flex-grow">
    <!-- Hero Section with Background Image and Dark Gradient Overlay -->
    <section 
      class="relative py-24 sm:py-32 lg:py-40 bg-[#153b68] bg-center bg-cover bg-no-repeat overflow-hidden rounded-b-[48px] sm:rounded-b-[64px] lg:rounded-b-[80px] shadow-xl"
      style="background-image: linear-gradient(rgba(21, 59, 104, 0.82), rgba(11, 26, 47, 0.94)), url('https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1800&q=80');"
    >
      <div class="max-w-4xl mx-auto px-6 sm:px-8 text-center relative z-10">
        <!-- Badge -->
        <span class="inline-block bg-white/10 text-brand-accent border border-white/10 text-[10px] font-semibold tracking-widest uppercase px-4 py-1.5 rounded-full mb-6 font-sans">
          Hypotheekadvies op maat
        </span>
        
        <h1 id="hero-title" class="text-4xl sm:text-5xl lg:text-6.5xl font-bold text-white tracking-tight leading-tight font-display mb-6">
          De eerste stap naar jouw eigen plek
        </h1>
        
        <p  class="text-slate-300 text-base sm:text-lg leading-relaxed max-w-2xl mx-auto mb-10 font-sans font-normal">
          De zoektocht naar een woning is spannend, zeker in de huidige markt. Wij vergelijken meer dan 40 geldverstrekkers voor de beste rente en voorwaarden.
        </p>
        
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <button 
            class="open-contact-drawer w-full sm:w-auto bg-brand-accent hover:bg-brand-accent/90 text-brand-dark font-semibold px-8 py-4 rounded-full shadow-lg transition-all duration-300 text-xs tracking-wider uppercase font-sans cursor-pointer"
          >
            Plan gratis adviesgesprek
          </button>
          <a 
            href="https://start.finsave.nl/app/public/maximale-hypotheek" 
            target="_blank"
            class="w-full sm:w-auto bg-transparent border-2 border-white/20 hover:border-white text-white font-semibold px-8 py-4 rounded-full shadow-sm hover:shadow-md transition-all duration-300 text-xs tracking-wider uppercase font-sans cursor-pointer"
          >
            Maximale hypotheek berekenen ↗
          </a>
        </div>
      </div>
    </section>

    <!-- 3 Overlapping Info Cards -->
    <section class="py-12 bg-brand-basetint/30 relative">
      <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          
          <!-- Card 1 -->
          <div class="bg-white border border-slate-200/80 p-8 rounded-3xl shadow-sm hover:shadow-md transition-shadow">
            <div class="w-12 h-12 rounded-xl bg-slate-100 flex items-center justify-center text-brand-dark text-xl mb-6">
              <i class="fa-solid fa-piggy-bank"></i>
            </div>
            <h3 class="text-base font-bold text-brand-dark font-display mb-3">Slimme financiering</h3>
            <p   class="text-sm text-slate-600 font-sans font-normal leading-relaxed">
              Advies over belastingvoordelen, schenkingen, erfpacht en de Nationale Hypotheek Garantie (NHG) om jouw maandlasten te minimaliseren.
            </p>
          </div>

          <!-- Card 2 -->
          <div class="bg-white border border-slate-200/80 p-8 rounded-3xl shadow-sm hover:shadow-md transition-shadow">
            <div class="w-12 h-12 rounded-xl bg-slate-100 flex items-center justify-center text-brand-dark text-xl mb-6">
              <i class="fa-solid fa-calculator"></i>
            </div>
            <h3 class="text-base font-bold text-brand-dark font-display mb-3">Maximale leencapaciteit</h3>
            <p   class="text-sm text-slate-600 font-sans font-normal leading-relaxed">
              Wat kun je verantwoord lenen op basis van jouw inkomen en eventuele schulden? Wij rekenen het exact en onafhankelijk voor je uit.
            </p>
          </div>

          <!-- Card 3 -->
          <div class="bg-white border border-slate-200/80 p-8 rounded-3xl shadow-sm hover:shadow-md transition-shadow">
            <div class="w-12 h-12 rounded-xl bg-slate-100 flex items-center justify-center text-brand-dark text-xl mb-6">
              <i class="fa-solid fa-shield-halved"></i>
            </div>
            <h3 class="text-base font-bold text-brand-dark font-display mb-3">Risico's afgedekt</h3>
            <p   class="text-sm text-slate-600 font-sans font-normal leading-relaxed">
              Wij adviseren je over overlijdensrisico- en woonlastenverzekeringen, zodat je bij arbeidsongeschiktheid of tegenslag in je woning kunt blijven.
            </p>
          </div>

        </div>
      </div>
    </section>

    <!-- Journey Tabs Section -->
    <section class="py-20 bg-brand-base overflow-hidden">
      <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <span class="text-xs font-bold tracking-widest uppercase text-brand-dark/50 block font-display">Je situatie</span>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-brand-dark font-display mt-2">Heb je al een koopwoning?</h2>
          <p   class="text-slate-600 text-sm sm:text-base font-sans font-normal mt-3">Selecteer hieronder jouw situatie en ontdek wat wij voor jou betekenen.</p>
        </div>

        <!-- Tab buttons -->
        <div class="flex justify-center mb-16">
          <div class="inline-flex bg-slate-100 p-1.5 rounded-full border border-slate-200">
            <button 
              id="journey-btn-doorstromers" 
              class="journey-tab-btn active bg-brand-dark text-white text-xs font-semibold uppercase tracking-wider font-sans px-6 py-3 rounded-full cursor-pointer transition-all duration-300"
              data-target="doorstromers"
            >
              Doorstromers
            </button>
            <button 
              id="journey-btn-verduurzamen" 
              class="journey-tab-btn text-slate-500 text-xs font-semibold uppercase tracking-wider font-sans px-6 py-3 rounded-full cursor-pointer transition-all duration-300"
              data-target="verduurzamen"
            >
              Oversluiten & verduurzamen
            </button>
          </div>
        </div>

        <!-- Tab 1 content: Doorstromers -->
        <div id="journey-panel-doorstromers" class="journey-panel grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          <div class="lg:col-span-7 space-y-6">
            <span class="inline-block bg-brand-primary/10 text-brand-dark text-[10px] font-semibold tracking-widest uppercase px-3 py-1 rounded-full font-sans">Volgende woning</span>
            <h3 class="text-xl sm:text-2xl font-bold text-brand-dark font-display">Verhuizen naar een volgende woning</h3>
            <p   class="text-slate-600 text-xs sm:text-sm leading-relaxed font-sans font-normal">
              Als je al een koopwoning bezit, komt er bij een verhuizing meer kijken. Je hebt te maken met de verkoop van je huidige huis, de mogelijke overwaarde en de timing van de overdracht. Wij zorgen dat de financiële puzzel precies in elkaar valt.
            </p>

            <ul class="space-y-4 pt-2">
              <li class="flex items-start space-x-4">
                <div class="w-10 h-10 rounded-xl bg-brand-primary/10 flex items-center justify-center text-brand-dark text-base flex-shrink-0">
                  <i class="fa-solid fa-house-chimney-user"></i>
                </div>
                <div>
                  <h4 class="text-xs font-bold text-brand-dark font-display uppercase tracking-wider">Rente meeverhuizen</h4>
                  <p  class="text-xs text-slate-600 font-sans mt-0.5">Wij zoeken voor je uit of je jouw huidige (lage) rente kunt meenemen naar je nieuwe woning.</p>
                </div>
              </li>
              <li class="flex items-start space-x-4">
                <div class="w-10 h-10 rounded-xl bg-brand-primary/10 flex items-center justify-center text-brand-dark text-base flex-shrink-0">
                  <i class="fa-solid fa-sack-dollar"></i>
                </div>
                <div>
                  <h4 class="text-xs font-bold text-brand-dark font-display uppercase tracking-wider">Overwaarde benutten</h4>
                  <p  class="text-xs text-slate-600 font-sans mt-0.5">Advies hoe je de winst op je huidige huis slim inzet voor lagere maandlasten of verbouwing.</p>
                </div>
              </li>
              <li class="flex items-start space-x-4">
                <div class="w-10 h-10 rounded-xl bg-brand-primary/10 flex items-center justify-center text-brand-dark text-base flex-shrink-0">
                  <i class="fa-solid fa-bridge"></i>
                </div>
                <div>
                  <h4 class="text-xs font-bold text-brand-dark font-display uppercase tracking-wider">Overbruggingskrediet</h4>
                  <p  class="text-xs text-slate-600 font-sans mt-0.5">De financiering regelen voor de periode dat je tijdelijk eigenaar bent van twee woningen.</p>
                </div>
              </li>
            </ul>
          </div>
          
          <div class="lg:col-span-5 bg-brand-basetint rounded-3xl p-8 border border-slate-200/50 flex flex-col justify-center text-center space-y-6">
            <div class="text-5xl">🗝️</div>
            <h4 class="text-base font-bold text-brand-dark font-display uppercase tracking-wider">Naadloze overdracht</h4>
            <p   class="text-sm text-slate-600 font-sans font-normal leading-relaxed max-w-sm mx-auto">
              Wij stemmen de datums van de verkoop en aankoop exact op elkaar af, zodat je niet onnodig dubbele lasten draagt of zonder woning komt te zitten.
            </p>
            <button class="open-contact-drawer bg-brand-dark hover:bg-brand-primary hover:text-brand-dark text-white font-semibold py-3 rounded-full text-xs tracking-wider uppercase font-sans transition-colors cursor-pointer">Plan intakegesprek</button>
          </div>
        </div>

        <!-- Tab 2 content: Verduurzamen -->
        <div id="journey-panel-verduurzamen" class="journey-panel hidden grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          <div class="lg:col-span-7 space-y-6">
            <span class="inline-block bg-brand-primary/10 text-brand-dark text-[10px] font-semibold tracking-widest uppercase px-3 py-1 rounded-full font-sans">Aanpassen</span>
            <h3 class="text-xl sm:text-2xl font-bold text-brand-dark font-display">Hypotheek oversluiten of verduurzamen</h3>
            <p   class="text-slate-600 text-xs sm:text-sm leading-relaxed font-sans font-normal">
              Een hypotheek sluit je vaak af voor 30 jaar, maar jouw leven staat niet stil. Misschien droom je van een uitbouw, loopt je rentevastperiode af of wil je je woning energiezuiniger maken. Wij checken of je maandlasten omlaag kunnen.
            </p>

            <ul class="space-y-4 pt-2">
              <li class="flex items-start space-x-4">
                <div class="w-10 h-10 rounded-xl bg-brand-primary/10 flex items-center justify-center text-brand-dark text-base flex-shrink-0">
                  <i class="fa-solid fa-percent"></i>
                </div>
                <div>
                  <h4 class="text-xs font-bold text-brand-dark font-display uppercase tracking-wider">Oversluiten loont?</h4>
                  <p  class="text-xs text-slate-600 font-sans mt-0.5">Wij berekenen of overstappen naar een andere geldverstrekker je netto voordeel oplevert, inclusief boeterente.</p>
                </div>
              </li>
              <li class="flex items-start space-x-4">
                <div class="w-10 h-10 rounded-xl bg-brand-primary/10 flex items-center justify-center text-brand-dark text-base flex-shrink-0">
                  <i class="fa-solid fa-hammer"></i>
                </div>
                <div>
                  <h4 class="text-xs font-bold text-brand-dark font-display uppercase tracking-wider">Verbouwing financieren</h4>
                  <p  class="text-xs text-slate-600 font-sans mt-0.5">Advies over het opnemen van overwaarde via een bouwdepot voor een nieuwe keuken of dakkapel.</p>
                </div>
              </li>
              <li class="flex items-start space-x-4">
                <div class="w-10 h-10 rounded-xl bg-brand-primary/10 flex items-center justify-center text-brand-dark text-base flex-shrink-0">
                  <i class="fa-solid fa-leaf"></i>
                </div>
                <div>
                  <h4 class="text-xs font-bold text-brand-dark font-display uppercase tracking-wider">Verduurzaming woning</h4>
                  <p  class="text-xs text-slate-600 font-sans mt-0.5">Inzicht in extra leenruimte (tot € 20.000 extra) en rentekortingen bij energiebesparende maatregelen.</p>
                </div>
              </li>
            </ul>
          </div>
          
          <div class="lg:col-span-5 bg-brand-basetint rounded-3xl p-8 border border-slate-200/50 flex flex-col justify-center text-center space-y-6">
            <div class="text-5xl text-emerald-600">⚡</div>
            <h4 class="text-base font-bold text-brand-dark font-display uppercase tracking-wider">Bespaar op energielasten</h4>
            <p   class="text-sm text-slate-600 font-sans font-normal leading-relaxed max-w-sm mx-auto">
              Door zonnepanelen, warmtepompen of isolatie mee te financieren in je hypotheek, dalen je maandelijkse energierekeningen direct.
            </p>
            <button class="open-contact-drawer bg-brand-dark hover:bg-brand-primary hover:text-brand-dark text-white font-semibold py-3 rounded-full text-xs tracking-wider uppercase font-sans transition-colors cursor-pointer">Bereken voordeel</button>
          </div>
        </div>

      </div>
    </section>

    <!-- Checklist section -->
    <section class="py-20 bg-brand-basetint/30 relative">
      <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="text-xs font-bold tracking-widest uppercase text-brand-dark/50 block font-display">Voorbereiding</span>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-brand-dark font-display mt-2">Welke documenten hebben we nodig?</h2>
          <p   class="text-slate-600 text-sm sm:text-base font-sans font-normal mt-3">Om jouw aanvraag soepel te laten verlopen, verzamelen we in de intakefase een aantal documenten.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          <!-- Card 1 -->
          <div class="bg-white border border-slate-200/80 p-8 rounded-3xl shadow-sm text-center space-y-4">
            <div class="w-12 h-12 rounded-xl bg-slate-100 flex items-center justify-center text-brand-dark text-lg mx-auto">
              <i class="fa-solid fa-id-card"></i>
            </div>
            <h3 class="text-sm font-bold text-brand-dark font-display uppercase tracking-wider">Identiteit</h3>
            <p   class="text-sm text-slate-600 font-sans font-normal leading-relaxed">
              Een geldig paspoort of identiteitskaart van alle aanvragers (geen rijbewijs).
            </p>
          </div>

          <!-- Card 2 -->
          <div class="bg-white border border-slate-200/80 p-8 rounded-3xl shadow-sm text-center space-y-4">
            <div class="w-12 h-12 rounded-xl bg-slate-100 flex items-center justify-center text-brand-dark text-lg mx-auto">
              <i class="fa-solid fa-file-invoice"></i>
            </div>
            <h3 class="text-sm font-bold text-brand-dark font-display uppercase tracking-wider">Inkomen</h3>
            <p   class="text-sm text-slate-600 font-sans font-normal leading-relaxed">
              Meest recente salarisstrook en werkgeversverklaring. Voor zzp'ers: jaarcijfers van de laatste 3 jaar.
            </p>
          </div>

          <!-- Card 3 -->
          <div class="bg-white border border-slate-200/80 p-8 rounded-3xl shadow-sm text-center space-y-4">
            <div class="w-12 h-12 rounded-xl bg-slate-100 flex items-center justify-center text-brand-dark text-lg mx-auto">
              <i class="fa-solid fa-laptop-file"></i>
            </div>
            <h3 class="text-sm font-bold text-brand-dark font-display uppercase tracking-wider">UWV & Pensioen</h3>
            <p   class="text-sm text-slate-600 font-sans font-normal leading-relaxed">
              Het UWV verzekeringsbericht en een actueel pensioenoverzicht (eenvoudig te downloaden met DigiD).
            </p>
          </div>

          <!-- Card 4 -->
          <div class="bg-white border border-slate-200/80 p-8 rounded-3xl shadow-sm text-center space-y-4">
            <div class="w-12 h-12 rounded-xl bg-slate-100 flex items-center justify-center text-brand-dark text-lg mx-auto">
              <i class="fa-solid fa-house-chimney-crack"></i>
            </div>
            <h3 class="text-sm font-bold text-brand-dark font-display uppercase tracking-wider">Schulden & Leningen</h3>
            <p   class="text-sm text-slate-600 font-sans font-normal leading-relaxed">
              Overzichten van studieschuld (DUO), private lease en gegevens van je huidige hypotheek.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- timeline -->
    <section class="py-20 bg-brand-base overflow-hidden">
      <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="text-xs font-bold tracking-widest uppercase text-brand-dark/50 block font-display">Stappenplan</span>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-brand-dark font-display mt-2">Hoe verloopt een hypotheekaanvraag?</h2>
          <p   class="text-slate-600 text-sm sm:text-base font-sans font-normal mt-3">Van de eerste kennismaking tot de notaris: wij begeleiden je stap voor stap.</p>
        </div>

        <!-- Leadfabriek-Style Horizontal Scroll Slider Wrapper -->
        <div class="relative w-full">
          <!-- Horizontal scroll area -->
          <div 
            id="timeline-scroll-container"
            class="flex space-x-6 overflow-x-auto pb-8 pt-4 snap-x snap-mandatory scroll-smooth hide-scrollbar w-full"
            style="scrollbar-width: none; -ms-overflow-style: none;"
          >
            <!-- Step 1 -->
            <div class="flex-shrink-0 w-[300px] sm:w-[360px] snap-start bg-white border border-slate-200/80 rounded-[32px] p-6 sm:p-8 shadow-md hover:shadow-lg transition-all duration-300 relative overflow-hidden flex flex-col justify-between group min-h-[220px]">
              <div class="absolute -right-10 -bottom-10 w-32 h-32 rounded-full bg-brand-primary/5 blur-2xl pointer-events-none transition-all group-hover:bg-brand-primary/10"></div>
              <div class="space-y-4 relative z-10">
                <div class="w-10 h-10 rounded-full bg-brand-dark text-white flex items-center justify-center font-sans font-semibold text-xs shadow-sm">
                  01
                </div>
                <h3 class="text-base font-bold text-brand-dark font-display uppercase tracking-wider">Kennismaking</h3>
                <p   class="text-sm text-slate-600 font-sans font-normal leading-relaxed">
                  Tijdens een (gratis) eerste gesprek leren we elkaar kennen. We bespreken je woonwensen, situatie en geven een eerste globale indicatie van de mogelijkheden.
                </p>
              </div>
              <div class="absolute right-6 bottom-4 text-7xl font-bold text-slate-100/50 font-display select-none pointer-events-none group-hover:text-slate-150 transition-colors">
                01
              </div>
            </div>

            <!-- Step 2 -->
            <div class="flex-shrink-0 w-[300px] sm:w-[360px] snap-start bg-white border border-slate-200/80 rounded-[32px] p-6 sm:p-8 shadow-md hover:shadow-lg transition-all duration-300 relative overflow-hidden flex flex-col justify-between group min-h-[220px]">
              <div class="absolute -right-10 -bottom-10 w-32 h-32 rounded-full bg-brand-primary/5 blur-2xl pointer-events-none transition-all group-hover:bg-brand-primary/10"></div>
              <div class="space-y-4 relative z-10">
                <div class="w-10 h-10 rounded-full bg-brand-dark text-white flex items-center justify-center font-sans font-semibold text-xs shadow-sm">
                  02
                </div>
                <h3 class="text-base font-bold text-brand-dark font-display uppercase tracking-wider">Documentatie</h3>
                <p   class="text-sm text-slate-600 font-sans font-normal leading-relaxed">
                  We verzamelen de benodigde gegevens, zoals inkomensbewijzen en identiteitsbewijzen via onze portal klantenservice.
                </p>
              </div>
              <div class="absolute right-6 bottom-4 text-7xl font-bold text-slate-100/50 font-display select-none pointer-events-none group-hover:text-slate-150 transition-colors">
                02
              </div>
            </div>

            <!-- Step 3 -->
            <div class="flex-shrink-0 w-[300px] sm:w-[360px] snap-start bg-white border border-slate-200/80 rounded-[32px] p-6 sm:p-8 shadow-md hover:shadow-lg transition-all duration-300 relative overflow-hidden flex flex-col justify-between group min-h-[220px]">
              <div class="absolute -right-10 -bottom-10 w-32 h-32 rounded-full bg-brand-primary/5 blur-2xl pointer-events-none transition-all group-hover:bg-brand-primary/10"></div>
              <div class="space-y-4 relative z-10">
                <div class="w-10 h-10 rounded-full bg-brand-dark text-white flex items-center justify-center font-sans font-semibold text-xs shadow-sm">
                  03
                </div>
                <h3 class="text-base font-bold text-brand-dark font-display uppercase tracking-wider">Advies & Vergelijking</h3>
                <p   class="text-sm text-slate-600 font-sans font-normal leading-relaxed">
                  Wij rekenen alles nauwkeurig door en vergelijken rentes en voorwaarden van tientallen aanbieders om de hypotheek te vinden die perfect bij jou past.
                </p>
              </div>
              <div class="absolute right-6 bottom-4 text-7xl font-bold text-slate-100/50 font-display select-none pointer-events-none group-hover:text-slate-150 transition-colors">
                03
              </div>
            </div>

            <!-- Step 4 -->
            <div class="flex-shrink-0 w-[300px] sm:w-[360px] snap-start bg-white border border-slate-200/80 rounded-[32px] p-6 sm:p-8 shadow-md hover:shadow-lg transition-all duration-300 relative overflow-hidden flex flex-col justify-between group min-h-[220px]">
              <div class="absolute -right-10 -bottom-10 w-32 h-32 rounded-full bg-brand-primary/5 blur-2xl pointer-events-none transition-all group-hover:bg-brand-primary/10"></div>
              <div class="space-y-4 relative z-10">
                <div class="w-10 h-10 rounded-full bg-brand-dark text-white flex items-center justify-center font-sans font-semibold text-xs shadow-sm">
                  04
                </div>
                <h3 class="text-base font-bold text-brand-dark font-display uppercase tracking-wider">De Aanvraag</h3>
                <p   class="text-sm text-slate-600 font-sans font-normal leading-relaxed">
                  Hebben we de juiste hypotheek gekozen? Wij dienen het complete dossier vlekkeloos in bij de gekozen geldverstrekker en houden de vinger aan de pols.
                </p>
              </div>
              <div class="absolute right-6 bottom-4 text-7xl font-bold text-slate-100/50 font-display select-none pointer-events-none group-hover:text-slate-150 transition-colors">
                04
              </div>
            </div>

            <!-- Step 5 -->
